+    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
+};
+
+static unsigned char c2_aes_xt(unsigned char x)
+{
+    return (unsigned char)((x << 1) ^ ((x & 0x80) ? 0x1b : 0));
+}
+
+/* aus = AES-128(schluessel, ein); alle drei 16 Byte, Byte 0 zuerst (wie FIPS-197) */
+static void c2_aes128(const unsigned char *schluessel, const unsigned char *ein, unsigned char *aus)
+{
+    unsigned char k[16], s[16], t[4], rcon = 1;
+    for (int i = 0; i < 16; i++) {
+        k[i] = schluessel[i];
+        s[i] = ein[i] ^ k[i];
+    }
+    for (int runde = 1; runde <= 10; runde++) {
+        /* SubBytes und ShiftRows (spaltenweise Ablage: s[4 * Spalte + Zeile]) */
+        unsigned char z[16];
+        for (int sp = 0; sp < 4; sp++) {
+            for (int ze = 0; ze < 4; ze++) {
+                z[4 * sp + ze] = c2_aes_sbox[s[4 * ((sp + ze) & 3) + ze]];
+            }
+        }
+        /* MixColumns (nicht in der letzten Runde) */
+        for (int sp = 0; sp < 4; sp++) {
+            unsigned char *c = z + 4 * sp;
+            if (runde < 10) {
+                unsigned char a = c[0] ^ c[1] ^ c[2] ^ c[3], c0 = c[0];
+                c[0] ^= a ^ c2_aes_xt(c[0] ^ c[1]);
+                c[1] ^= a ^ c2_aes_xt(c[1] ^ c[2]);
+                c[2] ^= a ^ c2_aes_xt(c[2] ^ c[3]);
+                c[3] ^= a ^ c2_aes_xt(c[3] ^ c0);
+            }
+        }
+        /* nächster Rundenschlüssel */
+        t[0] = c2_aes_sbox[k[13]] ^ rcon, t[1] = c2_aes_sbox[k[14]], t[2] = c2_aes_sbox[k[15]], t[3] = c2_aes_sbox[k[12]];
+        rcon = c2_aes_xt(rcon);
+        for (int i = 0; i < 16; i++) {
+            k[i] ^= i < 4 ? t[i] : k[i - 4];
+        }
+        for (int i = 0; i < 16; i++) {
+            s[i] = z[i] ^ k[i];
+        }
+    }
+    for (int i = 0; i < 16; i++) {
+        aus[i] = s[i];
+    }
+}
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_anzeige.c b/apps/hid/modules/c2lite/c2_anzeige.c
new file mode 100644
index 0000000..8467c87
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_anzeige.c
@@ -0,0 +1,210 @@
+/* C2 Lite: Zustandsanzeige über die 4 Spieler-LEDs und das RGB-Logo, dazu die Lichteffekte von Streifen und Seiten.
+ * Wird aus der Tastenabfrage alle C2_ANZEIGE_TAKT_MS aufgerufen.
+ * Vorbild Werks-Firmware (LED-Zustände 0x1557C, Effekte 0x1651A, Farbrad 0x15DCE):
+ *   Bluetooth sucht: Spieler-LEDs aus, nur das Status-RGB blinkt (41/41 Ticks à 6 ms ≈ 250 ms)
+ *   verbunden: Spieler 1; laden ohne Verbindung: alle vier blinken 0,5 s; voll: aus
+ *   Streifen + Seiten: Regenbogen-Lauf, Phase je LED um 188 von 1536 versetzt, 5 % Helligkeit; Status 30 %.
+ * Ergänzt: Lauflicht beim Einschalten, Fortschritt beim Halten von Home + Minus. */
+#include "app_config.h"
+#include "system/includes.h"
+#include "c2_anzeige.h"
+
+#ifdef CONFIG_BOARD_C2LITE
+
+#define S1 0x04 /* Spieler 1 */
+#define ALLE 0x3C
+
+static u32 takt; /* Runden seit dem Start */
+
+/* an/aus im Wechsel: halbe Periode in ms */
+static int blinken(u32 halb_ms)
+{
+    return (takt * C2_ANZEIGE_TAKT_MS / halb_ms) & 1;
+}
+
+u8 c2_anzeige_berechnen(const struct c2_anzeige_lage *l)
+{
+    takt++;
+    u32 ms = takt * C2_ANZEIGE_TAKT_MS;
+
+    /* Rettung (Home + Minus): LEDs füllen sich mit dem Fortschritt, am Ende schnelles Blinken aller vier */
+    if (l->rettung_promille) {
+        if (l->rettung_promille >= 900) {
+            return blinken(80) ? ALLE : 0;
+        }
+        u8 m = 0;
+        for (int i = 0; i < 4; i++) {
+            if (l->rettung_promille > 225 * i) {
+                m |= S1 << i;
+            }
+        }
+        return m;
+    }
+    /* Firmware-Update: Spieler-LEDs füllen sich mit dem Fortschritt, die nächste blinkt */
+    if (l->ota_promille) {
+        u8 m = 0;
+        int voll = l->ota_promille * 4 / 1001;
+        for (int i = 0; i < voll; i++) {
+            m |= S1 << i;
+        }
+        if (voll < 4 && blinken(250)) {
+            m |= S1 << voll;
+        }
+        return m;
+    }
+    if (l->ladeschlaf) {
+        return 0;
+    }
+    /* Einschalten: einmal Lauflicht 1 -> 4 (je 150 ms) */
+    if (ms < 4 * 150) {
+        return S1 << (ms / 150);
+    }
+    if (l->usb_host || l->ble_verbunden) {
+        return l->spieler ? (l->spieler & 0x0F) << 2 : S1; /* Switch: Spielernummer von der Konsole */
+    }
+    /* Am Ladegerät ohne Verbindung: alle vier blinken, solange er lädt (Werks-FW 83/83 Ticks ≈ 0,5 s), voll: aus */
+    if (l->usb_5v) {
+        return l->laedt && blinken(500) ? ALLE : 0;
+    }
+    /* Bluetooth sucht: Lauflicht 1 -> 4 (je 200 ms), dazu blinkt das Logo */
+    return S1 << ((ms / 200) % 4);
+}
+
+/* Farbrad wie Werks-FW 0x15DCE: h 0..1535 in 6 Abschnitten zu je 256 */
+static void farbrad(u16 h, u8 *r, u8 *g, u8 *b)
+{
+    u8 x = h & 0xFF;
+    switch ((h >> 8) % 6) {
+    case 0: *r = 255, *g = x, *b = 0; break;
+    case 1: *r = 255 - x, *g = 255, *b = 0; break;
+    case 2: *r = 0, *g = 255, *b = x; break;
+    case 3: *r = 0, *g = 255 - x, *b = 255; break;
+    case 4: *r = x, *g = 0, *b = 255; break;
+    default: *r = 255, *g = 0, *b = 255 - x; break;
+    }
+}
+
+static u8 skalieren(u8 c, u8 prozent)
+{
+    return (u16)c * prozent / 100;
+}
+
+void c2_rgb_setzen(int kette, int led, u8 r, u8 g, u8 b);
+
+static void setzen_hell(int kette, int led, u8 r, u8 g, u8 b, u8 hell)
+{
+    c2_rgb_setzen(kette, led, skalieren(r, hell), skalieren(g, hell), skalieren(b, hell));
+}
+
+#define RUHE_DIMMEN_MS (5 * 60 * 1000) /* danach Licht auf 20 % */
+
+void c2_anzeige_rgb(const struct c2_anzeige_lage *l, const struct c2_licht *e_einst)
+{
+    u32 ms = takt * C2_ANZEIGE_TAKT_MS;
+    struct c2_licht e = *e_einst;
+    if (l->ladeschlaf) {
+        /* Ladeschlaf: Logo grün atmend (4 s), solange er lädt, sonst aus; Streifen und Seiten aus */
+        u32 phase = ms % 4000;
+        u8 g = l->laedt ? 40 + (phase < 2000 ? phase : 4000 - phase) * 215 / 2000 : 0;
+        setzen_hell(0, 0, 0, g, 0, 15);
+        for (int led = 1; led < 8; led++) {
+            setzen_hell(0, led, 0, 0, 0, 0);
+        }
+        setzen_hell(1, 0, 0, 0, 0, 0);
+        setzen_hell(1, 1, 0, 0, 0, 0);
+        return;
+    }
+    if (l->ruhe_ms > RUHE_DIMMEN_MS) {
+        e.hell = e.hell / 5;
+        e.logo_hell = e.logo_hell / 5 + 1;
+    }
+
+    /* Logo = Status */
+    u8 r = 255, g = 255, b = 255, an = 1;
+    if (l->ota_promille) {
+        r = 0, g = 220, b = 255;                                   /* Update: türkis */
+    } else if (l->rettung_promille) {
+        r = 160, g = 0, b = 255;                                   /* lila */
+    } else if (l->logo_an) {
+        r = l->logo[0], g = l->logo[1], b = l->logo[2];            /* Belegung: Aufnahme, Turbo, Makro */
+    } else if (ms < 4 * 150) {
+        /* weiß beim Einschalten */
+    } else if (!l->usb_5v && l->akku_prozent && l->akku_prozent <= 10) {
+        r = 255, g = 0, b = 0, an = blinken(250);                  /* Akku schwach: rot blinkend */
+    } else if (l->usb_host || l->ble_verbunden) {
+        /* verbunden: weiß */
+    } else if (l->usb_5v) {
+        /* Ladegerät: grün; pulsiert, solange er lädt, ruhig, wenn voll */
+        r = 0, g = 255, b = 0;
+        if (l->laedt) {
+            u32 phase = ms % 2000;
+            u8 stufe = 20 + (phase < 1000 ? phase : 2000 - phase) * 80 / 1000;
+            g = (u16)255 * stufe / 100;
+        }
+    } else {
+        r = 0, g = 0, b = 255, an = blinken(250);                  /* Bluetooth sucht: blau blinkend */
+    }
+    setzen_hell(0, 0, an ? r : 0, an ? g : 0, an ? b : 0, e.logo_hell);
+
+    /* Streifen (Kette A, LED 1..7) und Seiten (Kette B, beide gleich) = 8 Plätze, Platz 0 = Seiten */
+    static u16 hue;
+    hue = (hue + e.tempo / 10 + 1) % 1536;
+    /* Reaktiv: Aufblitzen bei jedem neuen Tastendruck, Farbe je Tastengruppe, klingt in ~0,25 s aus */
+    static u8 blitz, blitz_r, blitz_g, blitz_b;
+    if (l->druck_gruppe) {
+        static const u8 FARBE[5][3] = {{0, 0, 0}, {0, 220, 255}, {255, 120, 0}, {255, 0, 200}, {255, 255, 255}};
+        blitz = 255, blitz_r = FARBE[l->druck_gruppe][0], blitz_g = FARBE[l->druck_gruppe][1], blitz_b = FARBE[l->druck_gruppe][2];
+    } else {
+        blitz = blitz > 10 ? blitz - 10 : 0;
+    }
+    /* Am Ladegerät ohne Verbindung: Ladebalken in Grün (am Kabel misst man die Ladespannung, daher eher grob) */
+    int ladebalken = l->usb_5v && !l->usb_host && !l->ble_verbunden && e.modus != C2_LICHT_AUS && ms >= 4 * 150;
+    u8 balken = ladebalken ? (l->akku_prozent * 7 + 99) / 100 : 0;
+    for (int platz = 0; platz < 8; platz++) {
+        if (ladebalken) {
+            u8 pulsen = (ms / 8) % 200;
+            u8 stufe = pulsen < 100 ? pulsen : 200 - pulsen;
+            r = 0, b = 0;
+            g = platz == 0 ? 0 : platz < balken ? 255 : platz == balken ? (u16)255 * stufe / 100 : 0;
+            if (platz == 0) {
+                setzen_hell(1, 0, 0, 0, 0, 0);
+                setzen_hell(1, 1, 0, 0, 0, 0);
+            } else {
+                setzen_hell(0, platz, r, g, b, e.hell);
+            }
+            continue;
+        }
+        switch (e.modus) {
+        case C2_LICHT_STATISCH:
+            r = e.farbe[0], g = e.farbe[1], b = e.farbe[2];
+            break;
+        case C2_LICHT_ATMEN: {
+            u32 periode = 4000 - 30 * (u32)(e.tempo > 100 ? 100 : e.tempo); /* 4 s .. 1 s */
+            u32 phase = ms % periode;
+            u8 stufe = phase < periode / 2 ? phase * 200 / periode : 200 - phase * 200 / periode; /* 0..100 */
+            r = skalieren(e.farbe[0], stufe), g = skalieren(e.farbe[1], stufe), b = skalieren(e.farbe[2], stufe);
+            break;
+        }
+        case C2_LICHT_REAKTIV:
+            r = (u16)blitz_r * blitz / 255, g = (u16)blitz_g * blitz / 255, b = (u16)blitz_b * blitz / 255;
+            break;
+        case C2_LICHT_REGENBOGEN:
+            farbrad((hue + platz * 188) % 1536, &r, &g, &b);
+            break;
+        case C2_LICHT_FARBWECHSEL:
+            farbrad(hue, &r, &g, &b);
+            break;
+        default:
+            r = g = b = 0;
+            break;
+        }
+        if (platz == 0) {
+            setzen_hell(1, 0, r, g, b, e.hell);
+            setzen_hell(1, 1, r, g, b, e.hell);
+        } else {
+            setzen_hell(0, platz, r, g, b, e.hell);
+        }
+    }
+}
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_anzeige.h b/apps/hid/modules/c2lite/c2_anzeige.h
new file mode 100644
index 0000000..32731f8
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_anzeige.h
@@ -0,0 +1,39 @@
+#ifndef C2_ANZEIGE_H
+#define C2_ANZEIGE_H
+/* C2 Lite: Zustandsanzeige über die Spieler-LEDs (c2_anzeige.c) */
+
+#define C2_ANZEIGE_TAKT_MS 10 /* Aufruftakt aus der Tastenabfrage (c2_eingaben.c, TAKT_MS) */
+
+struct c2_anzeige_lage {
+    u16 rettung_promille; /* Fortschritt Home + Minus, 0 = nicht gedrückt */
+    u8 usb_5v;            /* Spannung am USB (PB5) */
+    u8 usb_host;          /* PC holt USB-Reports ab */
+    u8 ble_verbunden;
+    u8 akku_prozent;      /* 0 = noch nicht gemessen */
+    u8 laedt;             /* am USB und der Lade-IC lädt (PB4) */
+    u32 ruhe_ms;          /* Zeit seit der letzten Eingabe (Taste oder Stick) */
+    u8 spieler;           /* Switch: Spieler-LEDs von der Konsole (Bit 0 = Spieler 1), sonst 0 */
+    u16 ota_promille;     /* Firmware-Update läuft (c2_ota.c), sonst 0 */
+    u8 druck_gruppe;      /* neu gedrückt in dieser Runde: 0 keine, 1 Aktionstasten, 2 Schultertasten, 3 Steuerkreuz, 4 sonst */
+    u8 logo_an;           /* Belegung (Aufnahme, Bedienschritt): Logo in dieser Farbe statt Status */
+    u8 logo[3];
+    u8 ladeschlaf;        /* lange Ruhe am Ladegerät: nur das Logo zeigt gedimmt den Ladezustand */
+};
+
+/* Liefert die LED-Maske für diese Runde */
+u8 c2_anzeige_berechnen(const struct c2_anzeige_lage *l);
+
+/* Lichteffekte von Streifen und Seiten; Logo zeigt den Zustand */
+enum { C2_LICHT_STATISCH, C2_LICHT_ATMEN, C2_LICHT_REGENBOGEN, C2_LICHT_FARBWECHSEL, C2_LICHT_AUS, C2_LICHT_REAKTIV };
+#define C2_LICHT_LETZTER C2_LICHT_REAKTIV
+struct c2_licht {
+    u8 modus;     /* C2_LICHT_* */
+    u8 hell;      /* Streifen/Seiten 0..100 % */
+    u8 logo_hell; /* Logo 0..100 % */
+    u8 tempo;     /* 1..100 */
+    u8 farbe[3];  /* R, G, B für statisch und atmen */
+};
+/* Setzt die RGB-Farben dieser Runde (nach c2_anzeige_berechnen aufrufen) */
+void c2_anzeige_rgb(const struct c2_anzeige_lage *l, const struct c2_licht *e);
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_belegung.c b/apps/hid/modules/c2lite/c2_belegung.c
new file mode 100644
index 0000000..fcd4bde
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_belegung.c
@@ -0,0 +1,813 @@
+/* C2 Lite: Rücktasten, M-Taste, Turbo und Makros. Bedienung wie die Werks-Firmware 0.04 (statische Analyse 30.10.:
+ * Werkszustand 0x85AC mit Tabelle app 0x24500, Zustandsautomat 0x17712, Aufnahme 0x18028/0x19110, Turbo 0x17A2E,
+ * Wiedergabe 0x18080, Speichern ~2 s nach der letzten Änderung 0x1A5EA). Funktionstaste ist die Licht-Taste:
+ *   Licht 3 s allein halten        Aufnahme: jede Änderung der Tasten wird ein Schritt (höchstens 80, Abbruch nach
+ *                                  31 s ohne Änderung), Logo blinkt türkis
+ *   ... dann Rück1, Rück2 oder M   Abschluss: nichts aufgenommen = Taste aus, ein Schritt = Taste, sonst Makro
+ *   Licht halten + Taste           Turbo dieser Taste: aus -> beim Halten -> automatisch (an/aus per Druck) -> aus
+ *   Licht halten + Rück1/Rück2/M   Makro: einmal <-> endlos; liegt dort eine Taste, schaltet es deren Turbo
+ *   Licht halten + linker Stick    links/rechts: Turbo-Tempo 5/8/12 Hz, hoch/runter: Vibrationsstärke
+ * Mischform (eigene Bedienung bleibt): Licht kurz = nächster Lichtmodus, Licht + rechter Stick hoch/runter =
+ * Helligkeit, Licht während der Aufnahme = Abbruch.
+ * Werkszustand: Rück1 = B, Rück2 = A, M = Makro Home, runter, runter, rechts, A. Rücktasten, M und Licht werden selbst
+ * nie gesendet, nur das, was auf ihnen liegt. */
+#include "app_config.h"
+#include "system/includes.h"
+#include "c2_log.h"
+#include "c2_belegung.h"
+#include "c2_switch.h"
+
+#ifdef CONFIG_BOARD_C2LITE
+
+#define TAKT 10
+#define PLAETZE 3
+#define SCHRITTE 80
+/* Code wie der 32-Bit-Code der Werks-FW, aber in unserer Rollen-Reihenfolge: Bit 0..15 = Rollen 0..15 (Tasten),
+ * 16..19 = Steuerkreuz hoch/rechts/runter/links, 20..23 linker Stick hoch/rechts/runter/links, 24..27 rechter */
+#define CODE_BITS 28
+#define CODE_TASTEN 0xFFFFFu /* Tasten und Steuerkreuz, ohne Stick-Richtungen */
+#define TURBO_N (CODE_BITS + PLAETZE) /* Turbo je Code-Bit und je Rücktaste mit Tastenbelegung */
+#define STICK_KLEIN 256 /* Stick-Richtung wie die Werks-FW: unter 1/4 bzw. über 3/4 des Wegs */
+#define STICK_GROSS 767
+#define CFG_PLATZ0 19 /* VM-IDs 19..21 je Platz, 48 Turbo (in user_cfg_id.h frei) */
+#define CFG_TURBO 48
+#define VERSION 1
+#define AUFNAHME_AB_MS 3000
+#define AUFNAHME_ENDE_MS 31000
+#define ZEIT_MAX 30000
+
+enum { AUS, TASTE, MAKRO };
+enum { LOOP_ENDLOS, LOOP_EINMAL, LOOP_HALTEN };
+struct schritt {
+    u32 code;
+    u16 halten, pause; /* ms */
+};
+struct platz {
+    u8 version, art, loop, n; /* n = Schritte (nur Makro) */
+    u16 intervall, reserve;   /* ms zwischen zwei Durchläufen (endlos/halten) */
+    u32 code;                 /* Taste(n) bei art = TASTE */
+    struct schritt s[SCHRITTE];
+};
+static struct platz platz[PLAETZE];
+static struct {
+    u8 version, tempo; /* 0..2 = 5/8/12 Hz */
+    u8 modus[TURBO_N]; /* 0 aus, 1 beim Halten, 2 automatisch */
+} turbo;
+
+static const u8 PLATZ_ROLLE[PLAETZE] = {C2_BELEG_ROLLE_RUECK1, C2_BELEG_ROLLE_RUECK2, C2_BELEG_ROLLE_M};
+static const char *const PLATZ_NAME[PLAETZE] = {"rueck1", "rueck2", "m"};
+static const char *const CODE_NAME[CODE_BITS] = {
+    "b", "a", 0, "x", "y", 0, "l", "r", "zl", "zr", "minus", "plus", "home", "l3", "r3", "kamera",
+    "hoch", "rechts", "runter", "links", "lhoch", "lrechts", "lrunter", "llinks", "rhoch", "rrechts", "rrunter", "rlinks"};
+static const u16 TURBO_PERIODE[3] = {200, 125, 83}; /* ms */
+#define F_BIT (1ULL << C2_BELEG_ROLLE_LICHT)
+#define PLATZ_BITS ((1ULL << C2_BELEG_ROLLE_RUECK1) | (1ULL << C2_BELEG_ROLLE_RUECK2) | (1ULL << C2_BELEG_ROLLE_M))
+
+static u32 jetzt;               /* ms seit dem Start */
+static u64 alt_r;
+static u32 alt_code;
+static u8 offen;                /* Bit 0..2 Platz, Bit 3 Turbo: noch zu speichern */
+static u32 speichern_ab;
+/* Funktionstaste */
+static u8 f_gehalten, f_benutzt, einst_geaendert;
+static u32 f_ms;
+static u8 stick_n[3];
+static u32 unterdrueckt;        /* Code-Bits, die während der Funktionstaste gedrückt wurden: bis zum Loslassen stumm */
+static u64 platz_sperre;        /* Rücktaste nach Abschluss/Kombination: bis zum Loslassen ohne Wirkung */
+static u32 auto_an;             /* Turbo automatisch gerade an (Bit = Turbo-Index) */
+static u8 led_an;
+/* Aufnahme */
+static u8 aufnahme, auf_n;
+static u32 auf_code, auf_seit, auf_letzt;
+static struct schritt auf[SCHRITTE];
+/* Wiedergabe */
+static struct {
+    u8 aktiv, i, phase; /* phase 0 = Schritt halten, 1 = Pause danach, 2 = Intervall vor dem nächsten Durchlauf */
+    u32 rest;
+} lauf[PLAETZE];
+/* Logo-Hinweis */
+static u8 hinweis_rgb[3], hinweis_n;
+static u32 hinweis_ab;
+
+static void hinweis(u8 r, u8 g, u8 b, u8 n)
+{
+    hinweis_rgb[0] = r, hinweis_rgb[1] = g, hinweis_rgb[2] = b, hinweis_n = n, hinweis_ab = jetzt;
+}
+
+static u32 code_aus(u64 r, const u16 *a)
+{
+    u32 c = (u32)(r & 0xFFFF) | (u32)((r >> C2_BELEG_ROLLE_HOCH) & 0xF) << 16;
+    for (int s = 0; s < 2; s++) {
+        u16 x = a[2 * s], y = a[2 * s + 1];
+        u32 b = 20 + 4 * s;
+        c |= (u32)(y < STICK_KLEIN) << b | (u32)(x > STICK_GROSS) << (b + 1) | (u32)(y > STICK_GROSS) << (b + 2) |
+             (u32)(x < STICK_KLEIN) << (b + 3);
+    }
+    return c;
+}
+
+static u64 rollen_aus(u32 c)
+{
+    return (c & 0xFFFF) | (u64)((c >> 16) & 0xF) << C2_BELEG_ROLLE_HOCH;
+}
+
+static void achsen_setzen(u32 c, u16 *a)
+{
+    for (int s = 0; s < 2; s++) {
+        u32 b = c >> (20 + 4 * s);
+        if (b & 1) {
+            a[2 * s + 1] = 0;
+        }
+        if (b & 4) {
+            a[2 * s + 1] = 1023;
+        }
+        if (b & 2) {
+            a[2 * s] = 1023;
+        }
+        if (b & 8) {
+            a[2 * s] = 0;
+        }
+    }
+}
+
+static void werkszustand(void)
+{
+    memset(platz, 0, sizeof(platz));
+    for (int i = 0; i < PLAETZE; i++) {
+        platz[i].version = VERSION, platz[i].loop = LOOP_EINMAL, platz[i].intervall = 800;
+    }
+    platz[0].art = TASTE, platz[0].code = BIT(0); /* B */
+    platz[1].art = TASTE, platz[1].code = BIT(1); /* A */
+    static const struct schritt M[] = {{BIT(12), 200, 600}, {BIT(18), 200, 100}, {BIT(18), 200, 100},
+                                       {BIT(17), 200, 100}, {BIT(1), 200, 100}}; /* Home, runter, runter, rechts, A */
+    platz[2].art = MAKRO, platz[2].n = ARRAY_SIZE(M);
+    memcpy(platz[2].s, M, sizeof(M));
+    memset(&turbo, 0, sizeof(turbo));
+    turbo.version = VERSION, turbo.tempo = 1;
+    memset(lauf, 0, sizeof(lauf));
+    auto_an = 0;
+}
+
+static void merken(u8 was)
+{
+    offen |= was;
+    speichern_ab = jetzt + 2000;
+}
+
+static void sichern(void)
+{
+    for (int i = 0; i < PLAETZE; i++) {
+        if (offen & BIT(i)) {
+            syscfg_write(CFG_PLATZ0 + i, (u8 *)&platz[i], sizeof(platz[i]));
+        }
+    }
+    if (offen & BIT(3)) {
+        syscfg_write(CFG_TURBO, (u8 *)&turbo, sizeof(turbo));
+    }
+    offen = 0;
+}
+
+void c2_belegung_init(void)
+{
+    static struct platz p; /* 652 Byte: nicht auf den Stack */
+    werkszustand();
+    int geladen = 0;
+    for (int i = 0; i < PLAETZE; i++) {
+        if (syscfg_read(CFG_PLATZ0 + i, (u8 *)&p, sizeof(p)) == sizeof(p) && p.version == VERSION && p.art <= MAKRO &&
+            p.n <= SCHRITTE && p.loop <= LOOP_HALTEN) {
+            platz[i] = p;
+            geladen++;
+        }
+        if (platz[i].loop == LOOP_ENDLOS) {
+            platz[i].loop = LOOP_EINMAL; /* wie die Werks-FW beim Start (0x947A) */
+        }
+    }
+    typeof(turbo) t;
+    if (syscfg_read(CFG_TURBO, (u8 *)&t, sizeof(t)) == sizeof(t) && t.version == VERSION && t.tempo <= 2) {
+        turbo = t;
+        geladen++;
+    }
+    c2_log("Belegung: %d von %d Einträgen geladen, Rest Werkszustand\r\n", geladen, PLAETZE + 1);
+}
+
+/* Tasten als Text „a+b“ */
+static void code_text(u32 c, char *z, int max)
+{
+    int n = 0;
+    z[0] = 0;
+    for (int i = 0; i < CODE_BITS && n < max - 10; i++) {
+        if ((c & BIT(i)) && CODE_NAME[i]) {
+            n += sprintf(z + n, "%s%s", n ? "+" : "", CODE_NAME[i]);
+        }
+    }
+    if (!n) {
+        strcpy(z, "nichts");
+    }
+}
+
+static void makro_start(int p)
+{
+    lauf[p].aktiv = 1, lauf[p].i = 0, lauf[p].phase = 0, lauf[p].rest = platz[p].s[0].halten;
+}
+
+/* Ein Takt Wiedergabe, liefert den Code dieses Takts */
+static u32 makro_takt(int p)
+{
+    struct platz *m = &platz[p];
+    if (!lauf[p].aktiv || !m->n) {
+        lauf[p].aktiv = 0;
+        return 0;
+    }
+    if (lauf[p].rest > TAKT) {
+        lauf[p].rest -= TAKT;
+    } else if (lauf[p].phase == 0) {
+        lauf[p].phase = 1, lauf[p].rest = m->s[lauf[p].i].pause;
+    } else if (lauf[p].phase == 1) {
+        if (++lauf[p].i >= m->n) {
+            if (m->loop == LOOP_EINMAL) {
+                lauf[p].aktiv = 0;
+                return 0;
+            }
+            lauf[p].phase = 2, lauf[p].rest = m->intervall;
+        } else {
+            lauf[p].phase = 0, lauf[p].rest = m->s[lauf[p].i].halten;
+        }
+    } else {
+        makro_start(p);
+    }
+    return lauf[p].phase == 0 ? m->s[lauf[p].i].code : 0;
+}
+
+static void turbo_weiter(int i)
+{
+    turbo.modus[i] = (turbo.modus[i] + 1) % 3;
+    auto_an &= ~BIT(i);
+    merken(BIT(3));
+    static const char *const MODUS[3] = {"aus", "halten", "auto"};
+    c2_log("turbo: %s = %s\r\n", i < CODE_BITS ? CODE_NAME[i] : PLATZ_NAME[i - CODE_BITS], MODUS[turbo.modus[i]]);
+    if (turbo.modus[i] == 0) {
+        hinweis(255, 0, 0, 1);
+    } else {
+        hinweis(255, 160, 0, turbo.modus[i]); /* gelb: 1 = beim Halten, 2 = automatisch */
+    }
+}
+
+static void aufnahme_ende(int p)
+{
+    if (auf_code && auf_n < SCHRITTE) {
+        u32 d = jetzt - auf_seit;
+        auf[auf_n++] = (struct schritt){auf_code, d > ZEIT_MAX ? ZEIT_MAX : d, 0};
+    }
+    aufnahme = 0;
+    if (p < 0) {
+        c2_log("belegung: Aufnahme abgebrochen\r\n");
+        hinweis(255, 0, 0, 2);
+        return;
+    }
+    struct platz *m = &platz[p];
+    turbo.modus[CODE_BITS + p] = 0;
+    auto_an &= ~BIT(CODE_BITS + p);
+    lauf[p].aktiv = 0;
+    m->art = !auf_n ? AUS : auf_n == 1 ? TASTE : MAKRO;
+    m->code = auf_n == 1 ? auf[0].code : 0;
+    m->n = auf_n > 1 ? auf_n : 0;
+    memset(m->s, 0, sizeof(m->s));
+    memcpy(m->s, auf, auf_n * sizeof(auf[0]));
+    m->loop = LOOP_EINMAL, m->intervall = 800;
+    merken(BIT(p) | BIT(3));
+    platz_sperre |= 1ULL << PLATZ_ROLLE[p];
+    char z[60];
+    code_text(m->code, z, sizeof(z));
+    if (m->art == MAKRO) {
+        c2_log("belegung: %s = makro mit %u Schritten\r\n", PLATZ_NAME[p], m->n);
+    } else {
+        c2_log("belegung: %s = %s\r\n", PLATZ_NAME[p], m->art == AUS ? "aus" : z);
+    }
+    hinweis(0, 255, 0, 2);
+    c2_motor_setzen(60, 60, 80);
+}
+
+static void aufnahme_takt(u64 neu, u32 code)
+{
+    if (neu & F_BIT) {
+        aufnahme_ende(-1);
+        return;
+    }
+    for (int p = 0; p < PLAETZE; p++) {
+        if (neu & (1ULL << PLATZ_ROLLE[p])) {
+            aufnahme_ende(p);
+            return;
+        }
+    }
+    if (code != auf_code) {
+        u32 d = jetzt - auf_seit;
+        d = d > ZEIT_MAX ? ZEIT_MAX : d;
+        if (auf_code) {
+            if (auf_n < SCHRITTE) {
+                auf[auf_n++] = (struct schritt){auf_code, d, 0};
+            }
+        } else if (auf_n) {
+            auf[auf_n - 1].pause = d;
+        }
+        auf_code = code, auf_seit = jetzt, auf_letzt = jetzt;
+    }
+    if (jetzt - auf_letzt > AUFNAHME_ENDE_MS) {
+        aufnahme_ende(-1);
+    }
+}
+
+/* Funktionstaste + Stick: k 0 = linker Stick links/rechts (Turbo-Tempo), 1 = linker Stick hoch/runter (Vibration),
+ * 2 = rechter Stick hoch/runter (Helligkeit). Je Auslenkung (länger als 60 ms) ein Schritt. */
+static void stick_kombi(int k, u16 wert, int gross_ist_plus)
+{
+    int richtung = wert > STICK_GROSS ? 1 : wert < STICK_KLEIN ? -1 : 0;
+    if (!richtung) {
+        stick_n[k] = 0;
+        return;
+    }
+    if (stick_n[k] == 0xFF || ++stick_n[k] < 60 / TAKT) {
+        return;
+    }
+    stick_n[k] = 0xFF;
+    f_benutzt = 1;
+    int d = gross_ist_plus ? richtung : -richtung;
+    if (k == 0) {
+        int t = turbo.tempo + d;
+        turbo.tempo = t < 0 ? 0 : t > 2 ? 2 : t;
+        merken(BIT(3));
+        c2_log("turbo: tempo %u\r\n", turbo.tempo);
+        hinweis(0, 80, 255, turbo.tempo + 1);
+    } else if (k == 1) {
+        u8 v = c2_vibration_schritt(25 * d);
+        c2_motor_setzen(v, v, 80);
+        einst_geaendert = 1;
+    } else {
+        c2_licht_hell_schritt(10 * d);
+        einst_geaendert = 1;
+    }
+}
+
+static void funktionstaste(u64 r, u64 neu, u32 code, u32 code_neu, u16 *a)
+{
+    if (neu & F_BIT) {
+        f_gehalten = 1, f_benutzt = 0, f_ms = 0, einst_geaendert = 0;
+        memset(stick_n, 0, sizeof(stick_n));
+    }
+    if (!f_gehalten) {
+        return;
+    }
+    if (!(r & F_BIT)) {
+        f_gehalten = 0;
+        if (!f_benutzt && f_ms < AUFNAHME_AB_MS) {
+            c2_licht_weiter();
+            einst_geaendert = 1;
+        }
+        if (einst_geaendert) {
+            c2_einstellungen_sichern();
+        }
+        return;
+    }
+    f_ms += TAKT;
+    u32 tasten_neu = code_neu & CODE_TASTEN & ~unterdrueckt;
+    if (tasten_neu & BIT(C2_ROLLE_HOME)) {
+        /* Licht + Home: Weckkennung für die Switch 2 lernen (Turbo auf Home wäre sinnlos) */
+        extern int c2_weck_lernen(void);
+        tasten_neu &= ~BIT(C2_ROLLE_HOME);
+        f_benutzt = 1;
+        if (c2_weck_lernen()) {
+            hinweis(255, 0, 0, 1);
+        }
+    }
+    for (int i = 0; tasten_neu && i < CODE_BITS; i++) {
+        if ((tasten_neu & BIT(i)) && CODE_NAME[i]) {
+            turbo_weiter(i);
+            f_benutzt = 1;
+        }
+    }
+    unterdrueckt |= code & CODE_TASTEN;
+    for (int p = 0; p < PLAETZE; p++) {
+        u64 bit = 1ULL << PLATZ_ROLLE[p];
+        if (!(neu & bit)) {
+            continue;
+        }
+        f_benutzt = 1;
+        platz_sperre |= bit;
+        if (platz[p].art == MAKRO) {
+            platz[p].loop = platz[p].loop == LOOP_EINMAL ? LOOP_ENDLOS : LOOP_EINMAL;
+            lauf[p].aktiv = 0;
+            merken(BIT(p));
+            c2_log("belegung: %s makro %s\r\n", PLATZ_NAME[p], platz[p].loop == LOOP_ENDLOS ? "endlos" : "einmal");
+            hinweis(255, 0, 200, platz[p].loop == LOOP_ENDLOS ? 2 : 1);
+        } else if (platz[p].art == TASTE) {
+            turbo_weiter(CODE_BITS + p);
+        }
+    }
+    stick_kombi(0, a[0], 1);
+    stick_kombi(1, a[1], 0); /* hoch = klein = stärker */
+    stick_kombi(2, a[3], 0);
+    for (int i = 0; i < 4; i++) {
+        a[i] = 512; /* Sticks stehen still, solange die Funktionstaste gehalten wird */
+    }
+    if (!f_benutzt && f_ms >= AUFNAHME_AB_MS && !(code & CODE_TASTEN)) {
+        f_benutzt = 1;
+        aufnahme = 1, auf_n = 0, auf_code = 0, auf_seit = jetzt, auf_letzt = jetzt;
+        memset(lauf, 0, sizeof(lauf));
+        c2_log("belegung: Aufnahme läuft (Tasten drücken, dann Rück1, Rück2 oder M)\r\n");
+        c2_motor_setzen(100, 100, 80);
+    }
+}
+
+u64 c2_belegung_takt(u64 r, u16 a[4])
+{
+    jetzt += TAKT;
+    u64 neu = r & ~alt_r;
+    alt_r = r;
+    u32 code = code_aus(r, a);
+    u32 code_neu = code & ~alt_code;
+    alt_code = code;
+    if (offen && (s32)(jetzt - speichern_ab) >= 0) {
+        sichern();
+    }
+    unterdrueckt &= code;
+    platz_sperre &= r;
+    u64 basis = r & ~(0xFFFFULL | 0xFULL << C2_BELEG_ROLLE_HOCH | PLATZ_BITS | F_BIT);
+    if (aufnahme) {
+        aufnahme_takt(neu, code);
+        led_an = 0;
+        return basis | rollen_aus(code); /* während der Aufnahme normal weiter senden */
+    }
+    funktionstaste(r, neu, code, code_neu, a);
+    if (aufnahme) {
+        return basis;
+    }
+
+    u32 periode = TURBO_PERIODE[turbo.tempo];
+    int phase = jetzt % periode < periode / 2;
+    int turbo_laeuft = 0;
+    u32 aus = code & CODE_TASTEN & ~unterdrueckt;
+    u32 frisch = code_neu & CODE_TASTEN & ~unterdrueckt;
+    for (int i = 0; i < 20; i++) {
+        u32 bit = BIT(i);
+        if (turbo.modus[i] == 1 && (aus & bit)) {
+            turbo_laeuft = 1;
+            if (!phase) {
+                aus &= ~bit;
+            }
+        } else if (turbo.modus[i] == 2) {
+            if (frisch & bit) {
+                auto_an ^= bit;
+            }
+            if (auto_an & bit) {
+                turbo_laeuft = 1;
+                aus = phase ? aus | bit : aus & ~bit;
+            }
+        }
+    }
+    /* Eine andere Taste beendet ein endloses Makro („button stop“) */
+    if (frisch) {
+        for (int p = 0; p < PLAETZE; p++) {
+            if (platz[p].loop == LOOP_ENDLOS) {
+                lauf[p].aktiv = 0;
+            }
+        }
+    }
+    u32 extra = 0;
+    int makro_blinkt = 0;
+    for (int p = 0; p < PLAETZE; p++) {
+        u64 bit = 1ULL << PLATZ_ROLLE[p];
+        int gedrueckt = (r & bit) && !(platz_sperre & bit);
+        int gedrueckt_neu = gedrueckt && (neu & bit);
+        struct platz *m = &platz[p];
+        int t = CODE_BITS + p;
+        if (m->art == TASTE) {
+            u32 c = gedrueckt ? m->code : 0;
+            if (turbo.modus[t] == 1 && c) {
+                turbo_laeuft = 1;
+                c = phase ? c : 0;
+            } else if (turbo.modus[t] == 2) {
+                if (gedrueckt_neu) {
+                    auto_an ^= BIT(t);
+                }
+                if (auto_an & BIT(t)) {
+                    turbo_laeuft = 1;
+                    c = phase ? m->code : 0;
+                }
+            }
+            extra |= c;
+        } else if (m->art == MAKRO) {
+            if (gedrueckt_neu) {
+                if (m->loop == LOOP_ENDLOS && lauf[p].aktiv) {
+                    lauf[p].aktiv = 0;
+                } else {
+                    makro_start(p);
+                }
+            }
+            if (m->loop == LOOP_HALTEN && !gedrueckt) {
+                lauf[p].aktiv = 0;
+            }
+            extra |= makro_takt(p);
+            makro_blinkt |= lauf[p].aktiv && m->loop != LOOP_EINMAL;
+        }
+    }
+    led_an = (turbo_laeuft && phase) || (makro_blinkt && (jetzt / 246) % 2);
+    achsen_setzen(extra, a);
+    return basis | rollen_aus(aus | extra);
+}
+
+/* Aufnahme oder ein laufendes Makro zählen als Benutzung (kein Abschalten bei Ruhe) */
+int c2_belegung_beschaeftigt(void)
+{
+    for (int p = 0; p < PLAETZE; p++) {
+        if (lauf[p].aktiv) {
+            return 1;
+        }
+    }
+    return aufnahme;
+}
+
+void c2_belegung_hinweis(u8 r, u8 g, u8 b, u8 n)
+{
+    hinweis(r, g, b, n);
+}
+
+int c2_belegung_logo(u8 rgb[3])
+{
+    extern int c2_weck_lernt(void);
+    if (c2_weck_lernt()) {
+        u8 an = (jetzt / 200) % 2;
+        rgb[0] = an ? 255 : 0, rgb[1] = an ? 120 : 0, rgb[2] = 0; /* orange blinkend: lauscht auf ein Wecksignal */
+        return 1;
+    }
+    if (aufnahme) {
+        u8 an = (jetzt / 250) % 2;
+        rgb[0] = 0, rgb[1] = an ? 255 : 0, rgb[2] = an ? 255 : 0; /* türkis blinkend wie die Werks-FW (0, 255, 255) */
+        return 1;
+    }
+    if (hinweis_n) {
+        u32 k = (jetzt - hinweis_ab) / 150;
+        if (k >= 2u * hinweis_n) {
+            hinweis_n = 0;
+            return 0;
+        }
+        u8 an = !(k & 1);
+        rgb[0] = an ? hinweis_rgb[0] : 0, rgb[1] = an ? hinweis_rgb[1] : 0, rgb[2] = an ? hinweis_rgb[2] : 0;
+        return 1;
+    }
+    return 0;
+}
+
+u8 c2_belegung_led(void)
+{
+    return led_an ? 0x20 : 0; /* Spieler-LED 4 wie die Werks-FW (Maskenbit 0x20) */
+}
+
+/* ---------- Textbefehle ---------- */
+
+static const char *wort(const char *p, char *w, int max)
+{
+    while (*p == ' ') {
+        p++;
+    }
+    int n = 0;
+    while (*p && *p != ' ' && n < max - 1) {
+        w[n++] = *p++;
+    }
+    w[n] = 0;
+    return p;
+}
+
+/* „a+b+hoch“ -> Code, 0 bei unbekanntem Namen */
+static u32 tasten_lesen(const char *s, int *fehler)
+{
+    u32 c = 0;
+    char n[12];
+    while (*s && *s != ':') {
+        int k = 0;
+        while (*s && *s != '+' && *s != ':' && k < (int)sizeof(n) - 1) {
+            n[k++] = *s++;
+        }
+        n[k] = 0;
+        int gefunden = 0;
+        for (int i = 0; i < CODE_BITS; i++) {
+            if (CODE_NAME[i] && !strcmp(n, CODE_NAME[i])) {
+                c |= BIT(i), gefunden = 1;
+            }
+        }
+        if (!gefunden) {
+            *fehler = 1;
+        }
+        if (*s == '+') {
+            s++;
+        }
+    }
+    return c;
+}
+
+static u32 zahl(const char **s)
+{
+    u32 v = 0;
+    while (**s >= '0' && **s <= '9') {
+        v = v * 10 + (*(*s)++ - '0');
+    }
+    return v;
+}
+
+static void platz_melden(int p)
+{
+    struct platz *m = &platz[p];
+    static const char *const LOOP[3] = {"endlos", "einmal", "halten"};
+    char z[80];
+    if (m->art == MAKRO) {
+        c2_log("belegung: %s = makro schritte=%u loop=%s intervall=%u\r\n", PLATZ_NAME[p], m->n, LOOP[m->loop], m->intervall);
+        /* Mehrere Schritte je Zeile: „belegung: m 1 a+b:200:100 x:50:50 ...“ (Zahl = Nummer des ersten Schritts) */
+        char zeile[150];
+        int n = 0;
+        for (int i = 0; i < m->n; i++) {
+            if (!n) {
+                n = sprintf(zeile, "belegung: %s %u", PLATZ_NAME[p], i + 1);
+            }
+            code_text(m->s[i].code, z, sizeof(z));
+            n += sprintf(zeile + n, " %s:%u:%u", z, m->s[i].halten, m->s[i].pause);
+            if (n > 100 || i + 1 == m->n) {
+                c2_log("%s\r\n", zeile);
+                n = 0;
+            }
+        }
+    } else {
+        code_text(m->code, z, sizeof(z));
+        c2_log("belegung: %s = %s\r\n", PLATZ_NAME[p], m->art == AUS ? "aus" : z);
+    }
+}
+
+static void turbo_melden(void)
+{
+    static const char *const MODUS[3] = {"aus", "halten", "auto"};
+    char z[150];
+    int n = sprintf(z, "turbo: tempo=%u (%u Hz)", turbo.tempo, 1000 / TURBO_PERIODE[turbo.tempo]);
+    for (int i = 0; i < TURBO_N && n < (int)sizeof(z) - 20; i++) {
+        if (turbo.modus[i]) {
+            n += sprintf(z + n, " %s=%s", i < CODE_BITS ? CODE_NAME[i] : PLATZ_NAME[i - CODE_BITS], MODUS[turbo.modus[i]]);
+        }
+    }
+    c2_log("%s\r\n", z);
+}
+
+static int platz_finden(const char *w)
+{
+    for (int p = 0; p < PLAETZE; p++) {
+        if (!strcmp(w, PLATZ_NAME[p])) {
+            return p;
+        }
+    }
+    return -1;
+}
+
+/* belegung | belegung standard | belegung <rueck1|rueck2|m> aus | taste <a+b> | makro[+] <taste:halten:pause> ... |
+ *   loop <einmal|endlos|halten> | intervall <ms>
+ * turbo | turbo tempo <0..2> | turbo <taste|rueck1|rueck2|m> <aus|halten|auto> */
+int c2_belegung_befehl(const char *b)
+{
+    char w[16], x[16];
+    if (!strncmp(b, "belegung", 8) && (!b[8] || b[8] == ' ')) {
+        const char *p = wort(b + 8, w, sizeof(w));
+        if (!w[0]) {
+            for (int i = 0; i < PLAETZE; i++) {
+                platz_melden(i);
+            }
+            turbo_melden();
+            c2_log("ok: belegung\r\n");
+            return 1;
+        }
+        if (!strcmp(w, "standard")) {
+            werkszustand();
+            merken(0x0F);
+            c2_log("ok: belegung standard (Werkszustand)\r\n");
+            return 1;
+        }
+        int pl = platz_finden(w);
+        p = wort(p, x, sizeof(x));
+        if (pl < 0 || !x[0]) {
+            c2_log("fehler: belegung <rueck1|rueck2|m> <aus|taste|makro|loop|intervall> ...\r\n");
+            return 1;
+        }
+        struct platz *m = &platz[pl];
+        int fehler = 0;
+        if (!strcmp(x, "aus")) {
+            m->art = AUS, m->code = 0, m->n = 0;
+        } else if (!strcmp(x, "taste")) {
+            char t[64];
+            wort(p, t, sizeof(t));
+            u32 c = tasten_lesen(t, &fehler);
+            if (fehler || !c) {
+                c2_log("fehler: unbekannte Taste in „%s“\r\n", t);
+                return 1;
+            }
+            m->art = TASTE, m->code = c, m->n = 0;
+        } else if (!strcmp(x, "makro") || !strcmp(x, "makro+")) {
+            /* „makro+“ hängt an (lange Makros über mehrere Zeilen, eine Zeile hat höchstens 600 Zeichen) */
+            static struct schritt neu[SCHRITTE];
+            int anhaengen = x[5] == '+' && m->art == MAKRO;
+            int n = anhaengen ? m->n : 0;
+            if (anhaengen) {
+                memcpy(neu, m->s, n * sizeof(neu[0]));
+            }
+            char t[64];
+            for (p = wort(p, t, sizeof(t)); t[0]; p = wort(p, t, sizeof(t))) {
+                if (n >= SCHRITTE) {
+                    c2_log("fehler: höchstens %d Schritte\r\n", SCHRITTE);
+                    return 1;
+                }
+                const char *q = strchr(t, ':');
+                u32 halten = 100, pause = 100;
+                if (q) {
+                    q++;
+                    halten = zahl(&q);
+                    if (*q == ':') {
+                        q++;
+                        pause = zahl(&q);
+                    }
+                }
+                neu[n].code = tasten_lesen(t, &fehler);
+                neu[n].halten = halten > ZEIT_MAX ? ZEIT_MAX : halten;
+                neu[n].pause = pause > ZEIT_MAX ? ZEIT_MAX : pause;
+                if (fehler) {
+                    c2_log("fehler: unbekannte Taste in „%s“\r\n", t);
+                    return 1;
+                }
+                n++;
+            }
+            if (!n) {
+                c2_log("fehler: belegung %s makro[+] <taste[+taste]:halten:pause> ...\r\n", PLATZ_NAME[pl]);
+                return 1;
+            }
+            memset(m->s, 0, sizeof(m->s));
+            memcpy(m->s, neu, n * sizeof(neu[0]));
+            m->art = MAKRO, m->n = n, m->code = 0;
+        } else if (!strcmp(x, "loop")) {
+            wort(p, x, sizeof(x));
+            int l = !strcmp(x, "endlos") ? LOOP_ENDLOS : !strcmp(x, "einmal") ? LOOP_EINMAL : !strcmp(x, "halten") ? LOOP_HALTEN : -1;
+            if (l < 0) {
+                c2_log("fehler: loop einmal | endlos | halten\r\n");
+                return 1;
+            }
+            m->loop = l;
+        } else if (!strcmp(x, "intervall")) {
+            while (*p == ' ') {
+                p++;
+            }
+            u32 v = zahl(&p);
+            m->intervall = v > ZEIT_MAX ? ZEIT_MAX : v;
+        } else {
+            c2_log("fehler: belegung %s <aus|taste|makro|loop|intervall>\r\n", PLATZ_NAME[pl]);
+            return 1;
+        }
+        lauf[pl].aktiv = 0;
+        merken(BIT(pl));
+        platz_melden(pl);
+        c2_log("ok: belegung %s\r\n", PLATZ_NAME[pl]);
+        return 1;
+    }
+    if (!strncmp(b, "turbo", 5) && (!b[5] || b[5] == ' ')) {
+        const char *p = wort(b + 5, w, sizeof(w));
+        p = wort(p, x, sizeof(x));
+        if (!w[0]) {
+            turbo_melden();
+            c2_log("ok: turbo\r\n");
+            return 1;
+        }
+        if (!strcmp(w, "tempo")) {
+            const char *q = x;
+            u32 t = zahl(&q);
+            if (!x[0] || t > 2) {
+                c2_log("fehler: turbo tempo <0|1|2> (5/8/12 Hz)\r\n");
+                return 1;
+            }
+            turbo.tempo = t;
+        } else {
+            int i = platz_finden(w);
+            if (i >= 0) {
+                i += CODE_BITS;
+            } else {
+                for (int k = 0; k < 20; k++) {
+                    if (CODE_NAME[k] && !strcmp(w, CODE_NAME[k])) {
+                        i = k;
+                    }
+                }
+            }
+            int mo = !strcmp(x, "aus") ? 0 : !strcmp(x, "halten") ? 1 : !strcmp(x, "auto") ? 2 : -1;
+            if (i < 0 || mo < 0) {
+                c2_log("fehler: turbo <taste|rueck1|rueck2|m> <aus|halten|auto>\r\n");
+                return 1;
+            }
+            turbo.modus[i] = mo;
+            auto_an &= ~BIT(i);
+        }
+        merken(BIT(3));
+        turbo_melden();
+        c2_log("ok: turbo\r\n");
+        return 1;
+    }
+    return 0;
+}
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_belegung.h b/apps/hid/modules/c2lite/c2_belegung.h
new file mode 100644
index 0000000..bad24a6
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_belegung.h
@@ -0,0 +1,30 @@
+#ifndef C2_BELEGUNG_H
+#define C2_BELEGUNG_H
+/* C2 Lite: Rücktasten, M-Taste, Turbo und Makros wie die Werks-Firmware (c2_belegung.c) */
+
+/* Rollen-Bits wie enum rolle in c2_eingaben.c (dort per Compile-Prüfung abgeglichen) */
+#define C2_BELEG_ROLLE_M 16      /* M-Taste („Moba“, PC0) */
+#define C2_BELEG_ROLLE_LICHT 17  /* Licht-Taste (PA12) = Funktionstaste wie im Original */
+#define C2_BELEG_ROLLE_RUECK1 18 /* Rücktaste 1 (PC2) */
+#define C2_BELEG_ROLLE_RUECK2 19 /* Rücktaste 2 (PC1) */
+#define C2_BELEG_ROLLE_HOCH 32   /* Steuerkreuz hoch, rechts, runter, links = 32..35 */
+
+/* Alle 10 ms aus der Tastenabfrage: r = gedrückte Rollen (roh), achsen = LX, LY, RX, RY 0..1023 („hoch“ = klein),
+ * werden für Makros und während der Funktionstaste angepasst. Liefert die Rollen, die gesendet werden. */
+u64 c2_belegung_takt(u64 r, u16 achsen[4]);
+void c2_belegung_init(void);
+/* Logo-Farbe während Aufnahme und nach Bedienschritten: 1 = rgb gesetzt */
+int c2_belegung_logo(u8 rgb[3]);
+/* Zusätzliche Spieler-LED (Bit wie led_maske): blinkt bei Turbo und laufendem Makro wie im Original */
+u8 c2_belegung_led(void);
+/* Textbefehle „belegung …“ und „turbo …“; 1 = war einer davon */
+int c2_belegung_befehl(const char *b);
+
+/* Aus c2_eingaben.c */
+void c2_licht_weiter(void);           /* nächster Lichtmodus */
+void c2_licht_hell_schritt(int d);    /* Helligkeit ±d % */
+u8 c2_vibration_schritt(int d);       /* Vibrationsstärke ±d %, liefert den neuen Wert */
+void c2_einstellungen_sichern(void);
+void c2_motor_setzen(u8 links, u8 rechts, u16 dauer_ms);
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_eingaben.c b/apps/hid/modules/c2lite/c2_eingaben.c
new file mode 100644
index 0000000..fed2dca
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_eingaben.c
@@ -0,0 +1,904 @@
+/* C2 Lite: Eingaben lesen, als HID-Gamepad über USB senden und über das USB-Protokoll (c2_log) melden.
+ * Keine LED, kein Motor, kein Laden (kommt in späteren Stufen).
+ * Pin-Karte und Abfrage-Ablauf aus der Werks-Firmware, am Gerät bestätigt:
+ *   PA7 = gemeinsame LED-Leitung (hier dauerhaft low = LEDs aus), PA8 = gemeinsame Tastenleitung.
+ *   Phase A: PA8 high, Pins mit Pull-down lesen, gedrückt = high.
+ *   Phase B: PA8 low, Pins mit Pull-up lesen, gedrückt = low.
+ *   ZL PA10, ZR PB3: Pull-up, gedrückt = low.  Sticks: ADC PA5/PA6 (links), PB10/PB8 (rechts).  Akku: ADC PB4.
+ *   USB-5V: PB5 (Pull-down).  PB11: Versorgung (Sticks, Plus), wie die Werks-Firmware Ausgang high mit High-Drive.
+ *   L/R an PR1/PR0 (Port R im Always-on-Bereich), nur über die rtc_port_pr_*-Funktionen erreichbar. */
+#include "app_config.h"
+#include "system/includes.h"
+#include "asm/gpio.h"
+#include "asm/adc_api.h"
+#include "asm/rtc.h"
+#include "c2_log.h"
+#include "asm/mcpwm.h"
+#include "c2_anzeige.h"
+#include "c2_switch.h"
+#include "c2_belegung.h"
+#include "asm/usb.h"
+
+#ifdef CONFIG_BOARD_C2LITE
+
+#define TAKT_MS 10
+
+/* Rollen; Gamepad-Taste n (1..20) = Bit n-1 im Report, Reihenfolge siehe Report-Deskriptor in hid.c */
+enum rolle {
+    T_B = 0,       /* 1  unten  -> BTN_SOUTH */
+    T_A = 1,       /* 2  rechts -> BTN_EAST */
+    T_X = 3,       /* 4  oben   -> BTN_NORTH */
+    T_Y = 4,       /* 5  links  -> BTN_WEST */
+    T_L = 6,
+    T_R = 7,
+    T_ZL = 8,
+    T_ZR = 9,
+    T_MINUS = 10,
+    T_PLUS = 11,
+    T_HOME = 12,
+    T_L3 = 13,
+    T_R3 = 14,
+    T_KAMERA = 15,
+    T_MOBA = 16,
+    T_LICHT = 17,
+    T_RUECK1 = 18, /* Rücktaste an PC2 */
+    T_RUECK2 = 19, /* Rücktaste an PC1 */
+    K_HOCH = 32,   /* Steuerkreuz -> Hat-Switch */
+    K_RECHTS,
+    K_RUNTER,
+    K_LINKS,
+    S_PC3,         /* Modus-Schieber, nur Protokoll */
+    S_PA3,
+    ROLLEN
+};
+
+/* Muss zu c2_switch.h passen */
+_Static_assert(T_B == C2_ROLLE_B && T_A == C2_ROLLE_A && T_X == C2_ROLLE_X && T_Y == C2_ROLLE_Y && T_L == C2_ROLLE_L &&
+               T_R == C2_ROLLE_R && T_ZL == C2_ROLLE_ZL && T_ZR == C2_ROLLE_ZR && T_MINUS == C2_ROLLE_MINUS &&
+               T_PLUS == C2_ROLLE_PLUS && T_HOME == C2_ROLLE_HOME && T_L3 == C2_ROLLE_L3 && T_R3 == C2_ROLLE_R3 &&
+               T_KAMERA == C2_ROLLE_KAMERA && K_HOCH == C2_ROLLE_HOCH && K_RECHTS == C2_ROLLE_RECHTS &&
+               K_RUNTER == C2_ROLLE_RUNTER && K_LINKS == C2_ROLLE_LINKS, "Rollen c2_switch.h");
+_Static_assert(T_MOBA == C2_BELEG_ROLLE_M && T_LICHT == C2_BELEG_ROLLE_LICHT && T_RUECK1 == C2_BELEG_ROLLE_RUECK1 &&
+               T_RUECK2 == C2_BELEG_ROLLE_RUECK2 && K_HOCH == C2_BELEG_ROLLE_HOCH && K_LINKS == K_HOCH + 3 &&
+               T_KAMERA == 15, "Rollen c2_belegung.h");
+
+struct taste {
+    u32 pin;
+    u8 rolle;
+    const char *name;
+};
+
+/* Phase A (PA8 high, Pull-down, gedrückt = high) */
+static const struct taste PHASE_A[] = {
+    {IO_PORTC_04, T_R3, "R3"},          {IO_PORTC_05, T_L3, "L3"},        {IO_PORTC_00, T_MOBA, "Moba"},
+    {IO_PORTC_02, T_RUECK1, "Rueck1"},  {IO_PORTC_01, T_RUECK2, "Rueck2"}, {IO_PORTC_03, S_PC3, "Schieber PC3"},
+    {IO_PORTA_03, S_PA3, "Schieber PA3"}, {IO_PORTA_12, T_LICHT, "Licht"},
+};
+
+/* Phase B (PA8 low, Pull-up, gedrückt = low) */
+static const struct taste PHASE_B[] = {
+    {IO_PORT_PR_01, T_L, "L"},          {IO_PORT_PR_00, T_R, "R"},       {IO_PORTB_06, T_MINUS, "Minus"},
+    {IO_PORTC_04, T_X, "X"},            {IO_PORTC_03, T_Y, "Y"},         {IO_PORTA_02, T_KAMERA, "Kamera"},
+    {IO_PORTB_01, T_HOME, "Home"},      {IO_PORTA_03, T_A, "A"},         {IO_PORTC_05, T_B, "B"},
+    {IO_PORTC_01, K_LINKS, "links"},    {IO_PORTA_12, K_RUNTER, "runter"}, {IO_PORTC_02, K_HOCH, "hoch"},
+    {IO_PORTC_00, K_RECHTS, "rechts"},  {IO_PORTB_07, T_PLUS, "Plus"},
+};
+
+/* Direkt gegen Masse */
+static const struct taste DIREKT[] = {
+    {IO_PORTA_10, T_ZL, "ZL"}, {IO_PORTB_03, T_ZR, "ZR"},
+};
+
+/* Sticks: Reihenfolge = Report-Achsen X, Y, Z, Rz (am Gerät geprüft: hoch = min, links = min; PB10 läuft verkehrt) */
+static const struct {
+    u32 pin, kanal;
+    const char *name;
+} ANALOG[] = {
+    {IO_PORTA_05, AD_CH_PA5, "LX PA5"}, {IO_PORTA_06, AD_CH_PA6, "LY PA6"},
+    {IO_PORTB_10, AD_CH_PB10, "RX PB10"}, {IO_PORTB_08, AD_CH_PB8, "RY PB8"},
+    {IO_PORTB_04, AD_CH_PB4, "Akku PB4"},
+};
+#define N_ANALOG (sizeof(ANALOG) / sizeof(ANALOG[0]))
+#define N_STICK 4
+#define STICK_HUB 330  /* gemessener Ausschlag je Richtung (ca. 160..830 um ~490) */
+/* Einstellungen, dauerhaft im VM (ID 29, in user_cfg_id.h frei). Version zuerst: ändert sich das Format, gelten
+ * die Vorgaben. */
+#define CFG_C2_EINSTELLUNGEN 29
+#define EINSTELLUNGEN_VERSION 3
+static struct {
+    u8 version;
+    u8 anzeige;         /* 1 = Zustandsanzeige über die Spieler-LEDs (c2_anzeige.c), 0 = LEDs aus */
+    u8 vibration;       /* 0..100 %: Skalierung der Vibration, die der PC anfordert */
+    u8 totzone;         /* Stick-Totzone in Rohwert-Schritten (0..100) */
+    struct c2_licht licht;
+    u8 reserve[5];
+} einst = {EINSTELLUNGEN_VERSION, 1, 100, 12,
+           /* Regenbogen-Lauf wie die Werks-FW, aber heller (Werk: Streifen 5 %, Status 30 %) */
+           {C2_LICHT_REGENBOGEN, 15, 25, 30, {255, 255, 255}}};
+static u8 rgb_manuell; /* „rgb …“-Befehl aktiv: Effekte pausieren, bis „licht“ oder „rgb auto“ */
+static u32 letzte_eingabe; /* Runde der letzten Tasten- oder Stickeingabe */
+
+/* Ein/Aus wie die Werks-Firmware: Schieber in keiner Stellung (weder PC3 noch PA3) und kein USB -> Soft-Off.
+ * Am USB bleibt er an (Laden). Wecken: Schieber auf eine Stellung (PA8 high, PA3/PC3 steigende Flanke), Home
+ * (fallende Flanke) oder USB einstecken (charge_wkup in board_c2lite.c). Weck-Pins erst kurz vor dem Ausschalten
+ * setzen: im Betrieb wechseln PA3/PC3 durch die Tastenabfrage ständig den Pegel. */
+#define AUS_NACH_MS 1500
+static const struct port_wakeup weck_pa3 = {ENABLE, RISING_EDGE, BLUETOOTH_RESUME, IO_PORTA_03, ENABLE};
+static const struct port_wakeup weck_pc3 = {ENABLE, RISING_EDGE, BLUETOOTH_RESUME, IO_PORTC_03, ENABLE};
+static const struct port_wakeup weck_home = {ENABLE, FALLING_EDGE, BLUETOOTH_RESUME, IO_PORTB_01, ENABLE};
+/* USB-5V an PB5 (Pull-down): Einstecken weckt. Der Lade-Weckeingang des Chips (charge_wkup) reagiert beim C2 Lite
+ * nicht (am Gerät geprüft) - die USB-Spannung geht über den externen Lade-IC, nicht an VPWR. */
+static const struct port_wakeup weck_usb5v = {ENABLE, RISING_EDGE, BLUETOOTH_RESUME, IO_PORTB_05, ENABLE};
+static const struct charge_wakeup weck_usb = {BLUETOOTH_RESUME};
+static const struct wakeup_param aus_wk = {
+    .port = {[1] = &weck_home, [2] = &weck_pa3, [3] = &weck_pc3, [4] = &weck_usb5v},
+    .charge = &weck_usb,
+};
+void c2_rgb_alle(u8 r, u8 g, u8 b);
+void c2_rgb_senden(void);
+u16 c2_ota_promille(void);
+static void eingang(u32 pin, int pull_up, int pull_down);
+static u8 motor_bereit;
+
+static void ausschalten(const char *grund)
+{
+    c2_log("Aus: %s -> Soft-Off\r\n", grund);
+    /* Licht und Motoren aus: schwarzer RGB-Frame (PA7/PA8 low), Spieler-LEDs aus, Motoren aus */
+    rgb_manuell = 1;
+    c2_rgb_alle(0, 0, 0);
+    gpio_direction_output(IO_PORTA_07, 0);
+    gpio_direction_output(IO_PORTA_08, 0);
+    c2_rgb_senden();
+    if (motor_bereit) {
+        mcpwm_set_duty(pwm_ch4, pwm_timer4, 0);
+        mcpwm_set_duty(pwm_ch1, pwm_timer1, 0);
+    }
+    /* Weck-Pins vorbereiten */
+    gpio_direction_output(IO_PORTA_08, 1);
+    eingang(IO_PORTA_03, 0, 1);
+    eingang(IO_PORTC_03, 0, 1);
+    eingang(IO_PORTB_01, 1, 0);
+    eingang(IO_PORTB_05, 0, 1);
+    os_time_dly(20); /* Protokollzeile noch rausschicken */
+    power_wakeup_init(&aus_wk);
+    power_set_soft_poweroff();
+}
+
+/* Sprung in den ROM-Download-Modus (Home + Minus oder Befehl „download-modus“). Vorher alle RGB-LEDs rot: Die LEDs
+ * (WS2812-artig) halten ihre letzte Farbe, also sieht man den Download-Modus, obwohl im ROM keine Firmware läuft.
+ * Motoren aus, Watchdog aus (er überlebt den Sprung im P33 und beendete den Download-Modus sonst nach ~4 s). */
+void go_mask_usb_updata(void);
+
+void c2_download_springen(void)
+{
+    os_time_dly(5); /* Protokollzeile noch rausschicken */
+    rgb_manuell = 1;
+    c2_rgb_alle(160, 0, 0);
+    gpio_direction_output(IO_PORTA_07, 0);
+    gpio_direction_output(IO_PORTA_08, 0);
+    c2_rgb_senden();
+    if (motor_bereit) {
+        mcpwm_set_duty(pwm_ch4, pwm_timer4, 0);
+        mcpwm_set_duty(pwm_ch1, pwm_timer1, 0);
+    }
+    wdt_close();
+    go_mask_usb_updata();
+}
+
+static void schieber_pruefen(u64 r)
+{
+    /* Stellung gewechselt (PA3 = Switch, PC3 = PC): neu starten, damit sich USB passend anmeldet */
+    static u32 wechsel_seit;
+    int pa3 = !!(r & (1ULL << S_PA3)), pc3 = !!(r & (1ULL << S_PC3));
+    if ((pa3 || pc3) && pa3 != c2_switch_modus()) {
+        if (++wechsel_seit == 300 / TAKT_MS) {
+            c2_log("Schieber: Moduswechsel %s -> Neustart\r\n", pa3 ? "Switch" : "PC");
+            os_time_dly(5);
+            p33_soft_reset();
+        }
+    } else {
+        wechsel_seit = 0;
+    }
+    static u32 aus_seit;
+    int aus = !(r & ((1ULL << S_PC3) | (1ULL << S_PA3))) && !gpio_read(IO_PORTB_05);
+    if (!aus) {
+        aus_seit = 0;
+        return;
+    }
+    if (++aus_seit >= AUS_NACH_MS / TAKT_MS) {
+        ausschalten("Schieber auf Aus, kein USB");
+    }
+}
+static int c2_einstellung_speichern(void);
+
+/* Licht-Taste: Bedienung in c2_belegung.c (Funktionstaste wie die Werks-FW, kurz = nächster Lichtmodus) */
+void c2_licht_weiter(void)
+{
+    static const u8 FOLGE[] = {C2_LICHT_REGENBOGEN, C2_LICHT_FARBWECHSEL, C2_LICHT_ATMEN, C2_LICHT_STATISCH,
+                               C2_LICHT_REAKTIV, C2_LICHT_AUS};
+    int i = 0;
+    while (i < (int)sizeof(FOLGE) && FOLGE[i] != einst.licht.modus) {
+        i++;
+    }
+    einst.licht.modus = FOLGE[(i + 1) % sizeof(FOLGE)];
+    rgb_manuell = 0;
+    c2_log("Licht: Modus %u\r\n", einst.licht.modus);
+}
+
+void c2_licht_hell_schritt(int d)
+{
+    int h = einst.licht.hell + d;
+    einst.licht.hell = h < 0 ? 0 : h > 100 ? 100 : h;
+    c2_log("Licht: Helligkeit %u %%\r\n", einst.licht.hell);
+}
+
+u8 c2_vibration_schritt(int d)
+{
