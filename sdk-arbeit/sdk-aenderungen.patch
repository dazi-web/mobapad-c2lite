+static void leds_ausgeben(void)
+{
+    if (!led_maske) {
+        return; /* PA7 bleibt low, Pins bleiben Eingänge */
+    }
+    for (int i = 0; i < 7; i++) {
+        gpio_direction_output(LED_PIN[i], !(led_maske & BIT(i)));
+    }
+    gpio_direction_output(IO_PORTA_07, 1);
+}
+
+/* Vibration: Motoren wie die Werks-Firmware (0x983C..0x9886): 30 kHz, links Kanal 4/Timer 4 an PA9 (H-Pin),
+ * rechts Kanal 1/Timer 1 an PB2 (L-Pin), nicht komplementär, Start mit Duty 0 = aus. Zur Sicherheit erst beim
+ * ersten Befehl einschalten und nach einer festen Zeit selbst wieder aus. */
+static u8 motor_bereit;
+static u16 motor_rest_ms;
+static u16 stoss_rest_ms; /* Rückmeldestoß läuft: Aus-Befehle (z. B. leere Vibration der Switch) warten */
+
+static void motor_init(void)
+{
+    struct pwm_platform_data p = {0};
+    p.frequency = 30000;
+    p.pwm_aligned_mode = pwm_edge_aligned;
+    p.pwm_ch_num = pwm_ch4;
+    p.pwm_timer_num = pwm_timer4;
+    p.h_pin = IO_PORTA_09;
+    p.l_pin = (u8)-1;
+    mcpwm_init(&p);
+    p.pwm_ch_num = pwm_ch1;
+    p.pwm_timer_num = pwm_timer1;
+    p.h_pin = (u8)-1;
+    p.l_pin = IO_PORTB_02;
+    mcpwm_init(&p);
+    motor_bereit = 1;
+}
+
+/* Stärke 0..100 % je Motor, dauer_ms bis zum automatischen Aus (höchstens 5 s) */
+void c2_rgb_senden(void);
+void c2_rgb_init(void);
+
+void c2_motor_setzen(u8 links, u8 rechts, u16 dauer_ms)
+{
+    if (!motor_bereit) {
+        motor_init();
+    }
+    if (stoss_rest_ms && !links && !rechts) {
+        return;
+    }
+    links = links > 100 ? 100 : links;
+    rechts = rechts > 100 ? 100 : rechts;
+    mcpwm_set_duty(pwm_ch4, pwm_timer4, links * 100);
+    mcpwm_set_duty(pwm_ch1, pwm_timer1, rechts * 100);
+    motor_rest_ms = (links || rechts) ? (dauer_ms > 5000 ? 5000 : dauer_ms) : 0;
+}
+
+/* Fehlersuche: Motor-Pins ohne PWM fest setzen (PA9 links, PB2 rechts); „motor“ richtet die PWM danach neu ein */
+void c2_motor_pins(u8 links, u8 rechts)
+{
+    if (motor_bereit) {
+        mcpwm_ch_open_or_close(pwm_ch4, 0);
+        mcpwm_ch_open_or_close(pwm_ch1, 0);
+        motor_bereit = 0;
+    }
+    gpio_set_die(IO_PORTA_09, 1);
+    gpio_set_die(IO_PORTB_02, 1);
+    gpio_direction_output(IO_PORTA_09, links);
+    gpio_direction_output(IO_PORTB_02, rechts);
+    c2_log("ok: motor pin PA9=%u PB2=%u (gelesen %d %d)\r\n", links, rechts, gpio_read(IO_PORTA_09), gpio_read(IO_PORTB_02));
+}
