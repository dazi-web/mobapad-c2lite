+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_rgb.c b/apps/hid/modules/c2lite/c2_rgb.c
new file mode 100644
index 0000000..ff1f7fc
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_rgb.c
@@ -0,0 +1,183 @@
+/* C2 Lite: adressierbare RGB-LEDs (WS2812-Art), wie die Werks-Firmware per Bit-Bang mit gesperrten Interrupts:
+ *   Kette A an PA7 (= Sammelleitung der Spieler-LEDs): LED 0 = Logo oben, LED 1..7 = Streifen unten, alle R,G,B
+ *   Kette B an PA8 (= Tastenleitung): 2 LEDs an den Seiten, G,R,B   (Zuordnung und Reihenfolge am Gerät geprüft)
+ * Werks-FW: Byte-Senden 0x4FE62 (PA7) / 0x50606 (PA8), Ablauf 0x16922..0x16BC6 in der Tastenabfrage.
+ * Pulslängen: die Werks-FW nutzt eine Warteschleife mit festen Zählern (bei ihrem Takt); hier wird die Schleife beim
+ * Start gegen timer_get_ms() gemessen und die Zähler für ca. 0,35 µs (0-Bit) und 0,8 µs (1-Bit) daraus berechnet. */
+#include "app_config.h"
+#include "system/includes.h"
+#include "asm/gpio.h"
+#include "c2_log.h"
+
+#ifdef CONFIG_BOARD_C2LITE
+
+#define KETTE_A 8
+#define KETTE_B 2
+static u8 rohe_a[KETTE_A * 3], rohe_b[KETTE_B * 3]; /* Bytes in Senderreihenfolge */
+static u32 n_kurz = 1, n_lang = 4, n_pause = 4;     /* Schleifenzähler, nach Kalibrierung */
+static u32 n_ruhe = 20000;                          /* Reset vor dem Frame: Leitung > 300 µs low */
+static u32 ns_je_durchlauf, ns_aufruf;              /* Messwerte der Kalibrierung */
+static u8 rgb_an;                                    /* erst nach „rgb …“-Befehl senden */
+static u8 rgb_kaputt;                                /* Kalibrierung unplausibel: nie senden */
+
+u32 timer_get_ms(void);
+
+AT(.volatile_ram_code)
+static void __attribute__((noinline)) warte(u32 n)
+{
+    while (n--) {
+        __asm__ volatile("nop");
+    }
+}
+
+/* Pulslängen in Schleifendurchläufen der Inline-Warteschleife (gemessen ~176 ns je Durchlauf bei 48 MHz,
+ * Interrupts aus). Vorgabe: 0-Bit 1 high / 5 low, 1-Bit 4 high / 2 low. Per „rgb zeit“ verstellbar. */
+static volatile u32 z0h = 1, z0l = 5, z1h = 4, z1l = 2;
+
+#define SCHLEIFE(n)                                                                                                    \
+    do {                                                                                                               \
+        for (u32 _k = (n); _k; _k--) {                                                                                 \
+            __asm__ volatile("nop");                                                                                   \
+        }                                                                                                              \
+    } while (0)
+
+/* Ein Byte, höchstes Bit zuerst. Ausgaberegister mit vorberechneten Werten beschreiben (Interrupts sind aus, sonst
+ * ändert niemand Port A) */
+AT(.volatile_ram_code)
+static void byte_senden(u32 bit, u8 b)
+{
+    u32 lo = JL_PORTA->OUT & ~bit, hi = lo | bit;
+    u32 h0 = z0h, l0 = z0l, h1 = z1h, l1 = z1l;
+    for (int i = 0; i < 8; i++) {
+        if (b & 0x80) {
+            JL_PORTA->OUT = hi;
+            SCHLEIFE(h1);
+            JL_PORTA->OUT = lo;
+            SCHLEIFE(l1);
+        } else {
+            JL_PORTA->OUT = hi;
+            SCHLEIFE(h0);
+            JL_PORTA->OUT = lo;
+            SCHLEIFE(l0);
+        }
+        b <<= 1;
+    }
+}
+
+void c2_rgb_zeit(u32 a, u32 b, u32 c, u32 d)
+{
+    z0h = a, z0l = b, z1h = c, z1l = d;
+    c2_log("ok: rgb zeit 0-Bit %lu/%lu 1-Bit %lu/%lu\r\n", a, b, c, d);
+}
+
+/* Misst die Dauer eines Schleifendurchlaufs und eines Aufrufs (beim Start, Interrupts an). In kurzen Stücken mit
+ * Watchdog-Bedienung, bis mindestens 200 ms vergangen sind: eine lange Schleife am Stück hat in Stufe 2w den Watchdog
+ * (4 s) ausgelöst. */
+void clr_wdt(void);
+static u32 messen_ns(u32 stueck, int als_aufrufe)
+{
+    u32 t0 = timer_get_ms();
+    while (timer_get_ms() == t0) {
+    }
+    t0 = timer_get_ms();
+    u32 runden = 0, dauer;
+    do {
+        if (als_aufrufe) {
+            for (u32 i = 0; i < stueck; i++) {
+                warte(1);
+            }
+        } else {
+            warte(stueck);
+        }
+        runden++;
+        clr_wdt();
+        dauer = timer_get_ms() - t0;
+    } while (dauer < 200 && runden < 100000);
+    return (u32)((u64)dauer * 1000000 / ((u64)runden * stueck));
+}
+
+void c2_rgb_init(void)
+{
+    gpio_set_hd(IO_PORTA_07, 1);
+    ns_je_durchlauf = messen_ns(20000, 0);
+    ns_aufruf = 0;
+    /* Ziel: 0-Bit high 350 ns, 1-Bit high 800 ns, Rest der Periode (1,25 µs) low */
+    u32 je = ns_je_durchlauf ? ns_je_durchlauf : 1;
+    u32 grund = ns_aufruf > je ? ns_aufruf - je : 0; /* Aufruf ohne Schleife */
+    n_kurz = 350 > grund ? (350 - grund) / je : 0;
+    n_lang = 800 > grund ? (800 - grund) / je : 0;
+    n_pause = 900 > grund ? (900 - grund) / je : 0;
+    n_ruhe = 300000 / je + 1;
+    rgb_kaputt = 0; /* Messung mit Interrupts ist zu ungenau (Laptop-Messung: ~176 ns je Durchlauf); nur Anzeige */
+    n_ruhe = 2000; /* ~350 µs bei ~176 ns je Durchlauf */
+    c2_log("RGB: Schleife %lu ns, Aufruf %lu ns -> Zaehler kurz %lu lang %lu pause %lu\r\n", ns_je_durchlauf, ns_aufruf,
+           n_kurz, n_lang, n_pause);
+}
+
+/* Laptop misst die Zeit bis zur Antwort: n Schleifendurchläufe mit gesperrten Interrupts (höchstens 3 Mio.) */
+void c2_rgb_messen(u32 n)
+{
+    n = n > 3000000 ? 3000000 : n;
+    local_irq_disable();
+    warte(n);
+    local_irq_enable();
+    c2_log("ok: rgb messen %lu\r\n", n);
+}
+
+void c2_rgb_kalibrierung_melden(void)
+{
+    c2_log("rgb: schleife=%luns aufruf=%luns kurz=%lu lang=%lu pause=%lu ruhe=%lu %s takt=%luHz\r\n", ns_je_durchlauf, ns_aufruf,
+           n_kurz, n_lang, n_pause, n_ruhe, rgb_kaputt ? "unplausibel" : "ok", clk_get("sys"));
+}
+
+/* kette 0 = A (PA7), 1 = B (PA8); led wie oben; Farbe in R,G,B */
+void c2_rgb_setzen(int kette, int led, u8 r, u8 g, u8 b)
+{
+    u8 *p;
+    int grb;
+    if (kette == 0 && led >= 0 && led < KETTE_A) {
+        p = rohe_a + led * 3;
+        grb = 0; /* am Gerät geprüft: Logo (LED 0) und Streifen (1..7) erwarten R,G,B */
+    } else if (kette == 1 && led >= 0 && led < KETTE_B) {
+        p = rohe_b + led * 3;
+        grb = 1;
+    } else {
+        return;
+    }
+    rgb_an = 1;
+    if (grb) {
+        p[0] = g, p[1] = r, p[2] = b;
+    } else {
+        p[0] = r, p[1] = g, p[2] = b;
+    }
+}
+
+void c2_rgb_alle(u8 r, u8 g, u8 b)
+{
+    for (int i = 0; i < KETTE_A; i++) {
+        c2_rgb_setzen(0, i, r, g, b);
+    }
+    for (int i = 0; i < KETTE_B; i++) {
+        c2_rgb_setzen(1, i, r, g, b);
+    }
+}
+
+/* Aus der Tastenabfrage: PA7 und PA8 sind low (Ruhe > 50 µs vor dem Aufruf), danach bleiben sie low */
+AT(.volatile_ram_code)
+void c2_rgb_senden(void)
+{
+    if (!rgb_an || rgb_kaputt) {
+        return;
+    }
+    warte(n_ruhe); /* Interrupts noch an; PA7/PA8 sind schon low */
+    local_irq_disable();
+    for (int i = 0; i < KETTE_A * 3; i++) {
+        byte_senden(BIT(7), rohe_a[i]);
+    }
+    for (int i = 0; i < KETTE_B * 3; i++) {
+        byte_senden(BIT(8), rohe_b[i]);
+    }
+    local_irq_enable();
+}
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_switch.c b/apps/hid/modules/c2lite/c2_switch.c
new file mode 100644
index 0000000..c203b93
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_switch.c
@@ -0,0 +1,778 @@
+/* C2 Lite: Switch-Modus als „Pro Controller“ über USB (057E:2009) und klassisches Bluetooth, für Switch 1 und 2.
+ * Protokoll nach der öffentlichen Doku (github.com/dekuNukem/Nintendo_Switch_Reverse_Engineering), Gegenprobe
+ * mit der Werks-Firmware (Analyse 30.10.: USB-OUT 0x1B66C, Unterbefehle 0xF004, SPI-Werte 0xF21A).
+ *   OUT 0x80 xx: USB-Befehle (01 Status/MAC, 02 Handshake, 03 Baudrate, 04 nur noch USB-HID, 05 zurück)
+ *   OUT 0x01:    Vibration + Unterbefehl, Antwort IN 0x21
+ *   OUT 0x10:    nur Vibration
+ *   IN  0x30:    Eingaben, regelmäßig nach 80 04
+ * Über Bluetooth (EDR-HID, SDP in lib_profile_config.c) gibt es keine 0x80-Befehle: die Konsole schickt 0x01/0x10 als
+ * Ausgabe-Report (A2 ..), wir senden 0x21/0x30 mit 49 Byte (A1 ..). Wie die Werks-FW (0x10D04): der erste 0x30-Report
+ * 200 ms nach dem HID-Connect, danach etwa alle 15 ms mit höchstens einem Paket unterwegs.
+ * Der Schieber in Stellung PA3 wählt den Modus beim Start (Werks-FW: PA3 = Switch). */
+#include "app_config.h"
+#include "system/includes.h"
+#include "asm/gpio.h"
+#include "c2_log.h"
+#include "c2_switch.h"
+#include "generic/jiffies.h"
+
+#ifdef CONFIG_BOARD_C2LITE
+
+#include "usb/device/custom_hid.h" /* custom_hid_tx_data */
+#include "btstack/avctp_user.h"   /* user_send_cmd_prepare */
+void put_link_key(u8 *bd_addr, u8 *link_key, u8 id); /* Bibliothek (btstack.a), Signatur aus dem Maschinencode */
+u8 get_remote_dev_info_index(void);
+u8 connect_last_device_from_vm(void);
+void lmp_hci_create_connection(const u8 *addr, u16 packet_type, u8 repetition_mode, u8 reserved, u16 clk_offset,
+                               u8 allow_role_switch);
+void lmp_hci_authentication_requested(u16 handler);
+const u8 *bt_get_mac_addr(void);
+int edr_hid_is_connected(void);
+int c2_edr_senden(const u8 *report, u16 len);
+void c2_motor_setzen(u8 links, u8 rechts, u16 dauer_ms);
+u8 c2_vibration_staerke(void);
+
+static s8 modus = -1;        /* -1 = noch nicht gelesen, 0 = PC, 1 = Switch */
+static u8 voll;              /* nach 80 04: 0x30-Reports regelmäßig senden */
+static u8 zeit;              /* Zeitzähler im Report */
+static u8 spieler;           /* Spieler-LEDs, vom Unterbefehl 0x30 (Bit 0 = Spieler 1) */
+/* Empfangspuffer für 8 Pakete: die Konsole schickt Vibration und Unterbefehle schnell hintereinander */
+#define RX_PLAETZE 8
+static u8 rx_ring[RX_PLAETZE][64];
+static u8 rx_bt[RX_PLAETZE];  /* 1 = Paket kam über Bluetooth */
+static volatile u8 rx_schreib, rx_lies;
+static u32 rx_anzahl, rx_verloren, vib_anzahl;
+static u8 vib_letzt[8], vib_st[2];
+static u8 tx[64], tx_len;    /* Antwort, die noch gesendet werden muss */
+static u8 tx_bt;             /* Antwort geht über Bluetooth zurück */
+static u32 bt_rx, bt_tx, bt_voll; /* Zähler für „switch diag“ */
+static u8 bt_takt;           /* ms seit dem letzten 0x30 über Bluetooth */
+static u8 bt_war;            /* Verbindung stand in der letzten Runde */
+/* Kopplung über USB (Unterbefehl 0x01): Adresse der Konsole und unser Schlüssel, beide in Leitungsreihenfolge (LE) */
+static u8 konsole[6], schluessel[16];
+static u32 ms;               /* Zeit im Switch-Modus, 10-ms-Schritte des Takts */
+static u32 verbinden_ab;     /* frühestens dann der nächste Verbindungsversuch */
+static u8 versuche;          /* Verbindungsversuche seit dem Abziehen bzw. dem letzten Tastendruck */
+static u8 alt_usb;
+u8 c2_switch_verschluesselt; /* app_comm_edr.c: BT_STATUS_ENCRY_COMPLETE */
+static u32 angerufen;        /* ms, als wir zuletzt die Konsole angerufen haben (0 = nie) */
+static u8 tx_versuche;       /* Takte, die die aktuelle Antwort schon wartet */
+int custom_hid_get_ready(const usb_dev usb_id);
+static u8 bt_warte;          /* 10-ms-Schritte bis zum ersten Report nach dem HID-Connect */
+static u8 spi_6000[0x100];   /* nachgebildeter SPI-Flash 0x6000..0x60FF */
+
+/* Schieber in Stellung PA3? Tastenleitung PA8 high, PA3 mit Pull-down lesen (wie die Phase A der Abfrage) */
+int c2_switch_modus(void)
+{
+    if (modus < 0) {
+        gpio_set_hd(IO_PORTA_08, 1);
+        gpio_direction_output(IO_PORTA_08, 1);
+        gpio_set_direction(IO_PORTA_03, 1);
+        gpio_set_die(IO_PORTA_03, 1);
+        gpio_set_pull_up(IO_PORTA_03, 0);
+        gpio_set_pull_down(IO_PORTA_03, 1);
+        for (volatile int w = 0; w < 2000; w++) {
+        }
+        modus = !!gpio_read(IO_PORTA_03);
+        gpio_direction_output(IO_PORTA_08, 0);
+    }
+    return modus;
+}
+
+u8 c2_switch_spieler(void)
+{
+    return spieler;
+}
+
+/* Paket merken, ausgewertet wird im Takt */
+static void merken(const u8 *buf, u32 len, u8 bt)
+{
+    if (!len) {
+        return;
+    }
+    rx_anzahl++;
+    if ((u8)(rx_schreib - rx_lies) >= RX_PLAETZE) {
+        rx_verloren++;
+        return;
+    }
+    u8 *z = rx_ring[rx_schreib % RX_PLAETZE];
+    memset(z, 0, 64);
+    memcpy(z, buf, len > 64 ? 64 : len);
+    rx_bt[rx_schreib % RX_PLAETZE] = bt;
+    rx_schreib++;
+}
+
+/* Interrupt (custom_hid.c) */
+void c2_switch_usb_empfang(void *priv, u8 *buf, u32 len)
+{
+    merken(buf, len, 0);
+}
+
+/* Bluetooth-Stack: Daten vom Interrupt-Kanal, mit oder ohne Kopfbyte A2 (DATA | Output) */
+void c2_switch_bt_empfang(u8 *packet, u16 size, u16 channel)
+{
+    bt_rx++;
+    if (size && packet[0] == 0xA2) {
+        packet++, size--;
+    }
+    merken(packet, size, 1);
+}
+
+/* Letzte Bluetooth-Ereignisse für „switch diag“ (app_comm_edr.c): Art h = HCI-Ereignis, s = Stack-Status */
+#define ERSTE 16
+#define LETZTE 64
+struct ereignis {
+    u8 art, ev, wert, rx; /* rx: Pakete von der Konsole bis dahin (bis 255) */
+    u16 zeit;             /* in 10 ms */
+};
+static struct ereignis erste[ERSTE], letzte[LETZTE];
+static u16 ereignis_n;
+void c2_switch_bt_ereignis(u8 art, u8 ev, u8 wert)
+{
+    struct ereignis e = {art, ev, wert, bt_rx > 255 ? 255 : bt_rx, jiffies};
+    if (art == 'h' && ev == 0x31) {
+        extern void c2_mitschnitt_start(void);
+        c2_mitschnitt_start(); /* Kopplung beginnt: ab hier SDK-Meldungen mitschneiden */
+    }
+    if (ereignis_n < ERSTE) {
+        erste[ereignis_n] = e;
+    }
+    letzte[ereignis_n % LETZTE] = e;
+    ereignis_n++;
+}
+
+/* Gegenstelle der letzten Verbindungs-Ereignisse (Leitungsreihenfolge LE): 0 = Start, 1 = verbunden, 2 = getrennt */
+static u8 gegenstelle[3][6];
+void c2_switch_bt_adresse(u8 welche, const u8 *adr)
+{
+    if (welche < 3) {
+        memcpy(gegenstelle[welche], adr, 6);
+    }
+}
+
+static void adresse_melden(const char *name, const u8 *a)
+{
+    c2_log("switch: %s %02x:%02x:%02x:%02x:%02x:%02x\r\n", name, a[5], a[4], a[3], a[2], a[1], a[0]);
+}
+
+static void ereignisse_melden(const char *name, const struct ereignis *e, int n)
+{
+    for (int i = 0; i < n; i += 4) {
+        char z[100], *q = z;
+        for (int k = i; k < n && k < i + 4; k++) {
+            q += sprintf(q, " %c%02x/%02x@%u.%02u rx%u", e[k].art, e[k].ev, e[k].wert, e[k].zeit / 100, e[k].zeit % 100, e[k].rx);
+        }
+        c2_log("switch: %s%s\r\n", name, z);
+    }
+}
+
+int c2_switch_bt_verbunden(void)
+{
+    return !!edr_hid_is_connected();
+}
+
+/* HID-Deskriptor des Pro Controllers über Bluetooth (öffentlich dokumentiert, gleich dem des Originals):
+ * Eingabe 0x21 (Antwort), 0x30 (voll), 0x31..0x33 (NFC/IR), 0x3F (einfach); Ausgabe 0x01, 0x10..0x12 */
+const u8 c2_switch_bt_deskriptor[170] = {
+    0x05, 0x01, 0x09, 0x05, 0xA1, 0x01,                                     /* Gamepad */
+    0x06, 0x01, 0xFF, 0x85, 0x21, 0x09, 0x21, 0x75, 0x08, 0x95, 0x30, 0x81, 0x02,
+    0x85, 0x30, 0x09, 0x30, 0x75, 0x08, 0x95, 0x30, 0x81, 0x02,
+    0x85, 0x31, 0x09, 0x31, 0x75, 0x08, 0x96, 0x69, 0x01, 0x81, 0x02,
+    0x85, 0x32, 0x09, 0x32, 0x75, 0x08, 0x96, 0x69, 0x01, 0x81, 0x02,
+    0x85, 0x33, 0x09, 0x33, 0x75, 0x08, 0x96, 0x69, 0x01, 0x81, 0x02,
+    0x85, 0x3F, 0x05, 0x09, 0x19, 0x01, 0x29, 0x10, 0x15, 0x00, 0x25, 0x01, 0x75, 0x01, 0x95, 0x10, 0x81, 0x02,
+    0x05, 0x01, 0x09, 0x39, 0x15, 0x00, 0x25, 0x07, 0x75, 0x04, 0x95, 0x01, 0x81, 0x42,
+    0x05, 0x09, 0x75, 0x04, 0x95, 0x01, 0x81, 0x01,
+    0x05, 0x01, 0x09, 0x30, 0x09, 0x31, 0x09, 0x33, 0x09, 0x34, 0x16, 0x00, 0x00, 0x27, 0xFF, 0xFF, 0x00, 0x00,
+    0x75, 0x10, 0x95, 0x04, 0x81, 0x02,
+    0x06, 0x01, 0xFF, 0x85, 0x01, 0x09, 0x01, 0x75, 0x08, 0x95, 0x30, 0x91, 0x02,
+    0x85, 0x10, 0x09, 0x10, 0x75, 0x08, 0x95, 0x30, 0x91, 0x02,
+    0x85, 0x11, 0x09, 0x11, 0x75, 0x08, 0x95, 0x30, 0x91, 0x02,
+    0x85, 0x12, 0x09, 0x12, 0x75, 0x08, 0x95, 0x30, 0x91, 0x02,
+    0xC0,
+};
+
+/* MAC wie der Stack sie hält: umgekehrt zur Anzeige (ffeeddccbbaa = AA:BB:CC:DD:EE:FF) */
+static void mac_holen(u8 *mac)
+{
+    memcpy(mac, bt_get_mac_addr(), 6);
+}
+
+void c2_switch_diag(void)
+{
+    const u8 *m = bt_get_mac_addr();
+    c2_log("switch: modus=%d voll=%u spieler=%x rx=%lu verloren=%lu vib=%lu letzte=%02x%02x%02x%02x %02x%02x%02x%02x st=%u/%u\r\n",
+           modus, voll, spieler, rx_anzahl, rx_verloren, vib_anzahl, vib_letzt[0], vib_letzt[1], vib_letzt[2],
+           vib_letzt[3], vib_letzt[4], vib_letzt[5], vib_letzt[6], vib_letzt[7], vib_st[0], vib_st[1]);
+    extern int c2_weck_status_lesen(void);
+    extern u8 c2_weck_absender[6];
+    c2_log("switch: weck pid=%04x absender %02x:%02x:%02x:%02x:%02x:%02x status=%d\r\n", c2_weck_pid, c2_weck_absender[5],
+           c2_weck_absender[4], c2_weck_absender[3], c2_weck_absender[2], c2_weck_absender[1], c2_weck_absender[0],
+           c2_weck_status_lesen());
+    c2_log("switch: bt=%d rx=%lu tx=%lu gesendet=%lu mac=%02x%02x%02x%02x%02x%02x\r\n", c2_switch_bt_verbunden(), bt_rx, bt_tx,
+           bt_voll, m[0], m[1], m[2], m[3], m[4], m[5]);
+    adresse_melden("start ", gegenstelle[0]);
+    adresse_melden("verbunden", gegenstelle[1]);
+    adresse_melden("getrennt", gegenstelle[2]);
+    static u8 gespeichert[6 * 4];
+    u8 n = restore_remote_device_info_opt((bd_addr_t *)gespeichert, 4, get_remote_dev_info_index());
+    for (u8 i = 0; i < n && i < 4; i++) {
+        char name[16];
+        sprintf(name, "gekoppelt%u", i + 1);
+        adresse_melden(name, gespeichert + 6 * i);
+    }
+    c2_log("switch: ereignisse=%u jetzt=%lu.%02lu\r\n", ereignis_n, jiffies / 100, jiffies % 100);
+    ereignisse_melden("erste", erste, ereignis_n < ERSTE ? ereignis_n : ERSTE);
+    if (ereignis_n > ERSTE) {
+        struct ereignis l[LETZTE];
+        int n = ereignis_n - ERSTE < LETZTE ? ereignis_n - ERSTE : LETZTE;
+        for (int i = 0; i < n; i++) {
+            l[i] = letzte[(ereignis_n - n + i) % LETZTE];
+        }
+        ereignisse_melden("letzte", l, n);
+    }
+}
+
+static void spi_init(void)
+{
+    memset(spi_6000, 0xFF, sizeof(spi_6000));
+    /* 0x6020: IMU-Werkskalibrierung (übliche Standardwerte) */
+    static const u8 IMU[24] = {0xD3, 0xFF, 0xD5, 0xFF, 0x55, 0x01, 0x00, 0x40, 0x00, 0x40, 0x00, 0x40,
+                               0x19, 0x00, 0xDD, 0xFF, 0xDC, 0xFF, 0x3B, 0x34, 0x3B, 0x34, 0x3B, 0x34};
+    memcpy(spi_6000 + 0x20, IMU, sizeof(IMU));
+    /* 0x603D: linker Stick (über Mitte, Mitte, unter Mitte), rechter Stick (Mitte, unter, über): Mitte 0x800,
+     * Spanne 0x7FF in alle Richtungen (12 Bit: x | y << 12) */
+    static const u8 STICK_L[9] = {0xFF, 0xF7, 0x7F, 0x00, 0x08, 0x80, 0xFF, 0xF7, 0x7F};
+    static const u8 STICK_R[9] = {0x00, 0x08, 0x80, 0xFF, 0xF7, 0x7F, 0xFF, 0xF7, 0x7F};
+    memcpy(spi_6000 + 0x3D, STICK_L, 9);
+    memcpy(spi_6000 + 0x46, STICK_R, 9);
+    /* 0x6050: Farben Gehäuse dunkelgrau, Tasten weiß; 0x6056.. Griffe */
+    static const u8 FARBEN[12] = {0x32, 0x32, 0x32, 0xFF, 0xFF, 0xFF, 0x32, 0x32, 0x32, 0x32, 0x32, 0x32};
+    memcpy(spi_6000 + 0x50, FARBEN, sizeof(FARBEN));
+    /* 0x6080: Sensor-/Stick-Parameter (Nintendo-Standard), 0x6086 und 0x6098 Stick-Totzone und Bereich */
+    static const u8 P6080[6] = {0x50, 0xFD, 0x00, 0x00, 0xC6, 0x0F};
+    static const u8 STICKPAR[18] = {0x0F, 0x30, 0x61, 0x96, 0x30, 0xF3, 0xD4, 0x14, 0x54,
+                                    0x41, 0x15, 0x54, 0xC7, 0x79, 0x9C, 0x33, 0x36, 0x63};
+    memcpy(spi_6000 + 0x80, P6080, sizeof(P6080));
+    memcpy(spi_6000 + 0x86, STICKPAR, sizeof(STICKPAR));
+    memcpy(spi_6000 + 0x98, STICKPAR, sizeof(STICKPAR));
+}
+
+/* Tasten in die drei Pro-Controller-Bytes (rechts, gemeinsam, links) */
+static void tasten(u64 r, u8 *b)
+{
+#define T(rolle) ((r >> (rolle)) & 1)
+    b[0] = T(C2_ROLLE_Y) << 0 | T(C2_ROLLE_X) << 1 | T(C2_ROLLE_B) << 2 | T(C2_ROLLE_A) << 3 | T(C2_ROLLE_R) << 6 |
+           T(C2_ROLLE_ZR) << 7;
+    b[1] = T(C2_ROLLE_MINUS) << 0 | T(C2_ROLLE_PLUS) << 1 | T(C2_ROLLE_R3) << 2 | T(C2_ROLLE_L3) << 3 |
+           T(C2_ROLLE_HOME) << 4 | T(C2_ROLLE_KAMERA) << 5 | (tx_bt ? 0 : 0x80); /* 0x80: Ladegriff/USB */
+    b[2] = T(C2_ROLLE_RUNTER) << 0 | T(C2_ROLLE_HOCH) << 1 | T(C2_ROLLE_RECHTS) << 2 | T(C2_ROLLE_LINKS) << 3 |
+           T(C2_ROLLE_L) << 6 | T(C2_ROLLE_ZL) << 7;
+#undef T
+}
+
+/* Achse 0..1023 (Mitte 512) -> 12 Bit; y umdrehen: bei uns ist „hoch“ klein, bei Nintendo groß */
+static void stick(u16 x, u16 y, u8 *b)
+{
+    u16 x12 = x * 4 + 2, y12 = 4095 - y * 4 - 2;
+    b[0] = x12 & 0xFF;
+    b[1] = (x12 >> 8) | ((y12 & 0x0F) << 4);
+    b[2] = y12 >> 4;
+}
+
+/* Kopf eines Eingabe-Reports: Zeit, Akku/Verbindung, Tasten, Sticks, Vibrations-Byte (13 Byte) */
+static void kopf(u8 id, const struct c2_switch_lage *l)
+{
+    memset(tx, 0, sizeof(tx));
+    tx[0] = id;
+    tx[1] = zeit++;
+    u8 stufe = l->akku >= 75 ? 8 : l->akku >= 50 ? 6 : l->akku >= 25 ? 4 : l->akku > 10 ? 2 : 0;
+    tx[2] = stufe << 4 | (l->laedt ? 0x10 : 0) | (tx_bt ? 0x00 : 0x01); /* Pro Controller (0), USB-Strom (1) */
+    tasten(l->rollen, tx + 3);
+    stick(l->achsen[0], l->achsen[1], tx + 6);
+    stick(l->achsen[2], l->achsen[3], tx + 9);
+    tx[12] = 0x0B;
+}
+
+/* HD-Vibration grob auf die zwei Motoren: Amplitude hoch (Byte 1, 0..0x64) und tief (Byte 3, 0x40..0x72), dann
+ * Anlaufschwelle: Vibrationsmotoren drehen erst ab einer Mindestspannung, kleine Amplituden wären sonst unfühlbar */
+#define ANLAUF 40
+static void vibration(const u8 *d)
+{
+    u8 st[2];
+    for (int s = 0; s < 2; s++) {
+        const u8 *v = d + 4 * s;
+        int hf = (v[1] >> 1) & 0x7F;
+        int lf = (v[3] & 0x7F) > 0x40 ? ((v[3] & 0x7F) - 0x40) * 2 : 0;
+        int a = hf > lf ? hf : lf;
+        a = a > 100 ? 100 : a;
+        st[s] = a ? (ANLAUF + a * (100 - ANLAUF) / 100) * c2_vibration_staerke() / 100 : 0;
+    }
+    if (st[0] || st[1]) {
+        vib_anzahl++;
+        memcpy(vib_letzt, d, 8);
+        vib_st[0] = st[0], vib_st[1] = st[1];
+    }
+    c2_motor_setzen(st[0], st[1], 150); /* kommt nichts mehr, hört es nach 150 ms auf */
+}
+
+/* Unterbefehl beantworten (Report 0x21) */
+static void unterbefehl(const u8 *o, const struct c2_switch_lage *l)
+{
+    u8 sub = o[10];
+    const u8 *arg = o + 11;
+    kopf(0x21, l);
+    tx[13] = 0x80;
+    tx[14] = sub;
+    u8 *d = tx + 15;
+    switch (sub) {
+    case 0x02: { /* Geräteinfo: Firmware 3.48, Typ 3 = Pro Controller, MAC, Farben aus SPI */
+        u8 mac[6];
+        mac_holen(mac);
+        tx[13] = 0x82;
+        d[0] = 0x03, d[1] = 0x48, d[2] = 0x03, d[3] = 0x02;
+        for (int i = 0; i < 6; i++) {
+            d[4 + i] = mac[5 - i];
+        }
+        d[10] = 0x03, d[11] = 0x02;
+        break;
+    }
+    case 0x04: /* Trigger-Zeiten: 14 Byte, alles 0 */
+        tx[13] = 0x83;
+        break;
+    case 0x10: { /* SPI lesen: Adresse (4 Byte LE), Länge */
+        u32 adr = arg[0] | arg[1] << 8 | arg[2] << 16 | (u32)arg[3] << 24;
+        u8 n = arg[4] > 0x1D ? 0x1D : arg[4];
+        tx[13] = 0x90;
+        memcpy(d, arg, 5);
+        for (int i = 0; i < n; i++) {
+            u32 a = adr + i;
+            d[5 + i] = (a >= 0x6000 && a < 0x6100) ? spi_6000[a - 0x6000] : 0xFF; /* 0x8010..: keine Benutzerkal. */
+        }
+        break;
+    }
+    case 0x21: /* MCU-Konfiguration (NFC/IR): wie das Original, „nicht vorhanden“ */
+        tx[13] = 0xA0;
+        d[0] = 0x01, d[1] = 0x00, d[2] = 0xFF, d[3] = 0x00, d[4] = 0x03, d[5] = 0x00, d[6] = 0x05, d[7] = 0x06;
+        d[33] = 0x62;
+        break;
+    case 0x30: /* Spieler-LEDs: untere 4 Bit an, obere 4 Bit blinken */
+        spieler = arg[0] & 0x0F ? arg[0] & 0x0F : arg[0] >> 4;
+        break;
+    case 0x01: /* Bluetooth-Kopplung über USB wie Werks-FW (0xF05A) und Doku (dekuNukem): 1 Adressen tauschen,
+                * 2 Schlüssel (LE, je Byte XOR 0xAA), 3 speichern. Die Switch 2 nimmt Pro Controller nur so auf. */
+        tx[13] = 0x81;
+        d[0] = arg[0];
+        extern void c2_mitschnitt_start(void);
+        c2_mitschnitt_start(); /* ab der USB-Kopplung SDK-Meldungen mitschneiden (btlog) */
+        c2_switch_bt_ereignis('p', arg[0], 0);
+        c2_log("switch: USB-Kopplung Schritt %u\r\n", arg[0]);
+        if (arg[0] == 1) {
+            memcpy(konsole, arg + 1, 6);
+            memcpy(d + 1, bt_get_mac_addr(), 6);
+            d[7] = 0x00, d[8] = 0x25, d[9] = 0x08; /* Geräteklasse Gamepad */
+            memcpy(d + 10, "Pro Controller", 14);
+            /* Schlüssel aus beiden Adressen gemischt (wie die Werks-FW: gleich bei erneuter Kopplung) */
+            const u8 *eigen = bt_get_mac_addr();
+            for (int i = 0; i < 16; i++) {
+                schluessel[i] = eigen[i % 6] ^ konsole[(i + 3) % 6] ^ (u8)(0x9E + 0x3B * i);
+            }
+        } else if (arg[0] == 2) {
+            for (int i = 0; i < 16; i++) {
+                d[1 + i] = schluessel[i] ^ 0xAA;
+            }
+        } else {
+            d[0] = 3; /* 3 = speichern (4 = prüfen: wie die Werks-FW mit 3 beantworten) */
+            put_link_key(konsole, schluessel, get_remote_dev_info_index());
+            versuche = 0;
+            c2_log("switch: über USB gekoppelt mit %02x:%02x:%02x:%02x:%02x:%02x\r\n", konsole[5], konsole[4],
+                   konsole[3], konsole[2], konsole[1], konsole[0]);
+        }
+        break;
+    default: /* 0x03 Modus, 0x08, 0x38 Home-Licht, 0x40 IMU, 0x41, 0x48 Vibration an, 0x22, 0x11 ...: nur bestätigen */
+        break;
+    }
+    tx_len = 64;
+}
+
+/* Alle 10 ms aus der Tastenabfrage (nur im Switch-Modus) */
+/* Wie der echte Pro Controller: nach dem Abziehen vom USB und bei jedem Tastendruck ohne Verbindung selbst die
+ * gekoppelte Konsole anrufen (zuletzt gespeicherte Kopplung). Höchstens 3 Versuche je Anlass, 10 s Abstand. */
+/* Wiederverbinden wie die Werks-FW (0xAC34/0x1237A Create_Connection, 0xAF30 Authentication_Requested, 0x11B7E
+ * Set_Connection_Encryption, 0x144F8 HID-Kanäle): Funkverbindung direkt über den Funkchip, damit die Bibliothek nicht
+ * selbst unverschlüsselt SDP und HID aufmacht (dann trennt die Switch mit 0x05, am Gerät 8k-8n). Die Adresse wie
+ * die Bibliothek sie speichert (0x1E16558 gibt sie ebenso unverändert an lmp_hci_create_connection). */
+static u8 eigener_anruf;     /* 1 = Anruf läuft, 2 = Funkverbindung steht, warte auf Verschlüsselung */
+static int anrufen(void)
+{
+    static u8 adr[6];
+    if (!restore_remote_device_info_opt((bd_addr_t *)adr, 1, get_remote_dev_info_index())) {
+        return 0;
+    }
+    eigener_anruf = 1;
+    lmp_hci_create_connection(adr, 0xCC18, 1, 0, 0, 1); /* Pakettypen, PSRM 1, Rollenwechsel erlaubt (Werks-FW) */
+    return 1;
+}
+
+/* Switch 2 aufwecken (die Werks-FW scheitert daran, vermutlich weil sie von ihrer BLE-Adresse sendet):
+ * Nintendo-Herstellerdaten wie Werks-Vorlage (app 0x53441) und github.com/thiagobucca/nintendo-switch2-esp32-waker,
+ * Absender klassische Adresse (ble_hogp.c), Zustand 0x81 = wiederverbinden. Die Konsolen-Adresse steht im Signal in
+ * Leitungsreihenfolge, so wie die Bibliothek sie speichert (echtes Joy-Con-2-Signal am 30.10. mitgeschnitten). */
+int c2_weck_werbung(const u8 *daten, u8 len, u32 dauer_ms, const u8 *absender);
+/* Die Switch 2 wacht nur bei Absendern auf, die sie per BLE gekoppelt hat (Joy-Con 2, Pro Controller 2), nicht bei
+ * unserer klassischen Adresse (am Gerät 30.10. belegt: mit Joy-Con-Adresse wach, mit eigener nicht). Darum leiht
+ * sich der C2 Lite die Kennung eines Joy-Con 2, wie GameSir/8BitDo beim Einrichten. Gespeichert im VM (ID 49). */
+#define CFG_WECK 49
+u8 c2_weck_absender[6];   /* Leitungsreihenfolge; leer = eigene klassische Adresse (weckt nicht, nur zum Testen) */
+u16 c2_weck_pid = 0x2069; /* Produkt-ID des geliehenen Controllers (Joy-Con 2 L 2066, R 2067, Pro 2069) */
+static struct {
+    u8 version;
+    u8 reserve;
+    u16 pid;
+    u8 absender[6];
+} weck_vm;
+
+void c2_weck_laden(void)
+{
+    static u8 geladen; /* nur einmal: ein später von Hand gesetzter Testwert bleibt */
+    if (geladen) {
+        return;
+    }
+    geladen = 1;
+    if (syscfg_read(CFG_WECK, (u8 *)&weck_vm, sizeof(weck_vm)) == sizeof(weck_vm) && weck_vm.version == 1) {
+        c2_weck_pid = weck_vm.pid;
+        memcpy(c2_weck_absender, weck_vm.absender, 6);
+    }
+}
+
+int c2_weck_speichern(void)
+{
+    weck_vm.version = 1, weck_vm.pid = c2_weck_pid;
+    memcpy(weck_vm.absender, c2_weck_absender, 6);
+    return syscfg_write(CFG_WECK, (u8 *)&weck_vm, sizeof(weck_vm)) == sizeof(weck_vm) ? 0 : -1;
+}
+static u32 geweckt_ms;
+
+/* Weckkennung am Controller lernen (Licht + Home oder „switch weck lernen“): 30 s passiv scannen, bis ein Joy-Con 2
+ * oder Pro Controller 2 sein Wecksignal für unsere Konsole sendet (Joy-Con abnehmen, Taste drücken). Aufbau wie in
+ * c2lite-custom/src/wecken.rs: Herstellerdaten 53 05 | 01 00 03 7e 05 | PID | 00 01 | 81 | Konsole (LE) | 0f. */
+#define LERN_MS 30000
+static volatile u8 lern_aktiv;
+static u8 lern_konsole[6], lern_mit_konsole;
+static u8 lern_adr[6];
+static u16 lern_pid;
+int c2_weck_lauschen(u32 dauer_ms);
+void c2_weck_lauschen_ende(void);
+void c2_belegung_hinweis(u8 r, u8 g, u8 b, u8 n);
+
+int c2_weck_lernt(void)
+{
+    return lern_aktiv;
+}
+
+int c2_weck_lernen(void)
+{
+    if (lern_aktiv) {
+        return -2;
+    }
+    lern_mit_konsole = !!restore_remote_device_info_opt((bd_addr_t *)lern_konsole, 1, get_remote_dev_info_index());
+    int r = c2_weck_lauschen(LERN_MS);
+    if (r) {
+        return r;
+    }
+    lern_aktiv = 1;
+    c2_log("switch: lerne Weckkennung (30 s, Konsole %s): Joy-Con 2 abnehmen und eine Taste daran drücken\r\n",
+           lern_mit_konsole ? "gekoppelt" : "beliebig");
+    return 0;
+}
+
+static void lern_fertig(void *priv)
+{
+    c2_weck_lauschen_ende();
+    c2_weck_pid = lern_pid;
+    memcpy(c2_weck_absender, lern_adr, 6);
+    int r = c2_weck_speichern();
+    lern_aktiv = 0;
+    c2_log("switch: Weckkennung gelernt %04x absender %02x:%02x:%02x:%02x:%02x:%02x%s\r\n", c2_weck_pid,
+           c2_weck_absender[5], c2_weck_absender[4], c2_weck_absender[3], c2_weck_absender[2], c2_weck_absender[1],
+           c2_weck_absender[0], r ? " (speichern fehlgeschlagen)" : "");
+    c2_belegung_hinweis(0, 255, 0, 3);
+    c2_motor_setzen(80, 80, 300);
+}
+
+void c2_weck_lernen_vorbei(void)
+{
+    if (!lern_aktiv) {
+        return;
+    }
+    lern_aktiv = 0;
+    c2_log("switch: kein Wecksignal gefunden\r\n");
+    c2_belegung_hinweis(255, 0, 0, 2);
+}
+
+/* Aus dem Bluetooth-Stack (le_gatt_common.c): ein Werbe-Bericht (adv_report_t) */
+void c2_weck_bericht(const u8 *b, u16 len)
+{
+    if (lern_aktiv != 1 || len < 10) {
+        return;
+    }
+    const u8 *adr = b + 2, *ad = b + 10;
+    u8 n = b[9];
+    if (10 + n > len) {
+        return;
+    }
+    for (u8 i = 0; i + 1 < n; i += ad[i] + 1) {
+        u8 l = ad[i];
+        if (!l || i + 1 + l > n) {
+            return;
+        }
+        const u8 *f = ad + i + 1; /* Typ, Daten */
+        if (f[0] != 0xFF || l < 3 + 16 || f[1] != 0x53 || f[2] != 0x05) {
+            continue;
+        }
+        const u8 *d = f + 3;
+        if (d[0] != 0x01 || d[3] != 0x7e || d[4] != 0x05 || d[9] != 0x81) {
+            continue;
+        }
+        if (lern_mit_konsole && memcmp(d + 10, lern_konsole, 6)) {
+            continue; /* weckt eine andere Konsole */
+        }
+        lern_pid = d[5] | d[6] << 8;
+        memcpy(lern_adr, adr, 6);
+        lern_aktiv = 2;
+        sys_timeout_add(NULL, lern_fertig, 1); /* speichern im App-Task, nicht im Bluetooth-Stack */
+        return;
+    }
+}
+
+void c2_switch_wecken(void)
+{
+    static u8 w[31];
+    u8 konsole[6];
+    if (!restore_remote_device_info_opt((bd_addr_t *)konsole, 1, get_remote_dev_info_index())) {
+        c2_switch_bt_ereignis('w', 0, 0);
+        return;
+    }
+    static const u8 KOPF[] = {0x02, 0x01, 0x06, 0x1B, 0xFF, 0x53, 0x05, 0x01, 0x00, 0x03, 0x7E, 0x05};
+    memset(w, 0, sizeof(w));
+    memcpy(w, KOPF, sizeof(KOPF));
+    w[12] = c2_weck_pid, w[13] = c2_weck_pid >> 8;
+    w[14] = 0x00, w[15] = 0x01, w[16] = 0x81;
+    memcpy(w + 17, konsole, 6);
+    w[23] = 0x0F;
+    static const u8 LEER[6];
+    int r = c2_weck_werbung(w, sizeof(w), 2000, memcmp(c2_weck_absender, LEER, 6) ? c2_weck_absender : NULL);
+    geweckt_ms = ms ? ms : 1;
+    c2_switch_bt_ereignis('w', 1, (u8)r);
+    c2_log("switch: Weckwerbung (PID %04x) -> %d\r\n", c2_weck_pid, r);
+}
+
+static void wiederverbinden(const struct c2_switch_lage *l)
+{
+    static u64 alt_rollen;
+    u8 usb = gpio_read(IO_PORTB_05);
+    u64 neu = l->rollen & ~alt_rollen;
+    alt_rollen = l->rollen;
+    /* Home ohne Verbindung (auch beim Einschalten per Home): Switch wecken, höchstens alle 3 s */
+    if ((neu & (1ULL << C2_ROLLE_HOME)) && !c2_switch_bt_verbunden() && (!geweckt_ms || ms - geweckt_ms > 3000)) {
+        c2_switch_wecken();
+    }
+    if ((alt_usb && !usb) || neu) {
+        versuche = 0;
+    }
+    alt_usb = usb;
+    if (usb || c2_switch_bt_verbunden() || versuche >= 3 || (s32)(ms - verbinden_ab) < 0) {
+        return;
+    }
+    if (anrufen()) {
+        angerufen = ms ? ms : 1;
+        versuche++;
+        verbinden_ab = ms + 10000;
+        c2_log("switch: rufe Konsole an (Versuch %u)\r\n", versuche);
+        extern void c2_mitschnitt_start(void);
+        c2_mitschnitt_start(); /* ab dem ersten eigenen Anruf mitschneiden */
+        c2_switch_bt_ereignis('v', versuche, 0);
+    } else {
+        versuche = 3; /* nichts gekoppelt */
+    }
+}
+
+/* Ruft die Bibliothek bei jeder Funkverbindung auf (app_comm_edr.c). Hat UNSER Controller angerufen, öffnet die
+ * Bibliothek als HID-Gerät die HID-Kanäle nicht selbst (am Gerät: ACL steht, nach 10 s Zeitüberschreitung 0x08);
+ * die Werks-FW öffnet dann selbst PSM 0x11/0x13 (0x144F8). Ruft die Konsole an, macht sie das selbst. */
+static void hid_oeffnen(void *priv)
+{
+    if (!c2_switch_bt_verbunden()) {
+        c2_switch_bt_ereignis('k', 1, 0);
+        user_send_cmd_prepare(USER_CTRL_HID_CONN, 0, NULL);
+    }
+}
+
+/* Verschlüsselung: Beim eigenen Anruf authentifiziert die Bibliothek, schaltet aber nicht auf verschlüsselt; die
+ * Switch trennt dann beim unverschlüsselten HID-Aufbau (LMP_DETACH 5, am Gerät belegt 8k). Die Werks-FW sendet nach
+ * Authentication Complete Set_Connection_Encryption (0x11B7E); der Funkchip hängt den Auftrag hinter die laufende
+ * Authentifizierung. Handle über die Adresse (Leitungsreihenfolge, sonst umgedreht versuchen). */
+u16 lmp_private_handler_for_remote_addr(u8 *addr, int link_type);
+int lmp_hci_set_connection_encryption(u16 handle, int enable);
+
+static u16 enc_handle;
+static u8 enc_versuche;
+static u16 enc_timer;
+
+/* Alle 10 ms: Verschlüsselung anfordern, bis sie steht (geht erst nach der Authentifizierung); höchstens 40 Versuche */
+static void verschluesseln(void *priv)
+{
+    extern u8 c2_switch_verschluesselt;
+    int r = 1;
+    if (!c2_switch_verschluesselt) {
+        r = lmp_hci_set_connection_encryption(enc_handle, 1);
+    }
+    enc_versuche++;
+    /* Die Rückgabe ist kein Erfolgszeichen (0 auch, wenn der Funkchip den Auftrag während der Authentifizierung
+     * verwirft, am Gerät 8m); Erfolg ist erst BT_STATUS_ENCRY_COMPLETE */
+    if (c2_switch_verschluesselt || enc_versuche >= 60) {
+        c2_switch_bt_ereignis('E', enc_versuche, (u8)r);
+        sys_timer_del(enc_timer);
+        enc_timer = 0;
+    }
+}
+
+void c2_switch_acl_verbunden(const u8 *adr)
+{
+    extern u8 c2_switch_verschluesselt;
+    c2_switch_verschluesselt = 0;
+    if (!(c2_switch_modus() && eigener_anruf == 1)) {
+        return;
+    }
+    eigener_anruf = 2;
+    angerufen = 0;
+    u8 a[6];
+    memcpy(a, adr, 6);
+    u16 h = lmp_private_handler_for_remote_addr(a, 1);
+    c2_switch_bt_ereignis('e', 1, (u8)h);
+    if (!h || h == 0xFFFF) {
+        return;
+    }
+    /* Authentifizieren lassen (den Schlüssel liefert die Bibliothek); danach verschlüsselt die Bibliothek selbst
+     * (hci_event_handler bei Authentication Complete), sonst fordert verschluesseln() nach */
+    lmp_hci_authentication_requested(h);
+    if (!enc_timer) {
+        enc_handle = h, enc_versuche = 0;
+        enc_timer = sys_timer_add(NULL, verschluesseln, 20);
+    }
+}
+
+/* app_comm_edr.c: Verschlüsselung steht. Beim eigenen Anruf erst jetzt die HID-Kanäle öffnen (wie die Werks-FW) */
+static void hid_nach_verschluesselung(void *priv)
+{
+    c2_switch_bt_ereignis('k', 2, 0);
+    user_send_cmd_prepare(USER_CTRL_HID_CONN, 0, NULL);
+}
+
+void c2_switch_verschluesselt_meldung(void)
+{
+    extern u8 c2_switch_verschluesselt;
+    c2_switch_verschluesselt = 1;
+    if (eigener_anruf == 2) {
+        eigener_anruf = 0;
+        sys_timeout_add(NULL, hid_nach_verschluesselung, 30);
+    }
+}
+
+void c2_switch_takt(const struct c2_switch_lage *l)
+{
+    static u8 init;
+    if (!init) {
+        spi_init();
+        init = 1;
+        alt_usb = gpio_read(IO_PORTB_05);
+        c2_weck_laden();
+        versuche = 0;          /* beim Start selbst die gekoppelte Konsole anrufen (die Bibliothek tut es nicht mehr) */
+        verbinden_ab = 1000;   /* erst nach 1 s, wenn der Stack bereit ist */
+    }
+    ms += 10;
+    if (!c2_pro2_an()) {
+        wiederverbinden(l); /* klassisches Bluetooth; im Pro-Controller-2-Modus ist es aus (app_keyboard.c) */
+    }
+    if (rx_schreib != rx_lies && !tx_len) {
+        const u8 *o = rx_ring[rx_lies % RX_PLAETZE];
+        tx_bt = rx_bt[rx_lies % RX_PLAETZE];
+        /* Jedes Paket der Konsole ins Ereignisprotokoll: u = USB, b = Bluetooth; Typ und Befehl bzw. Unterbefehl */
+        c2_switch_bt_ereignis(tx_bt ? 'b' : 'u', o[0], o[0] == 0x01 ? o[10] : o[1]);
+        if (o[0] == 0x80 && !tx_bt) {
+            memset(tx, 0, sizeof(tx));
+            tx[0] = 0x81, tx[1] = o[1];
+            switch (o[1]) {
+            case 0x01: { /* Status: Pro Controller, MAC (umgekehrt) */
+                u8 mac[6];
+                mac_holen(mac);
+                tx[2] = 0x00, tx[3] = 0x03;
+                memcpy(tx + 4, mac, 6);
+                tx_len = 64;
+                break;
+            }
+            case 0x02:
+            case 0x03:
+                tx_len = 64;
+                break;
+            case 0x04:
+                voll = 1;
+                break;
+            case 0x05:
+                voll = 0;
+                break;
+            }
+        } else if (o[0] == 0x01) {
+            vibration(o + 2);
+            unterbefehl(o, l);
+        } else if (o[0] == 0x10) {
+            vibration(o + 2);
+        }
+        rx_lies++;
+    }
+    if (bt_takt < 30) {
+        bt_takt += 10;
+    }
+    if (tx_len) {
+        /* Antwort, die nach 200 ms nicht raus ist, verwerfen: sonst blockiert sie alles (auch Bluetooth) */
+        if (++tx_versuche > 20) {
+            c2_switch_bt_ereignis('X', tx[0], tx_bt ? 0xB : custom_hid_get_ready(0));
+            tx_len = 0, tx_versuche = 0;
+            return;
+        }
+        if (tx_bt ? c2_edr_senden(tx, 49) : custom_hid_tx_data(0, tx, tx_len)) {
+            tx_versuche = 0;
+            /* gesendete Antwort ins Protokoll: U = über USB, B = über Bluetooth; Report-ID und Befehl/Unterbefehl */
+            c2_switch_bt_ereignis(tx_bt ? 'B' : 'U', tx[0], tx[0] == 0x21 ? tx[14] : tx[1]);
+            tx_len = 0;
+            bt_tx += tx_bt;
+        }
+        return; /* Antwort hat Vorrang, 0x30 erst in der nächsten Runde */
+    }
+    if (voll) {
+        tx_bt = 0;
+        kopf(0x30, l);
+        custom_hid_tx_data(0, tx, 64);
+    } else if (c2_switch_bt_verbunden()) {
+        if (!bt_war) {
+            bt_war = 1, bt_warte = 20, bt_takt = 15; /* neue Verbindung: erster Report nach 200 ms */
+        }
+        if (bt_warte) {
+            bt_warte--;
+            return;
+        }
+        /* Bluetooth: alle 15 ms (10/20 ms im Wechsel); c2_edr_senden lässt nur ein Paket unterwegs zu */
+        if (bt_takt >= 15) {
+            tx_bt = 1;
+            kopf(0x30, l);
+            if (c2_edr_senden(tx, 49)) {
+                bt_takt -= 15;
+                bt_voll++;
+            }
+        }
+    } else {
+        bt_war = 0;
+    }
+}
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_switch.h b/apps/hid/modules/c2lite/c2_switch.h
new file mode 100644
index 0000000..7154169
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_switch.h
@@ -0,0 +1,54 @@
+#ifndef C2_SWITCH_H
+#define C2_SWITCH_H
+/* C2 Lite: Switch-Modus über USB und klassisches Bluetooth als Pro Controller (c2_switch.c) */
+
+/* Tastenrollen wie enum rolle in c2_eingaben.c (dort per Compile-Prüfung abgeglichen) */
+#define C2_ROLLE_B 0
+#define C2_ROLLE_A 1
+#define C2_ROLLE_X 3
+#define C2_ROLLE_Y 4
+#define C2_ROLLE_L 6
+#define C2_ROLLE_R 7
+#define C2_ROLLE_ZL 8
+#define C2_ROLLE_ZR 9
+#define C2_ROLLE_MINUS 10
+#define C2_ROLLE_PLUS 11
+#define C2_ROLLE_HOME 12
+#define C2_ROLLE_L3 13
+#define C2_ROLLE_R3 14
+#define C2_ROLLE_KAMERA 15
+#define C2_ROLLE_HOCH 32
+#define C2_ROLLE_RECHTS 33
+#define C2_ROLLE_RUNTER 34
+#define C2_ROLLE_LINKS 35
+
+struct c2_switch_lage {
+    u64 rollen;      /* gedrückte Tasten (Rollen-Bits) */
+    u16 achsen[4];   /* LX, LY, RX, RY 0..1023, Mitte 512, „hoch“ = klein */
+    u8 akku;         /* 0..100 % */
+    u8 laedt;
+};
+
+int c2_switch_modus(void);                 /* 1 = Schieber in Stellung PA3 (Switch), beim ersten Aufruf gelesen */
+u8 c2_switch_spieler(void);                /* Spieler-LEDs von der Konsole, Bit 0 = Spieler 1 */
+void c2_switch_usb_empfang(void *priv, u8 *buf, u32 len); /* OUT-Paket (Interrupt) */
+void c2_switch_bt_empfang(u8 *packet, u16 size, u16 channel); /* Ausgabe-Report über Bluetooth (EDR-HID) */
+int c2_switch_bt_verbunden(void);
+void c2_switch_acl_verbunden(const u8 *adr); /* Funkverbindung steht (app_comm_edr.c), Adresse aus dem Ereignis */
+void c2_switch_bt_adresse(u8 welche, const u8 *adr);
+void c2_switch_verschluesselt_meldung(void);
+void c2_switch_wecken(void);                                 /* Weckwerbung für die Switch 2 */
+extern u16 c2_weck_pid;                 /* BT_STATUS_ENCRY_COMPLETE (app_comm_edr.c) */          /* 0 Start, 1 verbunden, 2 getrennt */                         /* Funkverbindung steht (app_comm_edr.c) */
+void c2_switch_bt_ereignis(u8 art, u8 ev, u8 wert);           /* Merkt HCI-/Status-Ereignisse für die Diagnose */                          /* EDR-HID-Kanal zur Konsole steht */
+extern const u8 c2_switch_bt_deskriptor[170];              /* HID-Deskriptor des Pro Controllers über Bluetooth */
+void c2_switch_takt(const struct c2_switch_lage *l);      /* alle 10 ms im Switch-Modus */
+void c2_switch_diag(void);                                 /* „switch diag“: Zähler und letzte Vibrationsdaten */
+
+/* Pro Controller 2 per Bluetooth LE (c2_pro2.c, Stufe 11): Standard mit Schieber auf Switch (statt klassischem Bluetooth) */
+int c2_pro2_an(void);
+int c2_pro2_verbunden(void);                              /* verbunden und verschlüsselt */
+u8 c2_pro2_spieler(void);                                 /* Spieler-LEDs von der Konsole, Bit 0 = Spieler 1 */
+void c2_pro2_takt(const struct c2_switch_lage *l, int usb_host); /* alle 10 ms: Eingabebericht, Wecken auf Home */
+int c2_pro2_befehl(const char *b);                        /* „pro2 status|standard|klassisch|…“ */
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_xinput.c b/apps/hid/modules/c2lite/c2_xinput.c
new file mode 100644
index 0000000..c74f4fb
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_xinput.c
@@ -0,0 +1,99 @@
+/* C2 Lite, PC-Modus über USB: XInput (Xbox-360-Protokoll) wie die Werks-Firmware (Schnittstelle ff/5d/01, Kennung
+ * 2345:e06e, MS-OS-Deskriptor „XUSB10“, Gegenprobe Werks-FW 0x1E26E7B/0x1E2703B). Damit binden Windows (xusb22) und
+ * Linux (xpad, Hersteller 2345) ihren Xbox-Treiber, und Spiele können die Motoren ansteuern.
+ * Eingabebericht (20 Byte): 00 14 | Tasten (16 Bit) | LT | RT | LX LY RX RY (je int16, Y oben positiv) | 6 × 0.
+ * Ausgabe vom Host: 00 08 00 <groß> <klein> 00 00 00 = Rumble, 01 03 <n> = LED-Muster (ignoriert). */
+#include "app_config.h"
+#include "system/includes.h"
+#include "c2_log.h"
+#include "c2_switch.h"
+
+#ifdef CONFIG_BOARD_C2LITE
+
+void c2_motor_setzen(u8 links, u8 rechts, u16 dauer_ms);
+u8 c2_vibration_staerke(void);
+
+/* Rollen-Bits (c2_eingaben.c, c2_switch.h) */
+#define BIT64(n) (1ULL << (n))
+
+/* XInput-Tastenbits: 0 hoch, 1 runter, 2 links, 3 rechts, 4 Start, 5 Back, 6 LS, 7 RS, 8 LB, 9 RB, 10 Guide,
+ * 12 A (unten), 13 B (rechts), 14 X (links), 15 Y (oben); positionsgleich zur Switch-Anordnung */
+static const struct {
+    u8 rolle, bit;
+} TASTEN[] = {
+    {C2_ROLLE_HOCH, 0},  {C2_ROLLE_RUNTER, 1}, {C2_ROLLE_LINKS, 2}, {C2_ROLLE_RECHTS, 3}, {C2_ROLLE_PLUS, 4},
+    {C2_ROLLE_MINUS, 5}, {C2_ROLLE_L3, 6},     {C2_ROLLE_R3, 7},    {C2_ROLLE_L, 8},      {C2_ROLLE_R, 9},
+    {C2_ROLLE_HOME, 10}, {C2_ROLLE_B, 12},     {C2_ROLLE_A, 13},    {C2_ROLLE_Y, 14},     {C2_ROLLE_X, 15},
+};
+
+static s16 achse(u16 v, int umkehren)
+{
+    s32 w = ((s32)v - 512) * 64;
+    if (umkehren) {
+        w = -w;
+    }
+    return w > 32767 ? 32767 : w < -32768 ? -32768 : w;
+}
+
+void c2_xinput_bericht(u64 r, const u16 a[4], u8 *b)
+{
+    memset(b, 0, 20);
+    b[0] = 0x00, b[1] = 0x14;
+    u16 t = 0;
+    for (int i = 0; i < (int)ARRAY_SIZE(TASTEN); i++) {
+        if (r & BIT64(TASTEN[i].rolle)) {
+            t |= 1 << TASTEN[i].bit;
+        }
+    }
+    b[2] = t, b[3] = t >> 8;
+    b[4] = (r & BIT64(C2_ROLLE_ZL)) ? 0xFF : 0; /* ZL/ZR sind digital: ganz oder gar nicht */
+    b[5] = (r & BIT64(C2_ROLLE_ZR)) ? 0xFF : 0;
+    for (int i = 0; i < 4; i++) {
+        s16 w = achse(a[i], i & 1); /* bei uns ist Y = 0 oben, bei XInput ist oben positiv */
+        b[6 + 2 * i] = w, b[7 + 2 * i] = w >> 8;
+    }
+}
+
+/* Rumble: vom USB-Interrupt nur gemerkt, die Motoren setzt c2_xinput_takt in der Abfragerunde */
+static volatile u8 wunsch[2], neu;
+static u8 aktiv[2];
+static u32 runde;
+
+void c2_xinput_empfang(const u8 *buf, u32 len)
+{
+    if (len >= 5 && buf[0] == 0x00 && buf[1] == 0x08) {
+        wunsch[0] = buf[3], wunsch[1] = buf[4];
+        neu = 1;
+    }
+}
+
+/* Anlaufschwelle wie an der Switch: kleine Werte wären sonst nicht spürbar; Stärke-Einstellung skaliert */
+#define ANLAUF 40
+static u8 staerke(u8 v)
+{
+    if (!v) {
+        return 0;
+    }
+    u32 p = (u32)v * 100 / 255;
+    return (ANLAUF + p * (100 - ANLAUF) / 100) * c2_vibration_staerke() / 100;
+}
+
+/* Jede Abfragerunde im PC-Modus: XInput hält Rumble, bis der Host etwas anderes schickt; ohne Host aus */
+void c2_xinput_takt(int host)
+{
+    runde++;
+    if (!host) {
+        wunsch[0] = wunsch[1] = 0;
+    }
+    u8 l = staerke(wunsch[0]), r = staerke(wunsch[1]);
+    if (neu || l != aktiv[0] || r != aktiv[1] || ((l || r) && runde % 10 == 0)) {
+        if (neu && (l || r) != (aktiv[0] || aktiv[1])) {
+            c2_log("XInput: Rumble %u/%u\r\n", wunsch[0], wunsch[1]);
+        }
+        neu = 0;
+        aktiv[0] = l, aktiv[1] = r;
+        c2_motor_setzen(l, r, 250); /* alle 100 ms erneuert; bleibt nichts mehr, endet es von selbst */
+    }
+}
+
+#endif
