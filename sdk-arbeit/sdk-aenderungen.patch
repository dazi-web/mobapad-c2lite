+static void motor_takt(void)
+{
+    stoss_rest_ms = stoss_rest_ms > TAKT_MS ? stoss_rest_ms - TAKT_MS : 0;
+    if (motor_rest_ms) {
+        motor_rest_ms = motor_rest_ms > TAKT_MS ? motor_rest_ms - TAKT_MS : 0;
+        if (!motor_rest_ms) {
+            mcpwm_set_duty(pwm_ch4, pwm_timer4, 0);
+            mcpwm_set_duty(pwm_ch1, pwm_timer1, 0);
+        }
+    }
+}
+
+/* Rückmeldung: kurzer Vibrationsstoß, wenn eine Verbindung neu steht (PC/Switch am USB, BLE mit abonnierten Reports,
+ * Switch per Bluetooth). Erst nach 1 s ohne diese Verbindung wieder, damit kurzes Flackern nicht rüttelt. Steht die
+ * Vibration auf 0 %, bleibt es still. */
+#define STOSS_MS 200
+static void verbunden_melden(int usb, int ble, int sw)
+{
+    static u16 weg[3] = {0xFFFF, 0xFFFF, 0xFFFF}; /* Runden ohne Verbindung */
+    const int an[3] = {usb, ble, sw};
+    int neu = 0;
+    for (int i = 0; i < 3; i++) {
+        if (an[i]) {
+            neu |= weg[i] >= 1000 / TAKT_MS;
+            weg[i] = 0;
+        } else if (weg[i] < 0xFFFF) {
+            weg[i]++;
+        }
+    }
+    if (neu && einst.vibration) {
+        c2_log("Verbunden: Vibrationsstoß (usb=%d ble=%d switch=%d)\r\n", usb, ble, sw);
+        stoss_rest_ms = 0;
+        c2_motor_setzen(70, 70, STOSS_MS);
+        stoss_rest_ms = STOSS_MS;
+    }
+}
+
+/* Ruhe wie die Werks-Firmware: am Akku nach 10 min ohne Eingabe aus (Wecken mit Home, Schieber oder USB). Am USB bleibt
+ * er an; am Ladegerät (kein PC/Switch, keine Funkverbindung) geht er nach 10 min Ruhe in den Ladeschlaf: Werbung aus,
+ * nur das Logo zeigt gedimmt den Ladezustand. Taste = wieder wach; abgezogen im Ladeschlaf = aus. Eingaben sind
+ * Tasten, Sticks, Befehle vom Werkzeug, laufende Makros/Aufnahme, Update und Lernen der Weckkennung. */
+#define AUTO_AUS_MS (10 * 60 * 1000)
+#define LADESCHLAF_MS (10 * 60 * 1000)
+static u8 ladeschlaf;
+
+void c2_eingabe_aktiv(void)
+{
+    letzte_eingabe = runde;
+}
+
+/* Gegenstelle weg (Pro Controller 2: Switch im Standby): sofort wie nach langer Ruhe, also am Akku aus, am Ladegerät
+ * Ladeschlaf (ruhe_pruefen); Home schaltet wieder ein und weckt die Switch */
+void c2_ruhe_erzwingen(void)
+{
+    u32 ms = AUTO_AUS_MS > LADESCHLAF_MS ? AUTO_AUS_MS : LADESCHLAF_MS;
+    letzte_eingabe = runde - ms / TAKT_MS;
+}
+
+void c2_ruhe_setzen(u32 s)
+{
+    letzte_eingabe = runde - s * (1000 / TAKT_MS);
+}
+
+static void ruhe_pruefen(int usb5v, int host, int funk)
+{
+    extern int c2_weck_lernt(void);
+    extern int c2_belegung_beschaeftigt(void);
+    extern void c2_ble_werbung(u8 an);
+    if (c2_ota_promille() || c2_weck_lernt() || c2_belegung_beschaeftigt()) {
+        letzte_eingabe = runde;
+    }
+    u32 ruhe = (runde - letzte_eingabe) * TAKT_MS;
+    if (!usb5v && ruhe >= AUTO_AUS_MS) {
+        ausschalten(ladeschlaf ? "Ladeschlaf, USB abgezogen" : "10 min ohne Eingabe am Akku");
+    }
+    u8 soll = usb5v && !host && !funk && ruhe >= LADESCHLAF_MS;
+    if (soll != ladeschlaf) {
+        ladeschlaf = soll;
+        c2_log("Ladeschlaf: %s\r\n", soll ? "an (Werbung aus)" : "aus");
+        c2_ble_werbung(!soll);
+    }
+}
+
+static void abfrage(void *priv)
+{
+    gpio_direction_output(IO_PORTA_07, 0); /* LED-Versorgung aus, bevor die Pins gelesen werden */
+    gpio_direction_output(IO_PORTA_08, 1);
+    u64 r = phase_lesen(PHASE_A, ARRAY_SIZE(PHASE_A), 1);
+    gpio_direction_output(IO_PORTA_08, 0);
+    r |= phase_lesen(PHASE_B, ARRAY_SIZE(PHASE_B), 0);
+    r |= phase_lesen(DIREKT, ARRAY_SIZE(DIREKT), 0);
+    c2_rgb_senden(); /* PA7 und PA8 sind hier low (siehe c2_rgb.c) */
+    /* Neu gedrückte Tasten (für Reaktiv-Licht, Ruhezeit und die Licht-Taste) */
+    u64 neu = r & ~alt_rollen;
+    u8 gruppe = 0;
+    if (neu & ((1ULL << T_A) | (1ULL << T_B) | (1ULL << T_X) | (1ULL << T_Y))) {
+        gruppe = 1;
+    } else if (neu & ((1ULL << T_L) | (1ULL << T_R) | (1ULL << T_ZL) | (1ULL << T_ZR))) {
+        gruppe = 2;
+    } else if (neu & ((1ULL << K_HOCH) | (1ULL << K_RECHTS) | (1ULL << K_RUNTER) | (1ULL << K_LINKS))) {
+        gruppe = 3;
+    } else if (neu & ~((1ULL << S_PC3) | (1ULL << S_PA3))) {
+        gruppe = 4;
+    }
+    if (neu & ~((1ULL << S_PC3) | (1ULL << S_PA3))) {
+        letzte_eingabe = runde;
+    }
+    usb_host_pruefen();
+    schieber_pruefen(r);
+    ruhe_pruefen(gpio_read(IO_PORTB_05), usb_host_runde && runde - usb_host_runde < 200 / TAKT_MS,
+                 ble_hid_is_connected() || (c2_switch_modus() && c2_switch_bt_verbunden()));
+    {
+        struct c2_anzeige_lage lage = {
+            .rettung_promille = gehalten ? (gehalten * 1000) / (RETTUNG_MS / TAKT_MS) + 1 : 0,
+            .usb_5v = gpio_read(IO_PORTB_05),
+            .usb_host = usb_host_runde && runde - usb_host_runde < 200 / TAKT_MS,
+            .ble_verbunden = ble_hid_is_connected() || (c2_switch_modus() && c2_switch_bt_verbunden()) ||
+                             c2_pro2_verbunden(),
+            .akku_prozent = c2_akku_prozent(),
+            .laedt = c2_akku_laedt(),
+            .ruhe_ms = (runde - letzte_eingabe) * TAKT_MS,
+            .druck_gruppe = gruppe,
+            .ota_promille = c2_ota_promille(),
+            .spieler = c2_pro2_verbunden() ? c2_pro2_spieler() : c2_switch_modus() ? c2_switch_spieler() : 0,
+            .ladeschlaf = ladeschlaf,
+        };
+        lage.logo_an = c2_belegung_logo(lage.logo);
+        u8 auto_maske = c2_anzeige_berechnen(&lage) | c2_belegung_led();
+        led_maske = led_manuell != C2_LED_AUTO ? led_manuell : einst.anzeige ? auto_maske : 0;
+        if (!rgb_manuell) {
+            c2_anzeige_rgb(&lage, &einst.licht);
+        }
+    }
+    leds_ausgeben();
+    motor_takt();
+    verbunden_melden(usb_host_runde && runde - usb_host_runde < 200 / TAKT_MS,
+                     !c2_switch_modus() && ble_hid_is_connected() && c2_ble_report_abonniert(),
+                     (c2_switch_modus() && c2_switch_bt_verbunden()) || c2_pro2_verbunden());
+    if (runde % (500 / TAKT_MS) == 0) {
+        akku_messen();
+    }
+
+    u64 diff = r ^ alt_rollen;
+    for (int i = 0; i < ROLLEN; i++) {
+        if (diff & (1ULL << i)) {
+            c2_log("%s %s\r\n", (r & (1ULL << i)) ? "DRUECKT" : "los    ", rollen_name(i));
+        }
+    }
+    alt_rollen = r;
+    rettung_pruefen(r);
+
+    u32 wert[N_ANALOG];
+    for (int i = 0; i < N_ANALOG; i++) {
+        wert[i] = adc_get_value(ANALOG[i].kanal);
+    }
+    for (int i = 0; i < N_STICK; i++) {
+        status_achse[i] = achse(wert[i], mitte[i]);
+        if (UMKEHREN[i]) {
+            status_achse[i] = 1023 - status_achse[i];
+        }
+        if (status_achse[i] > 512 + 120 || status_achse[i] < 512 - 120) {
+            letzte_eingabe = runde; /* Stick deutlich ausgelenkt zählt als Eingabe */
+        }
+    }
+
+    /* Belegung (Rücktasten, M, Turbo, Makros, Funktionstaste): gesendet wird aus, nicht r */
+    u16 aus_achse[N_STICK];
+    memcpy(aus_achse, status_achse, sizeof(aus_achse));
+    u64 aus = c2_belegung_takt(r, aus_achse);
+
+    /* Report: Tasten 1..20, Hat, 4 Achsen */
+    u32 tasten = (u32)(aus & 0xFFFFF);
+    report[0] = tasten;
+    report[1] = tasten >> 8;
+    report[2] = (tasten >> 16) & 0x0F;
+    report[3] = hat(aus);
+    for (int i = 0; i < N_STICK; i++) {
+        report[4 + 2 * i] = aus_achse[i];
+        report[5 + 2 * i] = aus_achse[i] >> 8;
+    }
+    /* Senden bei Änderung, sonst alle 100 ms (falls ein Report verloren ging) */
+    struct c2_switch_lage sl = {.rollen = aus, .akku = c2_akku_prozent(), .laedt = c2_akku_laedt()};
+    memcpy(sl.achsen, aus_achse, sizeof(sl.achsen));
+    int usb_host = usb_host_runde && runde - usb_host_runde < 200 / TAKT_MS;
+    if (c2_switch_modus()) {
+        /* Switch-Modus: Pro-Controller-Protokoll statt PC-Gamepad (c2_switch.c: USB, klassisches Bluetooth) */
+        c2_switch_takt(&sl);
+    } else {
+        extern void c2_xinput_bericht(u64 r, const u16 a[4], u8 *b);
+        extern void c2_xinput_takt(int host);
+        c2_xinput_bericht(aus, aus_achse, xi);
+        c2_xinput_takt(usb_host);
+    }
+    if (c2_pro2_an()) {
+        /* Pro Controller 2 per BLE an der Switch 2 (c2_pro2.c) */
+        c2_pro2_takt(&sl, usb_host);
+    }
+    if (!c2_switch_modus() && (memcmp(xi, alt_xi, sizeof(xi)) || runde % (100 / TAKT_MS) == 0) &&
+        c2_hid_senden(xi, sizeof(xi))) {
+        memcpy(alt_xi, xi, sizeof(xi));
+        if (!report_gesendet) {
+            report_gesendet = 1;
+            c2_log("USB-Gamepad (XInput): erster Bericht gesendet\r\n");
+        }
+    }
+
+    /* Bluetooth (BLE-HID, Report-ID 1): erst senden, wenn der Host die Reports abonniert hat (sonst scheitert jeder
+     * Versuch, und alle 10 ms neu zu versuchen hat den Controller beim Koppeln zum Absturz gebracht). Dann bei
+     * Änderung, sonst alle 500 ms; nach einem Fehlschlag erst beim nächsten dieser Anlässe erneut. */
+    int ble = !!ble_hid_is_connected();
+    if (ble != ble_verbunden) {
+        ble_verbunden = ble;
+        c2_log("Bluetooth: %s\r\n", ble ? "verbunden" : "getrennt");
+    }
+    int abo = ble && c2_ble_report_abonniert();
+    if (abo != ble_abonniert) {
+        ble_abonniert = abo;
+        c2_log("Bluetooth: Reports %s\r\n", abo ? "abonniert" : "nicht abonniert");
+    }
+    if (abo && !c2_switch_modus() && (memcmp(report, ble_alt, sizeof(report)) || runde % (500 / TAKT_MS) == 0)) {
+        memcpy(ble_alt, report, sizeof(report));
+        ble_hid_data_send(1, report, sizeof(report));
+    }
+
+    /* Protokoll: Sticks bei deutlicher Änderung, sonst alle 2 s */
+    int melden = (runde % (2000 / TAKT_MS)) == 0;
+    for (int i = 0; i < N_STICK; i++) {
+        if (wert[i] > alt_wert[i] + 40 || wert[i] + 40 < alt_wert[i]) {
+            melden = 1;
+        }
+    }
+    if (melden) {
+        memcpy(alt_wert, wert, sizeof(wert));
+        c2_log("ADC %s=%4lu %s=%4lu %s=%4lu %s=%4lu %s=%4lu mV(Akku-Pin)=%lu\r\n", ANALOG[0].name, wert[0],
+               ANALOG[1].name, wert[1], ANALOG[2].name, wert[2], ANALOG[3].name, wert[3], ANALOG[4].name, wert[4],
+               adc_get_voltage(AD_CH_PB4));
+    }
+
+    int usb = gpio_read(IO_PORTB_05);
+    if (usb != alt_usb) {
+        c2_log("USB-5V (PB5): %s\r\n", usb ? "an" : "aus");
+        alt_usb = usb;
+    }
+    runde++;
+}
+
+/* Stick-Mitte: Mittel aus einigen Messungen beim Start (Sticks dabei nicht berühren) */
+static void mitte_messen(void *priv)
+{
+    for (int i = 0; i < N_STICK; i++) {
+        u32 summe = 0;
+        for (int k = 0; k < 8; k++) {
+            summe += adc_get_value(ANALOG[i].kanal);
+        }
+        mitte[i] = summe / 8;
+    }
+    c2_log("Stick-Mitte: %lu %lu %lu %lu\r\n", mitte[0], mitte[1], mitte[2], mitte[3]);
+    einstellungen_laden();
+    c2_belegung_init();
+    extern void c2_weck_laden(void);
+    c2_weck_laden(); /* in jedem Modus, damit „switch diag“ auch im PC-Modus die gespeicherte Kennung zeigt */
+    sys_timer_add(NULL, abfrage, TAKT_MS);
+}
+
+void c2_eingaben_init(void)
+{
+    /* Versorgung wie die Werks-Firmware (0x8FC8): PB11 Ausgang high, High-Drive */
+    gpio_set_hd(IO_PORTB_11, 1);
+    gpio_direction_output(IO_PORTB_11, 1);
+    /* LEDs aus: gemeinsame Leitung low; High-Drive wie die Werks-Firmware */
+    gpio_set_hd(IO_PORTA_07, 1);
+    gpio_direction_output(IO_PORTA_07, 0);
+    c2_rgb_init(); /* Pulslängen der RGB-LEDs messen (PA7/PA8 low) */
+    gpio_set_hd(IO_PORTA_08, 1); /* wie die Werks-Firmware: Tastenleitung mit High-Drive */
+    gpio_direction_output(IO_PORTA_08, 0);
+    eingang(IO_PORTB_05, 0, 1);
+    for (int i = 0; i < N_ANALOG; i++) {
+        gpio_set_direction(ANALOG[i].pin, 1);
+        gpio_set_die(ANALOG[i].pin, 0);
+        gpio_set_pull_up(ANALOG[i].pin, 0);
+        gpio_set_pull_down(ANALOG[i].pin, 0);
+        adc_add_sample_ch(ANALOG[i].kanal);
+    }
+    for (int i = 0; i < N_STICK; i++) {
+        mitte[i] = 490;
+    }
+    c2_log("Eingaben: HID-Gamepad über USB, Abfrage alle %d ms\r\n", TAKT_MS);
+    /* Die ADC-Abtastung läuft im Hintergrund an; Mitte erst nach einer halben Sekunde messen */
+    sys_timeout_add(NULL, mitte_messen, 500);
+}
+
+#endif
+
+/* „rgb …“-Befehle setzen Farben direkt: Effekte pausieren (1) bzw. laufen wieder (0) */
+void c2_rgb_manuell(u8 an)
+{
+    rgb_manuell = an;
+}
+
+/* Vibrationsstärke aus den Einstellungen (0..100 %), für die Switch-Vibration */
+u8 c2_vibration_staerke(void)
+{
+    return einst.vibration;
+}
diff --git a/apps/hid/modules/c2lite/c2_log.c b/apps/hid/modules/c2lite/c2_log.c
new file mode 100644
index 0000000..df7bd31
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_log.c
@@ -0,0 +1,690 @@
+#include "app_config.h"
+#include "system/includes.h"
+#include "c2_log.h"
+#ifndef C2_STAND
+#define C2_STAND "11c"
+#endif
+#include "asm/gpio.h"
+
+#if TCFG_PC_ENABLE && (USB_DEVICE_CLASS_CONFIG & CDC_CLASS)
+#include "usb/device/cdc.h"
+
+static void antwort_ble_senden(const char *z, int n);
+
+#define PUFFER 8192 /* Zweierpotenz; lange Antworten (Makro-Liste) dürfen nicht überlaufen */
+#define TAKT_MS 20
+
+static u8 puffer[PUFFER];
+static volatile u32 schreib, lies;
+
+/* SDK-Ausgaben (printf/putchar/log_*) gehen ohne UART ins Leere. Über apps/common/debug/debug.c landen sie hier:
+ * im normalen Puffer und zusätzlich im Nachlass, der in RAM1 liegt und einen Neustart übersteht
+ * (nicht das Abschalten). So sieht man nach einem Absturz, was der Bluetooth-Stack zuletzt gemeldet hat. */
+#define NACHLASS 2048 /* Zweierpotenz */
+#define NACHLASS_MAGIC 0xC2105A11
+struct nachlass_t {
+    u32 magic;
+    u32 pos;
+    char text[NACHLASS];
+};
+/* Feste Adresse im reservierten Ende von RAM1 (sdk_ld.c: RAM1_END = 0x2EF80, UPDATA ab 0x2FF80). Die alte
+ * Adresse 0x2E000 lag im Heap1 und wurde vom Bluetooth-Stack überschrieben. */
+#define nachlass (*(struct nachlass_t *)0x2EF80)
+
+/* Absturzbericht: schreibt exception_analyze_release() (ersetzt die weak-Funktion der Bibliothek, die sonst nur
+ * cpu_reset() aufruft), bevor neu gestartet wird. Die Bibliothek gibt ihre Analyse per sputchar auf UART0 aus,
+ * der bei uns keinen Pin hat; deshalb hier Register und ein Stück Stack, ausgewertet nach dem Neustart. */
+#define ABSTURZ_MAGIC 0xC2DEAD01
+#define ABSTURZ_STACK 256
+struct absturz_t {
+    u32 magic;
+    u32 anzahl;
+    u32 sp;
+    u32 reg[11];
+    u32 stack[ABSTURZ_STACK];
+};
+#define absturz (*(struct absturz_t *)0x2F800) /* 0x2F800 + 0x45C < 0x2FF80 */
+static const u32 absturz_reg_adr[11] = { /* dieselben Register, die exception_analyze liest (debug.c in cpu.a) */
+    0x101000, 0x101048, 0x101060, 0x101064, 0x101068, 0x10106c, 0x101080, 0x101084, 0x10f0d0, 0x10f0d4, 0x1e3600,
+};
+
+void exception_analyze_release(void)
+{
+    volatile u32 merker = 0;
+    u32 adr = (u32)&merker;
+    __asm__ volatile("" : "+r"(adr)); /* Adresse für den Compiler undurchsichtig machen: sonst gilt das Lesen über
+                                       * merker hinaus als undefiniert und die Kopie wird wegoptimiert */
+    volatile u32 *sp = (volatile u32 *)adr;
+    if (absturz.magic != ABSTURZ_MAGIC) {
+        absturz.anzahl = 0;
+    }
+    absturz.magic = ABSTURZ_MAGIC;
+    absturz.anzahl++;
+    absturz.sp = (u32)sp;
+    for (int i = 0; i < 11; i++) {
+        absturz.reg[i] = *(volatile u32 *)absturz_reg_adr[i];
+    }
+    for (int i = 0; i < ABSTURZ_STACK; i++) {
+        u32 a = (u32)(sp + i);
+        absturz.stack[i] = a < 0x2EF80 ? sp[i] : 0; /* nicht in den reservierten Bereich lesen */
+    }
+    p33_soft_reset();
+    while (1);
+}
+
+/* Nach dem Neustart: Bericht ins Protokoll (mehrmals, falls der Port beim ersten Mal noch zu ist) */
+void c2_absturz_melden(void)
+{
+    if (absturz.magic != ABSTURZ_MAGIC) {
+        c2_log("Kein Absturzbericht\r\n");
+        return;
+    }
+    c2_log("ABSTURZ (Nr. %lu seit Kaltstart) sp=%08lx\r\n", absturz.anzahl, absturz.sp);
+    for (int i = 0; i < 11; i++) {
+        c2_log("  reg %06lx = %08lx\r\n", absturz_reg_adr[i], absturz.reg[i]);
+    }
+    /* Code-Adressen im Stack (Flash 0x1E00000.., ROM 0x110000..) sind Rücksprung-Kandidaten */
+    c2_log("  Code-Adressen im Stack:");
+    for (int i = 0; i < ABSTURZ_STACK; i++) {
+        u32 w = absturz.stack[i];
+        if ((w >= 0x1E00000 && w < 0x1F00000) || (w >= 0x110000 && w < 0x118000)) {
+            c2_log(" +%x:%08lx", i * 4, w);
+        }
+    }
+    c2_log("\r\n");
+}
+
+static void puffer_schreiben(const char *z, int n)
+{
+    CPU_CRITICAL_ENTER();
+    for (int i = 0; i < n; i++) {
+        puffer[schreib++ & (PUFFER - 1)] = z[i];
+    }
+    if (schreib - lies > PUFFER) {
+        lies = schreib - PUFFER; /* Ältestes verwerfen */
+    }
+    CPU_CRITICAL_EXIT();
+}
+
+/* Kopie vom Ende des letzten Nachlasses: Beim Hochfahren läuft der Puffer über, bevor der PC den Port öffnet,
+ * daher wird sie später (c2_nachlass_wiederholen) noch einmal gesendet. */
+#define NACHLASS_KOPIE 1024
+static char nachlass_kopie[NACHLASS_KOPIE];
+static u32 nachlass_kopie_n;
+static u8 ram_ueberlebt; /* Magic war beim Start da: RAM1 hat den Neustart überstanden (kein Spannungsverlust) */
+static u8 lauf_begonnen; /* .bss, beim Start 0 */
+
+/* Beim allerersten Zeichen eines Laufs das Ende des alten Nachlasses sichern und neu beginnen. Später (in
+ * c2_log_init) wäre es zu spät: die Startmeldungen hätten den alten Text im Ring schon überschrieben. */
+static void nachlass_beginnen(void)
+{
+    if (lauf_begonnen) {
+        return;
+    }
+    lauf_begonnen = 1;
+    ram_ueberlebt = nachlass.magic == NACHLASS_MAGIC;
+    if (ram_ueberlebt && nachlass.pos) {
+        u32 k = nachlass.pos < NACHLASS_KOPIE ? nachlass.pos : NACHLASS_KOPIE;
+        for (u32 i = 0; i < k; i++) {
+            nachlass_kopie[i] = nachlass.text[(nachlass.pos - k + i) & (NACHLASS - 1)];
+        }
+        nachlass_kopie_n = k;
+    }
+    nachlass.magic = NACHLASS_MAGIC;
+    nachlass.pos = 0;
+}
+
+/* Bluetooth-Mitschnitt: SDK-Zeilen ab dem ersten Kopplungsversuch (c2_mitschnitt_start), ohne BLE-/Akku-Rauschen,
+ * bis der Puffer voll ist. Auslesen mit „btlog <ab>“. */
+#define MITSCHNITT 6144
+static char mitschnitt[MITSCHNITT], mzeile[160];
+static u16 mitschnitt_n, mzeile_n;
+static u8 mitschnitt_an;
+void c2_mitschnitt_start(void)
+{
+    mitschnitt_an = 1;
+}
+static void mitschnitt_zeichen(char c)
+{
+    if (!mitschnitt_an || mitschnitt_n >= MITSCHNITT) {
+        return;
+    }
+    if (mzeile_n < sizeof(mzeile)) {
+        mzeile[mzeile_n++] = c;
+    }
+    if (c != '\n') {
+        return;
+    }
+    mzeile[mzeile_n < sizeof(mzeile) ? mzeile_n : sizeof(mzeile) - 1] = 0;
+    if (!strstr(mzeile, "BLE_HOGP") && !strstr(mzeile, "GATT") && strncmp(mzeile, "bv:", 3) &&
+        !strstr(mzeile, "write ccc") && mzeile_n > 2) {
+        u16 n = mzeile_n > MITSCHNITT - mitschnitt_n ? MITSCHNITT - mitschnitt_n : mzeile_n;
+        memcpy(mitschnitt + mitschnitt_n, mzeile, n);
+        mitschnitt_n += n;
+    }
+    mzeile_n = 0;
+}
+
+void c2_mitschnitt_umbruch(void)
+{
+    if (mzeile_n) {
+        mitschnitt_zeichen('\n');
+    }
+}
+
+int c2_sdk_zeichen(char c)
+{
+    mitschnitt_zeichen(c);
+    nachlass_beginnen();
+    if (nachlass.magic == NACHLASS_MAGIC) {
+        nachlass.text[nachlass.pos++ & (NACHLASS - 1)] = c;
+    }
+    puffer_schreiben(&c, 1);
+    return 0;
+}
+
+
+int c2_ram_ueberlebt(void)
+{
+    return ram_ueberlebt;
+}
+
+void c2_nachlass_wiederholen(void)
+{
+    if (!nachlass_kopie_n) {
+        c2_log("--- Kein Nachlass (Kaltstart) ---\r\n");
+        return;
+    }
+    c2_log("--- Nachlass des letzten Laufs (Ende, %lu Zeichen) ---\r\n", nachlass_kopie_n);
+    puffer_schreiben(nachlass_kopie, nachlass_kopie_n);
+    c2_log("\r\n--- Ende Nachlass ---\r\n");
+}
+
+/* Nachlass des letzten Laufs ausgeben (gesichert in nachlass_beginnen) */
+static void nachlass_ausgeben(void)
+{
+    nachlass_beginnen();
+    c2_nachlass_wiederholen();
+}
+
+void c2_log(const char *fmt, ...)
+{
+    va_list args;
+    va_start(args, fmt);
+    c2_log_v(fmt, args);
+    va_end(args);
+}
+
+void c2_log_v(const char *fmt, va_list args);
+/* printf/log_* des SDK (debug.c): zusätzlich in den Bluetooth-Mitschnitt */
+void c2_log_v_sdk(const char *fmt, va_list args)
+{
+    if (mitschnitt_an && mitschnitt_n < MITSCHNITT) {
+        char z[160];
+        va_list kopie;
+        va_copy(kopie, args);
+        int n = vsnprintf(z, sizeof(z), fmt, kopie);
+        va_end(kopie);
+        for (int i = 0; i < n && i < (int)sizeof(z) - 1; i++) {
+            mitschnitt_zeichen(z[i]);
+        }
+    }
+    c2_log_v(fmt, args);
+}
+
+void c2_log_v(const char *fmt, va_list args)
+{
+    char zeile[160];
+    int n = vsnprintf(zeile, sizeof(zeile), fmt, args);
+    if (n <= 0) {
+        return;
+    }
+    if (n > (int)sizeof(zeile) - 1) {
+        n = sizeof(zeile) - 1;
+    }
+    nachlass_beginnen();
+    if (nachlass.magic == NACHLASS_MAGIC) {
+        for (int i = 0; i < n; i++) {
+            nachlass.text[nachlass.pos++ & (NACHLASS - 1)] = zeile[i];
+        }
+    }
+    puffer_schreiben(zeile, n);
+    antwort_ble_senden(zeile, n);
+}
+
+/* Befehle über USB-seriell (Grundlage für eine Einstellungsseite). Zeichen kommen im Interrupt
+ * (task_pc.c: usb_cdc_wakeup), ausgewertet wird zeilenweise im Timer-Task (senden). */
+#define BEFEHL_MAX 600 /* OTA-Datenzeilen: „ota d “ + 512 Hex-Zeichen */
+static char befehl_ring[2048]; /* Zweierpotenz */
+static volatile u32 befehl_schreib, befehl_lies;
+static char befehl_zeile[BEFEHL_MAX];
+static u32 befehl_n;
+
+/* Woher kam der letzte Befehl? Antworten gehen dorthin zurück (USB-seriell immer, Bluetooth zusätzlich) */
+static volatile u8 antwort_ble;
+
+/* Bluetooth: Dienst ae40, Schreiben auf ae41 (ble_hogp.c ruft das auf, im SDK nur ein leerer weak-Platzhalter).
+ * Dieselben Textbefehle wie über USB; Antworten per Benachrichtigung auf ae42. */
+void c2_befehl_zeichen(const u8 *buf, u32 len);
+void ble_hid_transfer_channel_recieve(u8 *packet, u16 size)
+{
+    antwort_ble = 1;
+    c2_befehl_zeichen(packet, size);
+}
+int ble_hid_transfer_channel_send(u8 *packet, u16 size);
+
+/* Antwortzeile zusätzlich über Bluetooth senden, in Stücken zu 20 Byte: passt in jede MTU (Linux/bleak handelten
+ * teils nur 23 aus; eine 170-Byte-Zeile kam dann nicht an) */
+static void antwort_ble_senden(const char *z, int n)
+{
+    if (!antwort_ble) {
+        return;
+    }
+    if (strncmp(z, "ok:", 3) && strncmp(z, "fehler:", 7) && strncmp(z, "info:", 5) && strncmp(z, "status:", 7) &&
+        strncmp(z, "einstellungen:", 14) && strncmp(z, "akku:", 5) && strncmp(z, "Befehle:", 8) && strncmp(z, "motor:", 6) &&
+        strncmp(z, "switch:", 7) && strncmp(z, "log:", 4) && strncmp(z, "belegung:", 9) && strncmp(z, "turbo:", 6)) {
+        return;
+    }
+    /* Puffer voll (lange Antworten wie „log“): kurz warten und wiederholen, nicht im Interrupt */
+    for (int i = 0; i < n; i += 20) {
+        for (int v = 0; v < 50; v++) {
+            if (!ble_hid_transfer_channel_send((u8 *)z + i, n - i > 20 ? 20 : n - i) || cpu_in_irq()) {
+                break;
+            }
+            os_time_dly(1);
+        }
+    }
+}
+
+void c2_befehl_zeichen_usb(const u8 *buf, u32 len)
+{
+    antwort_ble = 0;
+    c2_befehl_zeichen(buf, len);
+}
+
+void c2_befehl_zeichen(const u8 *buf, u32 len)
+{
+    for (u32 i = 0; i < len; i++) {
+        if (befehl_schreib - befehl_lies < sizeof(befehl_ring)) {
+            befehl_ring[befehl_schreib++ & (sizeof(befehl_ring) - 1)] = buf[i];
+        }
+    }
+}
+
+u8 c2_reset_quelle_lesen(void);
+u32 c2_laufzeit_s(void);
+int ble_hid_is_connected(void);
+void go_mask_usb_updata(void);
+void c2_led_setzen(u8 maske);
+void c2_motor_setzen(u8 links, u8 rechts, u16 dauer_ms);
+void c2_motor_pins(u8 links, u8 rechts);
+void c2_motor_diag(void);
+void c2_switch_diag(void);
+void c2_einstellungen_melden(void);
+void c2_status_melden(void);
+void c2_rgb_setzen(int kette, int led, u8 r, u8 g, u8 b);
+void c2_rgb_alle(u8 r, u8 g, u8 b);
+void c2_rgb_kalibrierung_melden(void);
+void c2_rgb_messen(u32 n);
+void c2_rgb_zeit(u32 a, u32 b, u32 c, u32 d);
+void c2_rgb_manuell(u8 an);
+void c2_akku_diag(void);
+int c2_einstellung_setzen(const char *name, u32 wert);
+u8 c2_akku_prozent(void);
+u16 c2_akku_mv(void);
+
+/* Zahl (dezimal oder 0x-hex) ab *p lesen, *p danach hinter die Zahl */
+static u32 zahl_lesen(const char **p)
+{
+    while (**p == ' ') {
+        (*p)++;
+    }
+    u32 basis = 10, z = 0;
+    if ((*p)[0] == '0' && ((*p)[1] == 'x' || (*p)[1] == 'X')) {
+        basis = 16;
+        *p += 2;
+    }
+    for (;; (*p)++) {
+        char c = **p;
+        int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : 99;
+        if (d >= (int)basis) {
+            return z;
+        }
+        z = z * basis + d;
+    }
+}
+
+int c2_ota_befehl(const char *b, u32 (*zahl)(const char **));
+
+static int hex_wert_c2(char c)
+{
+    return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+}
+
+static void befehl_ausfuehren(const char *b)
+{
+    extern void c2_eingabe_aktiv(void);
+    if (*b) {
+        c2_eingabe_aktiv(); /* Werkzeug in Benutzung: nicht wegen Ruhe abschalten (leere Zeilen holen nur Antworten ab) */
+    }
+    extern int c2_belegung_befehl(const char *b);
+    extern int c2_pro2_befehl(const char *b);
+    if (c2_belegung_befehl(b) || c2_pro2_befehl(b)) {
+        return;
+    }
+    if (c2_ota_befehl(b, zahl_lesen)) {
+        return;
+    }
+    if (!strcmp(b, "hilfe") || !strcmp(b, "help")) {
+        c2_log("Befehle: info, status, einstellungen, setze <anzeige|vibration|totzone|licht|hell|logo|tempo|farbe> <wert>, rgb <...|auto>, led <maske|auto>, motor <l%%> <r%%> [ms], belegung [...], turbo [...], neustart, haenger, download-modus\r\n");
+    } else if (!strcmp(b, "info")) {
+        c2_log("info: firmware=c2lite-custom stand=" C2_STAND " gebaut=%s %s laufzeit=%lus reset=0x%02x ram=%s usb5v=%d ble=%d akku=%umV/%u%%\r\n",
+               __DATE__, __TIME__, c2_laufzeit_s(), c2_reset_quelle_lesen(), ram_ueberlebt ? "ueberlebt" : "neu",
+               gpio_read(IO_PORTB_05), !!ble_hid_is_connected(), c2_akku_mv(), c2_akku_prozent());
+    } else if (!strcmp(b, "rgb kalib")) {
+        c2_rgb_kalibrierung_melden();
+    } else if (!strncmp(b, "rgb zeit ", 9)) {
+        const char *p = b + 9;
+        u32 h0 = zahl_lesen(&p), l0 = zahl_lesen(&p), h1 = zahl_lesen(&p), l1 = zahl_lesen(&p);
+        c2_rgb_zeit(h0, l0, h1, l1);
+    } else if (!strncmp(b, "rgb messen ", 11)) {
+        const char *p = b + 11;
+        c2_rgb_messen(zahl_lesen(&p));
+    } else if (!strcmp(b, "rgb auto")) {
+        c2_rgb_manuell(0);
+        c2_log("ok: rgb auto\r\n");
+    } else if (!strcmp(b, "rgb aus")) {
+        c2_rgb_manuell(1);
+        c2_rgb_alle(0, 0, 0);
+        c2_log("ok: rgb aus\r\n");
+    } else if (!strncmp(b, "rgb ", 4)) {
+        /* rgb alle <r> <g> <b> | rgb a <nr> <r> <g> <b> | rgb b <nr> <r> <g> <b> */
+        const char *p = b + 4;
+        c2_rgb_manuell(1);
+        if (!strncmp(p, "alle ", 5)) {
+            p += 5;
+            u32 r = zahl_lesen(&p), g = zahl_lesen(&p), bl = zahl_lesen(&p);
+            c2_rgb_alle(r, g, bl);
+            c2_log("ok: rgb alle %lu %lu %lu\r\n", r, g, bl);
+        } else if ((p[0] == 'a' || p[0] == 'b') && p[1] == ' ') {
+            int kette = p[0] == 'b';
+            p += 2;
+            u32 nr = zahl_lesen(&p), r = zahl_lesen(&p), g = zahl_lesen(&p), bl = zahl_lesen(&p);
+            c2_rgb_setzen(kette, nr, r, g, bl);
+            c2_log("ok: rgb %c %lu %lu %lu %lu\r\n", kette ? 'b' : 'a', nr, r, g, bl);
+        } else {
+            c2_log("fehler: rgb alle <r> <g> <b> | rgb a|b <nr> <r> <g> <b> | rgb aus | rgb kalib\r\n");
+        }
+    } else if (!strcmp(b, "akku diag")) {
+        c2_akku_diag();
+    } else if (!strcmp(b, "status")) {
+        c2_status_melden();
+    } else if (!strcmp(b, "einstellungen")) {
+        c2_einstellungen_melden();
+    } else if (!strncmp(b, "setze ", 6)) {
+        /* setze <name> <wert>: name bis zum Leerzeichen */
+        char name[16];
+        const char *p = b + 6;
+        int i = 0;
+        while (*p && *p != ' ' && i < (int)sizeof(name) - 1) {
+            name[i++] = *p++;
+        }
+        name[i] = 0;
+        u32 w = zahl_lesen(&p);
+        int r = c2_einstellung_setzen(name, w);
+        if (r == 0) {
+            c2_log("ok: %s = %lu (gespeichert)\r\n", name, w);
+        } else {
+            c2_log("fehler: setze %s %lu (%s)\r\n", name, w, r == -1 ? "Name oder Wert ungueltig" : "Speichern fehlgeschlagen");
+        }
+    } else if (!strcmp(b, "led auto")) {
+        c2_led_setzen(0xFF);
+        c2_log("ok: led auto\r\n");
+    } else if (!strncmp(b, "led ", 4)) {
+        const char *p = b + 4;
+        u32 m = zahl_lesen(&p);
+        c2_led_setzen(m);
+        c2_log("ok: led 0x%02lx\r\n", m & 0x7F);
+    } else if (!strncmp(b, "log", 3) && (!b[3] || b[3] == ' ')) {
+        /* Ende des Protokolls (Nachlass-Ring, mit SDK-Ausgaben) zeilenweise, „log <zeichen>“, Standard 400 */
+        const char *p = b + 3;
+        u32 n = *p ? zahl_lesen(&p) : 400;
+        static char kopie[1201];
+        n = n > sizeof(kopie) - 1 ? sizeof(kopie) - 1 : n;
+        n = n > nachlass.pos ? nachlass.pos : n;
+        for (u32 i = 0; i < n; i++) {
+            kopie[i] = nachlass.text[(nachlass.pos - n + i) & (NACHLASS - 1)];
+        }
+        for (u32 i = 0, a = 0; i <= n; i++) {
+            if (i == n || kopie[i] == '\n' || i - a >= 150) {
+                u32 e = i;
+                while (e > a && (kopie[e - 1] == '\r' || kopie[e - 1] == '\n')) {
+                    e--;
+                }
+                if (e > a) {
+                    char rest = kopie[e];
+                    kopie[e] = 0;
+                    c2_log("log: %s\r\n", kopie + a);
+                    kopie[e] = rest;
+                }
+                a = i + 1;
+            }
+        }
+        c2_log("ok: log %lu\r\n", n);
+    } else if (!strncmp(b, "btlog", 5)) {
+        /* Bluetooth-Mitschnitt ab Stelle <ab>, je Aufruf bis 1000 Zeichen */
+        const char *p = b + 5;
+        u32 ab = *p ? zahl_lesen(&p) : 0, i = ab, a = ab;
+        while (i < mitschnitt_n && i < ab + 1000) {
+            if (mitschnitt[i] == '\n' || i - a >= 150) {
+                u32 e = i;
+                while (e > a && (mitschnitt[e - 1] == '\r' || mitschnitt[e - 1] == '\n')) {
+                    e--;
+                }
+                if (e > a) {
+                    char z[160];
+                    memcpy(z, mitschnitt + a, e - a);
+                    z[e - a] = 0;
+                    c2_log("log: %s\r\n", z);
+                }
+                a = i + 1;
+            }
+            i++;
+        }
+        c2_log("ok: btlog %lu von %u, weiter mit btlog %lu\r\n", ab, mitschnitt_n, a);
+    } else if (!strncmp(b, "ruhe ", 5)) {
+        /* Test: „ruhe <s>“ tut so, als gäbe es seit s Sekunden keine Eingabe (Ladeschlaf, Abschalten prüfen) */
+        extern void c2_ruhe_setzen(u32 s);
+        const char *p = b + 5;
+        u32 s = zahl_lesen(&p);
+        c2_ruhe_setzen(s);
+        c2_log("ok: ruhe %lu s\r\n", s);
+    } else if (!strcmp(b, "switch weck lernen")) {
+        extern int c2_weck_lernen(void);
+        int r = c2_weck_lernen();
+        if (r) {
+            c2_log("fehler: switch weck lernen %d\r\n", r);
+        } else {
+            c2_log("ok: switch weck lernen (30 s)\r\n");
+        }
+    } else if (!strncmp(b, "switch weck", 11)) {
+        /* Weckwerbung von Hand: „switch weck [pid] [absender]“, pid hex (2009, 2066, 2069), absender wie Linux sie
+         * anzeigt (12:34:56:78:9a:bc) oder „eigen“; die Werte bleiben bis zum Neustart für Home gesetzt */
+        extern u16 c2_weck_pid;
+        extern u8 c2_weck_absender[6];
+        extern void c2_switch_wecken(void);
+        const char *p = b + 11;
+        while (*p == ' ') {
+            p++;
+        }
+        if (!strncmp(p, "setzen", 6)) {
+            p += 6;
+            while (*p == ' ') {
+                p++;
+            }
+        }
+        if (*p && *p != ' ') {
+            u32 v = 0;
+            for (; (*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f'); p++) {
+                v = v * 16 + (*p <= '9' ? *p - '0' : *p - 'a' + 10);
+            }
+            c2_weck_pid = v;
+        }
+        while (*p == ' ') {
+            p++;
+        }
+        if (!strncmp(p, "eigen", 5)) {
+            memset(c2_weck_absender, 0, 6);
+        } else if (*p) {
+            u8 a[6];
+            int n = 0;
+            while (*p && n < 6) {
+                int h = hex_wert_c2(p[0]), l = hex_wert_c2(p[1]);
+                if (h < 0 || l < 0) {
+                    break;
+                }
+                a[n++] = h << 4 | l;
+                p += 2;
+                if (*p == ':') {
+                    p++;
+                }
+            }
+            if (n == 6) {
+                for (int i = 0; i < 6; i++) {
+                    c2_weck_absender[i] = a[5 - i]; /* Anzeige -> Leitungsreihenfolge */
+                }
+            }
+        }
+        /* „switch weck setzen <pid> <absender>“ speichert dauerhaft (Einrichten), sonst nur ausprobieren */
+        if (!strncmp(b + 11, " setzen", 7)) {
+            extern int c2_weck_speichern(void);
+            if (c2_weck_speichern()) {
+                c2_log("fehler: switch weck speichern\r\n");
+                return;
+            }
+            c2_log("ok: switch weck gespeichert %04x absender %02x:%02x:%02x:%02x:%02x:%02x\r\n", c2_weck_pid,
+                   c2_weck_absender[5], c2_weck_absender[4], c2_weck_absender[3], c2_weck_absender[2],
+                   c2_weck_absender[1], c2_weck_absender[0]);
+            return;
+        }
+        c2_switch_wecken();
+        c2_log("ok: switch weck %04x absender %02x:%02x:%02x:%02x:%02x:%02x\r\n", c2_weck_pid, c2_weck_absender[5],
+               c2_weck_absender[4], c2_weck_absender[3], c2_weck_absender[2], c2_weck_absender[1], c2_weck_absender[0]);
+    } else if (!strcmp(b, "switch diag")) {
+        c2_switch_diag();
+    } else if (!strcmp(b, "motor diag")) {
+        c2_motor_diag();
+    } else if (!strncmp(b, "motor pin ", 10)) {
+        const char *p = b + 10;
+        u32 l = zahl_lesen(&p), r = zahl_lesen(&p);
+        c2_motor_pins(!!l, !!r);
+    } else if (!strncmp(b, "motor ", 6)) {
+        const char *p = b + 6;
+        u32 l = zahl_lesen(&p), r = zahl_lesen(&p), ms = zahl_lesen(&p);
+        c2_motor_setzen(l, r, ms ? ms : 1000);
+        c2_log("ok: motor links %lu%% rechts %lu%% fuer %lu ms\r\n", l > 100 ? 100 : l, r > 100 ? 100 : r, ms ? ms : 1000);
+    } else if (!strcmp(b, "neustart")) {
+        c2_log("ok: Neustart\r\n");
+        os_time_dly(5);
+        p33_soft_reset();
+    } else if (!strcmp(b, "haenger")) {
+        /* Watchdog-Test: Interrupts aus und Endlosschleife; der Watchdog (setup.c: WDT_4S) muss neu starten */
+        c2_log("ok: haenge jetzt, Watchdog sollte nach ~4 s neu starten\r\n");
+        os_time_dly(5);
+        local_irq_disable();
+        while (1);
+    } else if (!strcmp(b, "download-modus")) {
+        extern void c2_download_springen(void);
+        c2_log("ok: ROM-Download-Modus (Licht rot)\r\n");
+        c2_download_springen();
+    } else if (b[0]) {
+        c2_log("fehler: unbekannter Befehl '%s' (hilfe)\r\n", b);
+    }
+}
+
+static void befehle_lesen(void)
+{
+    while (befehl_lies != befehl_schreib) {
+        char ch = befehl_ring[befehl_lies++ & (sizeof(befehl_ring) - 1)];
+        if (ch == '\r' || ch == '\n') {
+            befehl_zeile[befehl_n] = 0;
+            befehl_n = 0;
+            befehl_ausfuehren(befehl_zeile);
+        } else if (befehl_n < BEFEHL_MAX - 1) {
+            befehl_zeile[befehl_n++] = ch;
+        }
+    }
+}
+
+/* Im Timer-Task: cdc_write_data nutzt einen Mutex, also nicht im Interrupt. Ohne geöffneten Port gibt es
+ * 0 zurück, dann bleibt alles im Puffer. */
+static void senden(void *priv)
+{
+    u8 stueck[64];
+    befehle_lesen();
+    while (lies != schreib) {
+        u32 n = 0, l = lies;
+        while (n < sizeof(stueck) && l + n != schreib) {
+            stueck[n] = puffer[(l + n) & (PUFFER - 1)];
+            n++;
+        }
+        u32 raus = cdc_write_data(0, stueck, n);
+        if (raus == 0) {
+            return;
+        }
+        CPU_CRITICAL_ENTER();
+        if (lies == l) { /* nicht inzwischen durch Überlauf verschoben */
+            lies = l + raus;
+        }
+        CPU_CRITICAL_EXIT();
+    }
+}
+
+void c2_log_init(void)
+{
+    sys_timer_add(NULL, senden, TAKT_MS);
+    c2_log("\r\nC2 Lite Firmware v2 (Diagnose) gestartet\r\n");
+    nachlass_ausgeben();
+}
+
