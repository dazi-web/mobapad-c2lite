+#ifdef CONFIG_BOARD_C2LITE
+/* C2 Lite: Weckwerbung für die Switch 2 (c2_switch.c baut die Daten). Die Konsole scannt im Standby nach Nintendo-
+ * Herstellerdaten von einem GEKOPPELTEN Controller: Absender ist deshalb die klassische Adresse (über die gekoppelt
+ * wurde), nicht unsere abgeleitete BLE-Adresse. 20 ms Abstand, danach normale Werbung wie vorher. */
+static adv_cfg_t c2_weck_config;
+static u16 c2_weck_timer;
+static u32 c2_weck_dauer;
+static int c2_weck_status = -99;
+
+/* Ab- und Einschalten der Werbung laufen in der Bibliothek asynchron: wie wait_to_open_adv 20 ms Abstand lassen */
+static void c2_normal_an(void *priv)
+{
+    extern int c2_pro2_an(void);
+    extern void c2_pro2_werbung_an(void);
+    if (c2_pro2_an()) {
+        c2_pro2_werbung_an(); /* Pro-Controller-2-Modus: dessen Werbung, nicht die von BLE-HID */
+        return;
+    }
+    if (!hogp_con_handle) {
+        hogp_adv_config_set();
+        /* Absenderadresse ausdrücklich zurück auf die eigene BLE-Adresse: sonst bleibt die Weck-Adresse hängen
+         * (am Gerät 9c: normale Werbung lief unter der geliehenen Joy-Con-Adresse weiter) */
+        hogp_server_adv_config.set_local_addr_tag = USE_SET_LOCAL_ADDRESS_TAG;
+        hogp_server_adv_config.local_address_info[0] = 0;
+        le_controller_get_mac(hogp_server_adv_config.local_address_info + 1);
+        ble_gatt_server_set_adv_config(&hogp_server_adv_config);
+        ble_gatt_server_adv_enable(1);
+    }
+}
+
+static void c2_weck_ende(void *priv)
+{
+    c2_weck_timer = 0;
+    ble_gatt_server_adv_enable(0);
+    sys_timeout_add(NULL, c2_normal_an, 20);
+}
+
+static void c2_weck_an(void *priv)
+{
+    ble_gatt_server_set_adv_config(&c2_weck_config);
+    c2_weck_status = ble_gatt_server_adv_enable(1);
+    c2_weck_timer = sys_timeout_add(NULL, c2_weck_ende, c2_weck_dauer);
+}
+
+int c2_weck_status_lesen(void)
+{
+    return c2_weck_status;
+}
+
+int c2_weck_werbung(const u8 *daten, u8 len, u32 dauer_ms, const u8 *absender)
+{
+    if (c2_weck_timer) {
+        return -2; /* läuft schon */
+    }
+    if (hogp_con_handle) {
+        /* Während einer BLE-Verbindung wirbt die Bibliothek nicht: Wecken geht vor, Verbindung trennen */
+        ble_comm_disconnect(hogp_con_handle);
+    }
+    memset(&c2_weck_config, 0, sizeof(c2_weck_config));
+    c2_weck_config.adv_data = daten;
+    c2_weck_config.adv_data_len = len;
+    c2_weck_config.rsp_data_len = 0;
+    c2_weck_config.adv_interval = 32; /* 20 ms */
+    c2_weck_config.adv_auto_do = 0;
+    c2_weck_config.adv_type = ADV_IND;
+    c2_weck_config.adv_channel = ADV_CHANNEL_ALL;
+    c2_weck_config.set_local_addr_tag = USE_SET_LOCAL_ADDRESS_TAG;
+    c2_weck_config.local_address_info[0] = 0; /* öffentliche Adresse */
+    memcpy(c2_weck_config.local_address_info + 1, absender ? absender : bt_get_mac_addr(), 6);
+    c2_weck_dauer = dauer_ms;
+    c2_weck_status = -98;
+    ble_gatt_server_adv_enable(0);
+    c2_weck_timer = sys_timeout_add(NULL, c2_weck_an, hogp_con_handle ? 150 : 20);
+    return 0;
+}
+
+/* Weckkennung lernen: passiv scannen (Fenster = Abstand, 30 ms), Werbung und BLE-Verbindung ruhen solange. Die
+ * Berichte kommen über le_gatt_common.c bei c2_weck_bericht() an. */
+static u16 c2_lausch_timer;
+
+static void c2_lausch_an(void *priv)
+{
+    ble_op_set_scan_param(0, 48, 48);
+    c2_weck_status = ble_op_scan_enable2(1, 0);
+}
+
+void c2_weck_lauschen_ende(void)
+{
+    if (!c2_lausch_timer) {
+        return;
+    }
+    sys_timeout_del(c2_lausch_timer);
+    c2_lausch_timer = 0;
+    ble_op_scan_enable2(0, 0);
+    sys_timeout_add(NULL, c2_normal_an, 20);
+}
+
+static void c2_lausch_zeit_um(void *priv)
+{
+    extern void c2_weck_lernen_vorbei(void);
+    c2_lausch_timer = 0;
+    ble_op_scan_enable2(0, 0);
+    sys_timeout_add(NULL, c2_normal_an, 20);
+    c2_weck_lernen_vorbei();
+}
+
+/* Ladeschlaf (c2_eingaben.c): Werbung ruht; nicht während Wecken oder Lernen */
+void c2_ble_werbung(u8 an)
+{
+    if (c2_weck_timer || c2_lausch_timer || hogp_con_handle) {
+        return;
+    }
+    if (an) {
+        sys_timeout_add(NULL, c2_normal_an, 20);
+    } else {
+        ble_gatt_server_adv_enable(0);
+    }
+}
+
+int c2_weck_lauschen(u32 dauer_ms)
+{
+    if (c2_weck_timer || c2_lausch_timer) {
+        return -2;
+    }
+    if (hogp_con_handle) {
+        ble_comm_disconnect(hogp_con_handle);
+    }
+    ble_gatt_server_adv_enable(0);
+    c2_weck_status = -97;
+    sys_timeout_add(NULL, c2_lausch_an, hogp_con_handle ? 150 : 20);
+    c2_lausch_timer = sys_timeout_add(NULL, c2_lausch_zeit_um, dauer_ms);
+    return 0;
+}
+#endif
