+static void eingang(u32 pin, int pull_up, int pull_down)
+{
+    if (pin >= IO_PORT_PR_00) {
+        u8 pr = pin - IO_PORT_PR_00;
+        rtc_port_pr_in(pr);
+        rtc_port_pr_die(pr, 1);
+        rtc_port_pr_pu(pr, pull_up);
+        rtc_port_pr_pd(pr, pull_down);
+        return;
+    }
+    gpio_set_direction(pin, 1);
+    gpio_set_die(pin, 1);
+    gpio_set_pull_up(pin, pull_up);
+    gpio_set_pull_down(pin, pull_down);
+}
+
+/* Liest eine Phase und setzt die Rollen-Bits der gedrückten Tasten */
+static u64 phase_lesen(const struct taste *t, int n, int gedrueckt_high)
+{
+    for (int i = 0; i < n; i++) {
+        eingang(t[i].pin, !gedrueckt_high, gedrueckt_high);
+    }
+    for (volatile int w = 0; w < 1000; w++) { /* Pulls und PA8 einschwingen lassen (einige µs) */
+    }
+    u64 bits = 0;
+    for (int i = 0; i < n; i++) {
+        int pegel = t[i].pin >= IO_PORT_PR_00 ? rtc_port_pr_read(t[i].pin - IO_PORT_PR_00) : gpio_read(t[i].pin);
+        if (!!pegel == gedrueckt_high) {
+            bits |= 1ULL << t[i].rolle;
+        }
+    }
+    return bits;
+}
+
+static const char *rollen_name(int r)
+{
+    static const struct taste *const LISTEN[] = {PHASE_A, PHASE_B, DIREKT};
+    static const int N[] = {ARRAY_SIZE(PHASE_A), ARRAY_SIZE(PHASE_B), ARRAY_SIZE(DIREKT)};
+    for (int l = 0; l < 3; l++) {
+        for (int i = 0; i < N[l]; i++) {
+            if (LISTEN[l][i].rolle == r) {
+                return LISTEN[l][i].name;
+            }
+        }
+    }
+    return "?";
+}
+
+/* Steuerkreuz -> Hat (0 = hoch, im Uhrzeigersinn in 45°-Schritten, 8 = Mitte) */
+static u8 hat(u64 r)
+{
+    int h = !!(r & (1ULL << K_HOCH)), rt = !!(r & (1ULL << K_RECHTS)), u = !!(r & (1ULL << K_RUNTER)),
+        l = !!(r & (1ULL << K_LINKS));
+    if (h && rt) return 1;
+    if (rt && u) return 3;
+    if (u && l) return 5;
+    if (l && h) return 7;
+    if (h) return 0;
+    if (rt) return 2;
+    if (u) return 4;
+    if (l) return 6;
+    return 8;
+}
+
+/* Rohwert -> 0..1023 um die beim Start gemessene Mitte, mit kleiner Totzone */
+static u16 achse(u32 roh, u32 m)
+{
+    int d = (int)roh - (int)m;
+    if (d > -(int)einst.totzone && d < (int)einst.totzone) {
+        return 512;
+    }
+    int v = 512 + d * 511 / STICK_HUB;
+    return v < 0 ? 0 : v > 1023 ? 1023 : v;
+}
+
+/* Failsafe: Home + Minus 5 s halten, während USB-5V anliegt -> ROM-Download-Modus (BR23 UBOOT1.00 am USB), ohne
+ * ESP32-Schlüsselsender. go_mask_usb_updata() (msd_upgrade.c) setzt die ROM-Boot-Markierung
+ * nvram_set_boot_state(UPGRADE_USB_SOFT_KEY) und löst einen System-Reset aus. Nur mit USB, damit der Chip nicht ohne
+ * Host im Download-Modus hängt (zurück dann nur über Strom aus). */
+#define RETTUNG_TASTEN ((1ULL << T_HOME) | (1ULL << T_MINUS))
+#define RETTUNG_MS 5000
+void go_mask_usb_updata(void);
+static u32 gehalten; /* Runden, die Home + Minus schon gehalten sind (auch für die Anzeige) */
+static void rettung_pruefen(u64 r)
+{
+    if ((r & RETTUNG_TASTEN) != RETTUNG_TASTEN || !gpio_read(IO_PORTB_05)) {
+        gehalten = 0;
+        return;
+    }
+    gehalten++;
+    if (gehalten == 1000 / TAKT_MS) {
+        c2_log("Rettung: Home + Minus weiter halten -> Download-Modus in 4 s\r\n");
+    }
+    if (gehalten >= RETTUNG_MS / TAKT_MS) {
+        c2_log("Rettung: starte in den ROM-Download-Modus (Licht rot)\r\n");
+        c2_download_springen();
+    }
+}
