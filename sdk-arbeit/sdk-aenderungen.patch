+#if defined(CONFIG_BOARD_C2LITE) && (USER_SUPPORT_PROFILE_HID==1)
+/* C2 Lite: SDP-Einträge wie beim Pro Controller (Attribute wie in der Werks-Firmware und beim Original: HID-Unterklasse
+ * Gamepad, keine Boot-Geräte-Attribute, PnP 057E:2009). Gebaut mit einem kleinen Kodierer statt fester Bytefolgen. */
+static u8 *sdp_u8(u8 *p, u8 t, u32 v, u8 n)
+{
+    *p++ = t;
+    while (n--) {
+        *p++ = v >> (8 * n);
+    }
+    return p;
+}
+#define SDP_ID(p, id)   p = sdp_u8(p, 0x09, id, 2)
+#define SDP_U8(p, v)    p = sdp_u8(p, 0x08, v, 1)
+#define SDP_U16(p, v)   p = sdp_u8(p, 0x09, v, 2)
+#define SDP_U32(p, v)   p = sdp_u8(p, 0x0A, v, 4)
+#define SDP_UUID(p, v)  p = sdp_u8(p, 0x19, v, 2)
+#define SDP_BOOL(p, v)  p = sdp_u8(p, 0x28, v, 1)
+static u8 *sdp_text(u8 *p, const void *t, u8 n)
+{
+    *p++ = 0x25;
+    *p++ = n;
+    memcpy(p, t, n);
+    return p + n;
+}
+/* Folge mit 16-Bit-Länge: auf() merkt den Anfang, zu() trägt die Länge nach */
+static u8 *sdp_auf(u8 **p)
+{
+    u8 *a = *p;
+    *p += 3;
+    a[0] = 0x36;
+    return a;
+}
+static void sdp_zu(u8 *a, u8 *p)
+{
+    u16 n = p - a - 3;
+    a[1] = n >> 8, a[2] = n;
+}
+#define TEXT(p, s) p = sdp_text(p, s, sizeof(s) - 1)
+
+/* Innere Folgen mit 8-Bit-Länge umschreiben (0x36 -> 0x35, wenn < 256 Byte), die äußere bleibt 0x36: so kodiert es
+ * auch der echte Pro Controller. Linux liest beides, die Switch trennt sonst nach ~250 ms. In place, liefert Länge. */
+static u16 sdp_kompakt(u8 *p, u16 n, int aussen)
+{
+    u8 *q = p, *ende = p + n;
+    while (p < ende) {
+        u8 t = *p;
+        if (t == 0x36) {
+            u16 l = p[1] << 8 | p[2];
+            u16 neu = sdp_kompakt(p + 3, l, 0);
+            if (!aussen && neu < 256) {
+                q[0] = 0x35, q[1] = neu;
+                memmove(q + 2, p + 3, neu);
+                q += 2 + neu;
+            } else {
+                q[0] = 0x36, q[1] = neu >> 8, q[2] = neu;
+                memmove(q + 3, p + 3, neu);
+                q += 3 + neu;
+            }
+            p += 3 + l;
+            continue;
+        }
+        /* sonst: Kopf + Daten unverändert (Größe 0..4 fest, 5/6 mit 1/2 Längenbytes) */
+        u8 sz = t & 7, typ = t >> 3;
+        u16 l = typ == 0 ? 0 : sz < 5 ? (1 << sz) : sz == 5 ? p[1] : (p[1] << 8 | p[2]);
+        u16 k = 1 + (sz == 5 ? 1 : sz == 6 ? 2 : 0) + l;
+        memmove(q, p, k);
+        q += k, p += k;
+    }
+    return q - (ende - n);
+}
+
+static u16 c2_sdp_hid(u8 *buf, const u8 *desk, u16 desk_len)
+{
+    u8 *p = buf, *f, *g, *h;
+    f = sdp_auf(&p);
+    SDP_ID(p, 0x0000), SDP_U32(p, 0x00010000);
+    SDP_ID(p, 0x0001), g = sdp_auf(&p), SDP_UUID(p, 0x1124), sdp_zu(g, p);
+    SDP_ID(p, 0x0004), g = sdp_auf(&p);
+    h = sdp_auf(&p), SDP_UUID(p, 0x0100), SDP_U16(p, 0x0011), sdp_zu(h, p);
+    h = sdp_auf(&p), SDP_UUID(p, 0x0011), sdp_zu(h, p);
+    sdp_zu(g, p);
+    SDP_ID(p, 0x0005), g = sdp_auf(&p), SDP_UUID(p, 0x1002), sdp_zu(g, p);
+    SDP_ID(p, 0x0006), g = sdp_auf(&p), SDP_U16(p, 0x656E), SDP_U16(p, 0x006A), SDP_U16(p, 0x0100), sdp_zu(g, p);
+    SDP_ID(p, 0x0009), g = sdp_auf(&p), h = sdp_auf(&p), SDP_UUID(p, 0x1124), SDP_U16(p, 0x0101), sdp_zu(h, p), sdp_zu(g, p);
+    SDP_ID(p, 0x000D), g = sdp_auf(&p), h = sdp_auf(&p);
+    {
+        u8 *i = sdp_auf(&p);
+        SDP_UUID(p, 0x0100), SDP_U16(p, 0x0013), sdp_zu(i, p);
+        i = sdp_auf(&p), SDP_UUID(p, 0x0011), sdp_zu(i, p);
+    }
+    sdp_zu(h, p), sdp_zu(g, p);
+    SDP_ID(p, 0x0100), TEXT(p, "Wireless Gamepad");
+    SDP_ID(p, 0x0101), TEXT(p, "Gamepad");
+    SDP_ID(p, 0x0102), TEXT(p, "Nintendo");
+    SDP_ID(p, 0x0201), SDP_U16(p, 0x0111);  /* HID-Parser 1.11 */
+    SDP_ID(p, 0x0202), SDP_U8(p, 0x08);     /* Unterklasse Gamepad */
+    SDP_ID(p, 0x0203), SDP_U8(p, 0x21);     /* Ländercode */
+    SDP_ID(p, 0x0204), SDP_BOOL(p, 1);      /* Virtual Cable */
+    SDP_ID(p, 0x0205), SDP_BOOL(p, 1);      /* Controller verbindet selbst neu */
+    SDP_ID(p, 0x0206), g = sdp_auf(&p), h = sdp_auf(&p), SDP_U8(p, 0x22), p = sdp_text(p, desk, desk_len), sdp_zu(h, p), sdp_zu(g, p);
+    SDP_ID(p, 0x0207), g = sdp_auf(&p), h = sdp_auf(&p), SDP_U16(p, 0x0409), SDP_U16(p, 0x0100), sdp_zu(h, p), sdp_zu(g, p);
+    SDP_ID(p, 0x0209), SDP_BOOL(p, 1);      /* Akku */
+    SDP_ID(p, 0x020A), SDP_BOOL(p, 1);      /* Remote Wake */
+    SDP_ID(p, 0x020C), SDP_U16(p, 0x0C80);  /* Supervision-Timeout */
+    SDP_ID(p, 0x020D), SDP_BOOL(p, 0);      /* Normally Connectable */
+    SDP_ID(p, 0x020E), SDP_BOOL(p, 0);      /* Boot-Gerät */
+    sdp_zu(f, p);
+    return sdp_kompakt(buf, p - buf, 1);
+}
+
+static u16 c2_sdp_pnp(u8 *buf)
+{
+    u8 *p = buf, *f, *g, *h;
+    f = sdp_auf(&p);
+    SDP_ID(p, 0x0000), SDP_U32(p, 0x00010001);
+    SDP_ID(p, 0x0001), g = sdp_auf(&p), SDP_UUID(p, 0x1200), sdp_zu(g, p);
+    SDP_ID(p, 0x0004), g = sdp_auf(&p);
+    h = sdp_auf(&p), SDP_UUID(p, 0x0100), SDP_U16(p, 0x0001), sdp_zu(h, p);
+    h = sdp_auf(&p), SDP_UUID(p, 0x0001), sdp_zu(h, p);
+    sdp_zu(g, p);
+    SDP_ID(p, 0x0006), g = sdp_auf(&p), SDP_U16(p, 0x656E), SDP_U16(p, 0x006A), SDP_U16(p, 0x0100), sdp_zu(g, p);
+    SDP_ID(p, 0x0009), g = sdp_auf(&p), h = sdp_auf(&p), SDP_UUID(p, 0x1200), SDP_U16(p, 0x0100), sdp_zu(h, p), sdp_zu(g, p);
+    SDP_ID(p, 0x0100), TEXT(p, "Wireless Gamepad PnP Server");
+    SDP_ID(p, 0x0101), TEXT(p, "Gamepad");
+    SDP_ID(p, 0x0200), SDP_U16(p, 0x0103);  /* Device-ID-Spezifikation 1.3 */
+    SDP_ID(p, 0x0201), SDP_U16(p, 0x057E);  /* Nintendo */
+    SDP_ID(p, 0x0202), SDP_U16(p, 0x2009);  /* Pro Controller */
+    SDP_ID(p, 0x0203), SDP_U16(p, 0x0001);
+    SDP_ID(p, 0x0204), SDP_BOOL(p, 1);      /* primärer Eintrag */
+    SDP_ID(p, 0x0205), SDP_U16(p, 0x0002);  /* Hersteller-ID nach USB-IF */
+    sdp_zu(f, p);
+    return sdp_kompakt(buf, p - buf, 1);
+}
+#endif
