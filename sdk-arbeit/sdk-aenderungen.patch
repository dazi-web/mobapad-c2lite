+           JL_MCPWM->TMR4_CNT, JL_MCPWM->TMR4_PR, JL_MCPWM->CH4_CON0, JL_MCPWM->CH4_CON1, JL_MCPWM->CH4_CMPH,
+           JL_MCPWM->CH4_CMPL);
+    c2_log("motor: t1 con=%08lx cnt=%lu pr=%lu | ch1 con0=%08lx con1=%08lx h=%lu l=%lu\r\n", JL_MCPWM->TMR1_CON,
+           JL_MCPWM->TMR1_CNT, JL_MCPWM->TMR1_PR, JL_MCPWM->CH1_CON0, JL_MCPWM->CH1_CON1, JL_MCPWM->CH1_CMPH,
+           JL_MCPWM->CH1_CMPL);
+    c2_log("motor: pa9 dir=%lu out=%lu die=%lu | pb2 dir=%lu out=%lu die=%lu\r\n", (JL_PORTA->DIR >> 9) & 1,
+           (JL_PORTA->OUT >> 9) & 1, (JL_PORTA->DIE >> 9) & 1, (JL_PORTB->DIR >> 2) & 1, (JL_PORTB->OUT >> 2) & 1,
+           (JL_PORTB->DIE >> 2) & 1);
+}
