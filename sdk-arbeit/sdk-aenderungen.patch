+/* LEDs: 7 Stück an den Tastenpins (an = low), Versorgung über PA7 (high). Wie die Werks-Firmware im Zeitmultiplex
+ * mit der Tastenabfrage: vor dem Lesen PA7 low, danach die LED-Pins als Ausgänge setzen und PA7 high.
+ * Bit n der Maske = LED_PIN[n] (Reihenfolge der Werks-Tabelle). Am Gerät geprüft: 0x04..0x20 = Spieler 1..4,
+ * 0x01/0x02/0x40 nicht sichtbar. */
+static const u32 LED_PIN[7] = {IO_PORTC_00, IO_PORTC_01, IO_PORTC_05, IO_PORTC_04, IO_PORTC_03, IO_PORTC_02, IO_PORTA_12};
+static volatile u8 led_maske;   /* diese Runde ausgegeben */
+static volatile u8 led_manuell; /* vom Befehl „led“ gesetzt; C2_LED_AUTO = Zustandsanzeige */
+#define C2_LED_AUTO 0xFF
+
+/* maske 0..0x7F: fest (überschreibt die Zustandsanzeige), 0xFF: zurück zur Zustandsanzeige */
+void c2_led_setzen(u8 maske)
+{
+    led_manuell = maske == C2_LED_AUTO ? C2_LED_AUTO : maske & 0x7F;
+}
+
+/* Akku (am Gerät gemessen, 30.10.):
+ *   Akkuspannung über den internen Kanal AD_CH_VBAT (×4): stimmt im Akkubetrieb und am Kabel (4172 / 4088 mV).
+ *   PB4 (1:2-Teiler): im Akkubetrieb = VBAT/2 (2077 mV); am Kabel zieht der Lade-IC PB4 herunter, solange er lädt
+ *   (1418 mV), und lässt es los, wenn der Akku voll ist (dann ~2190 mV). Daraus „lädt“ / „voll“.
+ * Die Werks-Stufen (PB4 <= 1700/1750/1800/1980) passen nicht zu diesen Werten und werden nicht benutzt. */
+static u16 akku_mv;   /* Akkuspannung (VBAT), gleitend gemittelt */
+static u16 pb4_mv;    /* Pin-Spannung PB4, gleitend gemittelt */
+
+static void akku_messen(void)
+{
+    u16 v = adc_get_voltage(AD_CH_VBAT) * 4, p = adc_get_voltage(AD_CH_PB4);
+    akku_mv = akku_mv ? (akku_mv * 7 + v) / 8 : v;
+    pb4_mv = pb4_mv ? (pb4_mv * 7 + p) / 8 : p;
+}
+
+/* Lädt der Akku gerade? Nur am USB: PB4 deutlich unter VBAT/2 */
+u8 c2_akku_laedt(void)
+{
+    return gpio_read(IO_PORTB_05) && akku_mv && pb4_mv * 2 + 400 < akku_mv;
+}
+
+/* LiPo-Kennlinie grob (Ruhespannung): 3,40 V = 0 %, 4,15 V = 100 % */
+u8 c2_akku_prozent(void)
+{
+    static const u16 MV[] = {3400, 3600, 3700, 3750, 3800, 3850, 3900, 3950, 4000, 4050, 4100, 4150};
+    static const u8 PROZENT[] = {0, 8, 15, 25, 35, 45, 55, 65, 75, 85, 95, 100};
+    u16 v = akku_mv;
+    if (!v) {
+        return 0;
+    }
+    if (v <= MV[0]) {
+        return 1;
+    }
+    for (int i = 1; i < (int)(sizeof(MV) / sizeof(MV[0])); i++) {
+        if (v < MV[i]) {
+            return PROZENT[i - 1] + (u32)(PROZENT[i] - PROZENT[i - 1]) * (v - MV[i - 1]) / (MV[i] - MV[i - 1]);
+        }
+    }
+    return 100;
+}
+
+/* Fehlersuche Akkumessung: Einstellungen von PB4 (und PB11, Versorgung) und Rohwerte */
+void c2_akku_diag(void)
+{
+    c2_log("akku: vbat=%umV pb4=%umV usb5v=%d laedt=%d prozent=%u\r\n", akku_mv, pb4_mv, gpio_read(IO_PORTB_05),
+           c2_akku_laedt(), c2_akku_prozent());
+    c2_log("akku: pb4 dir=%lu die=%lu dieh=%lu pu=%lu pd=%lu out=%lu | pb11 dir=%lu out=%lu hd=%lu | roh=%u mv=%u vbat=%u\r\n",
+           (JL_PORTB->DIR >> 4) & 1, (JL_PORTB->DIE >> 4) & 1, (JL_PORTB->DIEH >> 4) & 1, (JL_PORTB->PU >> 4) & 1,
+           (JL_PORTB->PD >> 4) & 1, (JL_PORTB->OUT >> 4) & 1, (JL_PORTB->DIR >> 11) & 1, (JL_PORTB->OUT >> 11) & 1,
+           (JL_PORTB->HD >> 11) & 1, adc_get_value(AD_CH_PB4), adc_get_voltage(AD_CH_PB4), adc_get_voltage(AD_CH_VBAT) * 4);
+}
