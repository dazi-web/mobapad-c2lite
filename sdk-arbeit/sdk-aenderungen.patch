+#define PRO2_H_ANTWORT_2_CCC 0x001f
+#define PRO2_H_ANTWORT_2_BESCHR 0x0020
+#define PRO2_H_MELDUNG_22 0x0022
+#define PRO2_H_MELDUNG_22_CCC 0x0023
+#define PRO2_H_MELDUNG_22_BESCHR 0x0024
+#define PRO2_H_MELDUNG_26 0x0026
+#define PRO2_H_MELDUNG_26_CCC 0x0027
+#define PRO2_H_MELDUNG_26_BESCHR 0x0028
+#define PRO2_H_AUSGABE_2A 0x002a
+#define PRO2_H_KOPFHOERER_AUS 0x002c
+#define PRO2_H_KOPFHOERER_EIN 0x002e
+#define PRO2_H_KOPFHOERER_EIN_CCC 0x002f
+#define PRO2_H_KOPFHOERER_EIN_BESCHR 0x0030
