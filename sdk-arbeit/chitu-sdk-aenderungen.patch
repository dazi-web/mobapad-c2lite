+_Static_assert(__builtin_offsetof(struct s1_ctx, konsole) == 0x5c, "ctx konsole");
+_Static_assert(__builtin_offsetof(struct s1_ctx, konsole_bch) == 0x62, "ctx bch");
+_Static_assert(__builtin_offsetof(struct s1_ctx, rahmen) == 0x74 && sizeof(struct s1_ctx) == 0x78, "ctx");
