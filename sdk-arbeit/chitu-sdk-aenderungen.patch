+
+/* Zahl (dezimal oder 0x-hex) ab *p lesen, *p danach hinter die Zahl */
+static u32 zahl_lesen(const char **p)
+{
+    while (**p == ' ') {
+        (*p)++;
+    }
+    u32 basis = 10, z = 0;
+    if ((*p)[0] == '0' && ((*p)[1] == 'x' || (*p)[1] == 'X')) {
+        basis = 16;
+        *p += 2;
+    }
+    for (;; (*p)++) {
+        char c = **p;
+        int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : 99;
+        if (d >= (int)basis) {
+            return z;
+        }
+        z = z * basis + d;
+    }
+}
+
+int c2_ota_befehl(const char *b, u32 (*zahl)(const char **));
+
+static int hex_wert_c2(char c)
+{
+    return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+}
+
+static void befehl_ausfuehren(const char *b)
+{
+    extern void c2_eingabe_aktiv(void);
+#if C2_CHITU
+    SPUR_APP(0x30);
+    for (int i = 0; *b && i < 8; i++) { /* leere Zeilen (Antworten abholen) überschreiben den Befehl nicht */
+        SPUR.befehl[i] = b[i];
+        if (!b[i]) {
+            break;
+        }
+    }
+#endif
+    if (*b) {
+        c2_eingabe_aktiv(); /* Werkzeug in Benutzung: nicht wegen Ruhe abschalten (leere Zeilen holen nur Antworten ab) */
+    }
+    extern int c2_belegung_befehl(const char *b);
+    extern int c2_pro2_befehl(const char *b);
+    if (c2_belegung_befehl(b) || c2_pro2_befehl(b)) {
+        return;
+    }
+    if (c2_ota_befehl(b, zahl_lesen)) {
+        return;
+    }
+    if (!strcmp(b, "hilfe") || !strcmp(b, "help")) {
+        c2_log("Befehle: info, status, einstellungen, setze <anzeige|vibration|totzone|licht|hell|logo|tempo|farbe> <wert>, rgb <...|auto>, led <maske|auto>, motor <l%%> <r%%> [ms], belegung [...], turbo [...], neustart, haenger, download-modus\r\n");
+    } else if (!strcmp(b, "info")) {
+#if C2_CHITU && C2_CHITU_STICKS
+#define C2_GERAET_FELD " geraet=chitu"
+#elif C2_CHITU
+/* Generalprobe-Bau (ohne Stick-Rahmen) läuft auf dem C2 Lite: eigene Kennung, damit die Gerätetyp-Prüfung im Werkzeug
+ * ihn der C2-Lite-Platine zuordnet (Probe drauf und 16o zurück erlaubt, Probe aufs Chitu nicht) */
+#define C2_GERAET_FELD " geraet=chitu-probe"
+#else
+#define C2_GERAET_FELD ""
+#endif
+        /* geraet= direkt hinter stand= (CRc): die Zeile ist fast 160 Zeichen lang, am Ende wurde es abgeschnitten */
+        c2_log("info: firmware=c2lite-custom stand=" C2_STAND C2_GERAET_FELD " gebaut=%s %s laufzeit=%lus reset=0x%02x ram=%s usb5v=%d ble=%d akku=%umV/%u%%\r\n",
+               __DATE__, __TIME__, c2_laufzeit_s(), c2_reset_quelle_lesen(), ram_ueberlebt ? "ueberlebt" : "neu",
+               gpio_read(IO_PORTB_05), !!ble_hid_is_connected(), c2_akku_mv(), c2_akku_prozent());
+    } else if (!strcmp(b, "rgb kalib")) {
+        c2_rgb_kalibrierung_melden();
+    } else if (!strncmp(b, "rgb zeit ", 9)) {
+        const char *p = b + 9;
+        u32 h0 = zahl_lesen(&p), l0 = zahl_lesen(&p), h1 = zahl_lesen(&p), l1 = zahl_lesen(&p);
+        c2_rgb_zeit(h0, l0, h1, l1);
+    } else if (!strncmp(b, "rgb messen ", 11)) {
+        const char *p = b + 11;
+        c2_rgb_messen(zahl_lesen(&p));
+    } else if (!strcmp(b, "rgb auto")) {
+        c2_rgb_manuell(0);
+        c2_log("ok: rgb auto\r\n");
+    } else if (!strcmp(b, "rgb aus")) {
+        c2_rgb_manuell(1);
+        c2_rgb_alle(0, 0, 0);
+        c2_log("ok: rgb aus\r\n");
+    } else if (!strncmp(b, "rgb ", 4)) {
+        /* rgb alle <r> <g> <b> | rgb a <nr> <r> <g> <b> | rgb b <nr> <r> <g> <b> */
+        const char *p = b + 4;
+        c2_rgb_manuell(1);
+        if (!strncmp(p, "alle ", 5)) {
+            p += 5;
+            u32 r = zahl_lesen(&p), g = zahl_lesen(&p), bl = zahl_lesen(&p);
+            c2_rgb_alle(r, g, bl);
+            c2_log("ok: rgb alle %lu %lu %lu\r\n", r, g, bl);
+        } else if ((p[0] == 'a' || p[0] == 'b') && p[1] == ' ') {
+            int kette = p[0] == 'b';
+            p += 2;
+            u32 nr = zahl_lesen(&p), r = zahl_lesen(&p), g = zahl_lesen(&p), bl = zahl_lesen(&p);
+            c2_rgb_setzen(kette, nr, r, g, bl);
+            c2_log("ok: rgb %c %lu %lu %lu %lu\r\n", kette ? 'b' : 'a', nr, r, g, bl);
+        } else {
+            c2_log("fehler: rgb alle <r> <g> <b> | rgb a|b <nr> <r> <g> <b> | rgb aus | rgb kalib\r\n");
+        }
+    } else if (!strcmp(b, "akku diag")) {
+        c2_akku_diag();
+    } else if (!strcmp(b, "status")) {
+        c2_status_melden();
+    } else if (!strcmp(b, "einstellungen")) {
+        c2_einstellungen_melden();
+    } else if (!strncmp(b, "setze ", 6)) {
+        /* setze <name> <wert>: name bis zum Leerzeichen */
+        char name[16];
+        const char *p = b + 6;
+        int i = 0;
+        while (*p && *p != ' ' && i < (int)sizeof(name) - 1) {
+            name[i++] = *p++;
+        }
+        name[i] = 0;
+        u32 w = zahl_lesen(&p);
+        int r = c2_einstellung_setzen(name, w);
+        if (r == 0) {
+            c2_log("ok: %s = %lu (gespeichert)\r\n", name, w);
+        } else {
+            c2_log("fehler: setze %s %lu (%s)\r\n", name, w, r == -1 ? "Name oder Wert ungueltig" : "Speichern fehlgeschlagen");
+        }
+    } else if (!strcmp(b, "led auto")) {
+        c2_led_setzen(0xFF);
+        c2_log("ok: led auto\r\n");
+    } else if (!strncmp(b, "led ", 4)) {
+        const char *p = b + 4;
+        u32 m = zahl_lesen(&p);
+        c2_led_setzen(m);
+        c2_log("ok: led 0x%02lx\r\n", m & 0x7F);
+    } else if (!strncmp(b, "log", 3) && (!b[3] || b[3] == ' ')) {
+        /* Ende des Protokolls (Nachlass-Ring, mit SDK-Ausgaben) zeilenweise, „log <zeichen>“, Standard 400 */
+        const char *p = b + 3;
+        u32 n = *p ? zahl_lesen(&p) : 400;
+        static char kopie[1201];
+        n = n > sizeof(kopie) - 1 ? sizeof(kopie) - 1 : n;
+        n = n > nachlass.pos ? nachlass.pos : n;
+        for (u32 i = 0; i < n; i++) {
+            kopie[i] = nachlass.text[(nachlass.pos - n + i) & (NACHLASS - 1)];
+        }
+        for (u32 i = 0, a = 0; i <= n; i++) {
+            if (i == n || kopie[i] == '\n' || i - a >= 150) {
+                u32 e = i;
+                while (e > a && (kopie[e - 1] == '\r' || kopie[e - 1] == '\n')) {
+                    e--;
+                }
+                if (e > a) {
+                    char rest = kopie[e];
+                    kopie[e] = 0;
+                    c2_log("log: %s\r\n", kopie + a);
+                    kopie[e] = rest;
+                }
+                a = i + 1;
+            }
+        }
+        c2_log("ok: log %lu\r\n", n);
+    } else if (!strncmp(b, "btlog", 5)) {
+        /* Bluetooth-Mitschnitt ab Stelle <ab>, je Aufruf bis 1000 Zeichen */
+        const char *p = b + 5;
+        u32 ab = *p ? zahl_lesen(&p) : 0, i = ab, a = ab;
+        while (i < mitschnitt_n && i < ab + 1000) {
+            if (mitschnitt[i] == '\n' || i - a >= 150) {
+                u32 e = i;
+                while (e > a && (mitschnitt[e - 1] == '\r' || mitschnitt[e - 1] == '\n')) {
+                    e--;
+                }
+                if (e > a) {
+                    char z[160];
+                    memcpy(z, mitschnitt + a, e - a);
+                    z[e - a] = 0;
+                    c2_log("log: %s\r\n", z);
+                }
+                a = i + 1;
+            }
+            i++;
+        }
+        c2_log("ok: btlog %lu von %u, weiter mit btlog %lu\r\n", ab, mitschnitt_n, a);
+    } else if (!strncmp(b, "ruhe ", 5)) {
+        /* Test: „ruhe <s>“ tut so, als gäbe es seit s Sekunden keine Eingabe (Ladeschlaf, Abschalten prüfen) */
+        extern void c2_ruhe_setzen(u32 s);
+        const char *p = b + 5;
+        u32 s = zahl_lesen(&p);
+        c2_ruhe_setzen(s);
+        c2_log("ok: ruhe %lu s\r\n", s);
+    } else if (!strcmp(b, "switch1 weck test")) {
+        /* Stufe 15: Weckcode-Berechnung gegen die Beispiele der Protokollbeschreibung */
+        extern int c2_s1_weck_selbsttest(void);
+        int n = c2_s1_weck_selbsttest();
+        c2_log("%s: switch1 weck test %d von 4\r\n", n == 4 ? "ok" : "fehler", n);
+    } else if (!strcmp(b, "switch1 weck info")) {
+        extern int c2_s1_weck_info(void);
+        c2_log(c2_s1_weck_info() ? "ok: switch1 weck info\r\n" : "fehler: switch1 weck info: keine Konsole gekoppelt\r\n");
+    } else if (!strcmp(b, "switch1 weck senden") || !strncmp(b, "switch1 weck dauer", 18) ||
+               !strcmp(b, "switch1 weck stopp")) {
+        /* Stufe 15 C1: Phase 1-3 wie die Werks-FW (c2_switch1_weck.c). Im PC-Modus erlaubt, damit der Controller am
+         * Kabel bleiben kann (USB-seriell); gesperrt im Pro-Controller-2-Modus und bei klassischer Verbindung. */
+        extern int c2_s1_weck_dauer(int n);
+        extern void c2_s1_weck_stopp(void);
+        extern int c2_pro2_an(void);
+        extern int c2_switch_bt_verbunden(void);
+        if (!strcmp(b, "switch1 weck stopp")) {
+            c2_s1_weck_stopp();
+            c2_log("ok: switch1 weck stopp (laufender Durchgang endet nach 3,2 s)\r\n");
+        } else if (c2_pro2_an()) {
+            c2_log("fehler: switch1 weck: nicht im Pro-Controller-2-Modus\r\n");
+        } else if (c2_switch_bt_verbunden()) {
+            c2_log("fehler: switch1 weck: schon verbunden\r\n");
+        } else {
+            int n = 1;
+            if (b[13] == 'd') {
+                const char *p = b + 18;
+                while (*p == ' ') {
+                    p++;
+                }
+                n = *p ? (int)zahl_lesen(&p) : 10;
+            }
+            int r = c2_s1_weck_dauer(n);
+            if (r) {
+                c2_log("fehler: switch1 weck %d\r\n", r);
+            } else {
+                c2_log("ok: switch1 weck (%d Durchgang/Durchgaenge zu 3,2 s, Bericht folgt)\r\n", n);
+            }
+        }
+    } else if (!strcmp(b, "switch1 weck bericht")) {
+        extern int c2_s1_weck_bericht(void);
+        c2_log(c2_s1_weck_bericht() ? "ok: switch1 weck bericht\r\n" : "fehler: switch1 weck bericht: keiner\r\n");
+    } else if (!strcmp(b, "switch weck lernen")) {
+        extern int c2_weck_lernen(void);
+        int r = c2_weck_lernen();
+        if (r) {
+            c2_log("fehler: switch weck lernen %d\r\n", r);
+        } else {
+            c2_log("ok: switch weck lernen (30 s)\r\n");
+        }
+    } else if (!strncmp(b, "switch weck", 11)) {
+        /* Weckwerbung von Hand: „switch weck [pid] [absender]“, pid hex (2009, 2066, 2069), absender wie Linux sie
+         * anzeigt (12:34:56:78:9a:bc) oder „eigen“; die Werte bleiben bis zum Neustart für Home gesetzt */
+        extern u16 c2_weck_pid;
+        extern u8 c2_weck_absender[6];
+        extern void c2_switch_wecken(void);
+        const char *p = b + 11;
+        while (*p == ' ') {
+            p++;
+        }
+        if (!strncmp(p, "setzen", 6)) {
+            p += 6;
+            while (*p == ' ') {
+                p++;
+            }
+        }
+        if (*p && *p != ' ') {
+            u32 v = 0;
+            for (; (*p >= '0' && *p <= '9') || (*p >= 'a' && *p <= 'f'); p++) {
+                v = v * 16 + (*p <= '9' ? *p - '0' : *p - 'a' + 10);
+            }
+            c2_weck_pid = v;
+        }
+        while (*p == ' ') {
+            p++;
+        }
+        if (!strncmp(p, "eigen", 5)) {
+            memset(c2_weck_absender, 0, 6);
+        } else if (*p) {
+            u8 a[6];
+            int n = 0;
+            while (*p && n < 6) {
+                int h = hex_wert_c2(p[0]), l = hex_wert_c2(p[1]);
+                if (h < 0 || l < 0) {
+                    break;
+                }
+                a[n++] = h << 4 | l;
+                p += 2;
+                if (*p == ':') {
+                    p++;
+                }
+            }
+            if (n == 6) {
+                for (int i = 0; i < 6; i++) {
+                    c2_weck_absender[i] = a[5 - i]; /* Anzeige -> Leitungsreihenfolge */
+                }
+            }
+        }
+        /* „switch weck setzen <pid> <absender>“ speichert dauerhaft (Einrichten), sonst nur ausprobieren */
+        if (!strncmp(b + 11, " setzen", 7)) {
+            extern int c2_weck_speichern(void);
+            if (c2_weck_speichern()) {
+                c2_log("fehler: switch weck speichern\r\n");
+                return;
+            }
+            c2_log("ok: switch weck gespeichert %04x absender %02x:%02x:%02x:%02x:%02x:%02x\r\n", c2_weck_pid,
+                   c2_weck_absender[5], c2_weck_absender[4], c2_weck_absender[3], c2_weck_absender[2],
+                   c2_weck_absender[1], c2_weck_absender[0]);
+            return;
+        }
+        c2_switch_wecken();
+        c2_log("ok: switch weck %04x absender %02x:%02x:%02x:%02x:%02x:%02x\r\n", c2_weck_pid, c2_weck_absender[5],
+               c2_weck_absender[4], c2_weck_absender[3], c2_weck_absender[2], c2_weck_absender[1], c2_weck_absender[0]);
+    } else if (!strcmp(b, "switch diag")) {
+        c2_switch_diag();
+    } else if (!strcmp(b, "motor diag")) {
+        c2_motor_diag();
+    } else if (!strncmp(b, "motor pin ", 10)) {
+        const char *p = b + 10;
+        u32 l = zahl_lesen(&p), r = zahl_lesen(&p);
+        c2_motor_pins(!!l, !!r);
+    } else if (!strncmp(b, "motor ", 6)) {
+        const char *p = b + 6;
+        u32 l = zahl_lesen(&p), r = zahl_lesen(&p), ms = zahl_lesen(&p);
+        c2_motor_setzen(l, r, ms ? ms : 1000);
+        c2_log("ok: motor links %lu%% rechts %lu%% fuer %lu ms\r\n", l > 100 ? 100 : l, r > 100 ? 100 : r, ms ? ms : 1000);
+    } else if (!strcmp(b, "nachlass")) {
+        /* CRc: Ende des letzten Laufs (samt Spur) jederzeit abholen, nicht nur beim Hochfahren */
+        c2_nachlass_wiederholen();
+        c2_log("ok: nachlass\r\n");
+    } else if (!strcmp(b, "neustart")) {
+        c2_log("ok: Neustart\r\n");
+        os_time_dly(5);
+#if C2_CHITU
+        extern void chitu_netz_ruhe(void);
+        chitu_netz_ruhe(); /* gewollter Neustart zählt nicht für N4 */
+#endif
+        p33_soft_reset();
+    } else if (!strcmp(b, "haenger")) {
+        /* Watchdog-Test: Interrupts aus und Endlosschleife; der Watchdog (setup.c: WDT_4S) muss neu starten */
+        c2_log("ok: haenge jetzt, Watchdog sollte nach ~4 s neu starten\r\n");
+        os_time_dly(5);
+        local_irq_disable();
+        while (1);
+    } else if (!strcmp(b, "download-modus")) {
+#if C2_CHITU
+        extern int chitu_download_erlaubt(void);
+        extern void chitu_download_springen(void);
+        if (!chitu_download_erlaubt()) {
+            c2_log("fehler: download-modus nur mit PC am USB-Kabel (sonst hängt der ROM-Modus)\r\n");
+        } else {
+            c2_log("ok: ROM-Download-Modus\r\n");
+            os_time_dly(5);
+            chitu_download_springen();
+        }
+#else
+        extern void c2_download_springen(void);
+        c2_log("ok: ROM-Download-Modus (Licht rot)\r\n");
+        c2_download_springen();
+#endif
+#if C2_CHITU
+    } else if (!strncmp(b, "chitu ", 6)) {
+        extern void chitu_befehl(const char *a);
+        chitu_befehl(b + 6);
+#endif
+    } else if (b[0]) {
+        c2_log("fehler: unbekannter Befehl '%s' (hilfe)\r\n", b);
+    }
+}
+
+static void befehle_lesen(void)
+{
+    while (befehl_lies != befehl_schreib) {
+        char ch = befehl_ring[befehl_lies++ & (sizeof(befehl_ring) - 1)];
+        if (ch == '\r' || ch == '\n') {
+            befehl_zeile[befehl_n] = 0;
+            befehl_n = 0;
+            befehl_ausfuehren(befehl_zeile);
+            SPUR_APP(0x3F);
+        } else if (befehl_n < BEFEHL_MAX - 1) {
+            befehl_zeile[befehl_n++] = ch;
+        }
+    }
+}
+
+/* Im Timer-Task: cdc_write_data nutzt einen Mutex, also nicht im Interrupt. Ohne geöffneten Port gibt es
+ * 0 zurück, dann bleibt alles im Puffer. */
+static void senden(void *priv)
+{
+    /* Höchstens 63 Byte je Stück (16p/CRh): ein volles 64-Byte-Paket beendet keine Bulk-Übertragung, Linux (cdc_acm)
+     * reicht es erst mit dem nächsten Paket weiter. Am Chitu 4.11. belegt: „lebt …“ (48 B) + „ok: ota …“ (16 B) = 64 B,
+     * die Antwort kam 5 s später mit der nächsten Zeile, das Update brach ab. Jedes Stück ist so ein Kurzpaket. */
+    u8 stueck[MAXP_SIZE_CDC_BULKIN - 1];
+    SPUR_APP(0x40);
+    befehle_lesen();
+    SPUR_APP(0x41);
+    while (lies != schreib) {
+        u32 n = 0, l = lies;
+        while (n < sizeof(stueck) && l + n != schreib) {
+            stueck[n] = puffer[(l + n) & (PUFFER - 1)];
+            n++;
+        }
+        SPUR_APP(0x42);
+        u32 raus = cdc_write_data(0, stueck, n);
+        if (raus == 0) {
+            SPUR_APP(0x4F);
+            return;
+        }
+        CPU_CRITICAL_ENTER();
+        if (lies == l) { /* nicht inzwischen durch Überlauf verschoben */
+            lies = l + raus;
+        }
+        CPU_CRITICAL_EXIT();
+    }
+    SPUR_APP(0x4F);
+}
+
+void c2_log_init(void)
+{
+    sys_timer_add(NULL, senden, TAKT_MS);
+    c2_log("\r\nC2 Lite Firmware v2 (Diagnose) gestartet\r\n");
+    nachlass_ausgeben();
+}
+
+#else
+
+void c2_log_init(void)
+{
+}
+
+void c2_nachlass_wiederholen(void)
+{
+}
+
+void c2_absturz_melden(void)
+{
+}
+
+int c2_ram_ueberlebt(void)
+{
+    return 0;
+}
+
+void c2_log(const char *fmt, ...)
+{
+}
+
+void c2_log_v(const char *fmt, va_list args)
+{
+}
+
+void c2_log_v_sdk(const char *fmt, va_list args)
+{
+}
+
+void c2_mitschnitt_umbruch(void)
+{
+}
+
+int c2_sdk_zeichen(char c)
+{
+    return 0;
+}
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_log.h b/apps/hid/modules/c2lite/c2_log.h
new file mode 100644
index 0000000..a5b4d29
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_log.h
@@ -0,0 +1,23 @@
+#ifndef C2_LOG_H
+#define C2_LOG_H
+#include <stdarg.h>
+/* C2 Lite: Protokoll über USB-Seriell (CDC). Ohne geöffneten Port am PC bleiben die letzten Meldungen im
+ * Ringpuffer und kommen beim Öffnen nach (Hochfahren lässt sich so nachlesen). Am PC z. B.:
+ *   picocom /dev/ttyACM0     (Baudrate egal) */
+
+void c2_log_init(void);
+void c2_log(const char *fmt, ...);
+void c2_log_v(const char *fmt, va_list args);
+/* Ein Zeichen aus den SDK-Ausgaben (printf/putchar, umgeleitet in apps/common/debug/debug.c) */
+int c2_sdk_zeichen(char c);
+/* Ende des Nachlasses vom letzten Lauf erneut senden (kommt beim Hochfahren oft nicht beim PC an) */
+void c2_nachlass_wiederholen(void);
+/* 1 = RAM1 (Nachlass-Magic) hat den letzten Neustart überstanden, 0 = Kaltstart/Spannungsverlust */
+int c2_ram_ueberlebt(void);
+/* Absturzbericht des letzten Laufs (exception_analyze_release) ins Protokoll */
+void c2_absturz_melden(void);
+
+/* Stufe 1: Tasten, Sticks, Akku und USB-5V lesen und protokollieren (c2_eingaben.c) */
+void c2_eingaben_init(void);
+
+#endif
diff --git a/apps/hid/modules/c2lite/c2_ota.c b/apps/hid/modules/c2lite/c2_ota.c
new file mode 100644
index 0000000..8db9f20
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_ota.c
@@ -0,0 +1,210 @@
+/* C2 Lite: Firmware-Update in die freie Bank (Dual-Bank, CONFIG_DOUBLE_BANK_ENABLE) über die Befehlszeilen von
+ * c2_log.c. Ablauf wie das SDK-Beispiel apps/spp_and_le/examples/findmy/ble_fmy_ota.c:
+ *   ota start <größe>      dual_bank_passive_update_init + dual_bank_update_allow_check
+ *   ota d <hex>            Daten (bis 256 Byte je Zeile), in 1-KB-Blöcken mit dual_bank_update_write geschrieben;
+ *                          die Antwort kommt erst, wenn der Block im Flash steht
+ *   ota ende <crc16>       Rest schreiben, eigene CRC16 (CCITT, Start 0) über alle Daten vergleichen, dann
+ *                          dual_bank_update_verify_without_crc, dual_bank_update_burn_boot_info, Neustart
+ *   ota abbruch            dual_bank_passive_update_exit
+ * Bei jedem Fehler bleibt die laufende Bank aktiv. Datei: db_update_data.bin aus dem Packer. */
+#include "app_config.h"
+#include "system/includes.h"
+#include "update/dual_bank_updata_api.h"
+#include "c2_log.h"
+
+#ifdef CONFIG_BOARD_C2LITE
+
+#define BLOCK 1024
+int dual_bank_update_verify_without_crc(int (*clk_resume)(int priv));
+
+static u8 puffer[BLOCK + 256];
+static volatile u32 im_puffer;   /* Bytes im Puffer; der Schreib-Rückruf setzt auf 0 */
+static volatile u8 schreibfehler;
+static u8 aktiv;
+static u32 groesse, empfangen;
+static u16 crc;
+
+static u16 crc16_weiter(u16 c, const u8 *d, u32 n)
+{
+    while (n--) {
+        c ^= (u16)*d++ << 8;
+        for (int i = 0; i < 8; i++) {
+            c = c & 0x8000 ? (c << 1) ^ 0x1021 : c << 1;
+        }
+    }
+    return c;
+}
+
+static int geschrieben(int err)
+{
+    if (err) {
+        schreibfehler = 1;
+    }
+    im_puffer = 0;
+    return 0;
+}
+
+/* Puffer schreiben und warten, bis der Rückruf kommt (wie das Beispiel: höchstens 2 s) */
+static int block_schreiben(void)
+{
+    if (!im_puffer) {
+        return 0;
+    }
+    if (dual_bank_update_write(puffer, im_puffer, geschrieben)) {
+        return -1;
+    }
+    for (int i = 0; i < 200 && im_puffer; i++) {
+        os_time_dly(1);
+    }
+    return im_puffer || schreibfehler ? -1 : 0;
+}
+
+static void ende_neustart(void *priv)
+{
+#if C2_CHITU
+    extern void chitu_netz_ruhe(void);
+    chitu_netz_ruhe(); /* gewollter Neustart nach Update */
+#endif
+    cpu_reset();
+}
+
+static int bootinfo_fertig(int err)
+{
+    if (err) {
+        c2_log("fehler: ota Bootinfo %d\r\n", err);
+        return 0;
+    }
+    c2_log("ok: ota fertig, Neustart in 2 s\r\n");
+    sys_timeout_add(NULL, ende_neustart, 2000);
+    return 0;
+}
+
+static int takt_zurueck(int priv)
+{
+#if C2_CHITU
+    extern void chitu_herzschlag(void);
+    chitu_herzschlag(); /* Prüfung C1b M-1: Bankprüfung zählt als lebendig */
+#endif
+    return 0;
+}
+
+/* Fortschritt für die Anzeige: 0 = kein Update, sonst 1..1000 */
+u16 c2_ota_promille(void)
+{
+    return aktiv && groesse ? 1 + (u32)((u64)empfangen * 999 / groesse) : 0;
+}
+
+static int hex_wert(char c)
+{
+    return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+}
+
+#if C2_CHITU
+extern void chitu_sticks_pausieren(int an);
+#endif
+
+static void abbrechen(const char *grund)
+{
+    if (aktiv) {
+        dual_bank_passive_update_exit(NULL);
+    }
+    aktiv = 0;
+#if C2_CHITU
+    chitu_sticks_pausieren(0); /* Update vorbei: Stick-Interrupt wieder an */
+#endif
+    c2_log("fehler: ota %s\r\n", grund);
+}
+
+/* Liefert 1, wenn die Zeile ein OTA-Befehl war */
+int c2_ota_befehl(const char *b, u32 (*zahl)(const char **))
+{
+    if (strncmp(b, "ota ", 4)) {
+        return 0;
+    }
+    const char *p = b + 4;
+    if (!strncmp(p, "start ", 6)) {
+        p += 6;
+        if (aktiv) {
+            dual_bank_passive_update_exit(NULL);
+        }
+        groesse = zahl(&p), empfangen = 0, im_puffer = 0, schreibfehler = 0, crc = 0;
+#if C2_CHITU
+        /* C1f→C2b am Chitu brach bei der Bankprüfung mit Soft-Reset ab (Empfänger mit 2-ms-Stick-Interrupt; ohne ihn
+         * liefen alle Updates). Vermutung: Interrupt springt in Flash-Code, während der Flash belegt ist. Während des
+         * Updates Stick-Interrupt aus (Sticks melden dann Mitte). */
+        chitu_sticks_pausieren(1);
+#endif
+        /* Zeilen landen sofort im Nachlass (übersteht einen Software-Reset) */
+        c2_log("ota: exit\r\n");
+        dual_bank_passive_update_exit(NULL);
+        c2_log("ota: init %lu\r\n", groesse);
+        if (!groesse || dual_bank_passive_update_init(0, groesse, BLOCK, NULL)) {
+            aktiv = 0;
+            c2_log("fehler: ota start (Dual-Bank-Firmware?)\r\n");
+#if C2_CHITU
+            chitu_sticks_pausieren(0);
+#endif
+            return 1;
+        }
+        aktiv = 1;
+        c2_log("ota: allow_check\r\n");
+        if (dual_bank_update_allow_check(groesse)) {
+            abbrechen("zu gross fuer die freie Bank");
+            return 1;
+        }
+        c2_log("ok: ota bereit %lu\r\n", groesse);
+    } else if (!strncmp(p, "d ", 2)) {
+        if (!aktiv) {
+            c2_log("fehler: ota nicht gestartet\r\n");
+            return 1;
+        }
+        p += 2;
+        u32 n = 0;
+        while (p[0] && p[1]) {
+            int h = hex_wert(p[0]), l = hex_wert(p[1]);
+            if (h < 0 || l < 0 || im_puffer + n >= sizeof(puffer)) {
+                abbrechen("Daten ungueltig");
+                return 1;
+            }
+            puffer[im_puffer + n++] = h << 4 | l;
+            p += 2;
+        }
+        crc = crc16_weiter(crc, puffer + im_puffer, n);
+        im_puffer += n, empfangen += n;
+        if (empfangen > groesse) {
+            abbrechen("mehr Daten als angekuendigt");
+            return 1;
+        }
+        if (im_puffer >= BLOCK && block_schreiben()) {
+            abbrechen("Schreiben fehlgeschlagen");
+            return 1;
+        }
+        c2_log("ok: ota %lu\r\n", empfangen);
+    } else if (!strncmp(p, "ende ", 5)) {
+        p += 5;
+        u32 soll = zahl(&p);
+        if (!aktiv) {
+            c2_log("fehler: ota nicht gestartet\r\n");
+        } else if (empfangen != groesse) {
+            abbrechen("Groesse stimmt nicht");
+        } else if (soll != crc) {
+            c2_log("fehler: ota CRC %04x statt %04lx\r\n", crc, soll);
+            abbrechen("CRC");
+        } else if (block_schreiben()) {
+            abbrechen("Schreiben fehlgeschlagen");
+        } else if (dual_bank_update_verify_without_crc(takt_zurueck)) {
+            abbrechen("Pruefung der Bank fehlgeschlagen");
+        } else {
+            aktiv = 0;
+            c2_log("ok: ota geprueft, schalte Bank um\r\n");
+            dual_bank_update_burn_boot_info(bootinfo_fertig);
+        }
+    } else if (!strcmp(p, "abbruch")) {
+        abbrechen("abgebrochen");
+    } else {
+        c2_log("fehler: ota start <groesse> | ota d <hex> | ota ende <crc16> | ota abbruch\r\n");
+    }
+    return 1;
+}
+
+#endif
