+/* name = anzeige | vibration | totzone | licht | hell | logo | tempo | farbe; speichert sofort. Rückgabe 0 = ok */
+int c2_einstellung_setzen(const char *name, u32 wert)
+{
+    if (!strcmp(name, "anzeige") && wert <= 1) {
+        einst.anzeige = wert;
+    } else if (!strcmp(name, "vibration") && wert <= 100) {
+        einst.vibration = wert;
+    } else if (!strcmp(name, "totzone") && wert <= 100) {
+        einst.totzone = wert;
+    } else if (!strcmp(name, "licht") && wert <= C2_LICHT_LETZTER) {
+        einst.licht.modus = wert;
+        rgb_manuell = 0;
+    } else if (!strcmp(name, "hell") && wert <= 100) {
+        einst.licht.hell = wert;
+    } else if (!strcmp(name, "logo") && wert <= 100) {
+        einst.licht.logo_hell = wert;
+    } else if (!strcmp(name, "tempo") && wert >= 1 && wert <= 100) {
+        einst.licht.tempo = wert;
+    } else if (!strcmp(name, "farbe") && wert <= 0xFFFFFF) {
+        einst.licht.farbe[0] = wert >> 16, einst.licht.farbe[1] = wert >> 8, einst.licht.farbe[2] = wert;
+    } else {
+        return -1;
+    }
+    return c2_einstellung_speichern();
+}
