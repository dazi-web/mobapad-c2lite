+        return 0; /* USB aus: wie die Bibliothek 0 */
+    }
+    JL_USB->CON1 = ((reg << 8) & 0xBF00) | BIT(14);
+    for (u32 i = 0; i < 20000; i++) {
+        if (JL_USB->CON1 & BIT(15)) {
