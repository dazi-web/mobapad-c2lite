+/* Bericht (aus dem Interrupt gefüllt). Liegt im reservierten Ende von RAM1 hinter Nachlass (0x2EF80) und
+ * Absturzkopie (0x2F800..0x2FC5C), übersteht also den Neustart beim Schieberwechsel: im PC-Modus mit
+ * „switch1 weck bericht“ lesbar (im Modus Switch 1 gibt es kein USB-seriell und keinen BLE-Befehlsdienst). */
+#define RX_MERK 2
+#define EV_MERK 14
+#define L_MERK 2 /* 16n: 6 → 2, Platz für den LMP-Verlauf lmp[] */
+#define LMP_MERK 24
+#define BERICHT_MAGIC 0xC2155B10
+struct s1_bericht_t {
+    u32 magic;
+    u8 aktiv, ende;     /* ende: 1 Frist, 2 Phase 2+3 angenommen (Phase 4 gestartet), 3 Notabbruch */
+    u16 n_rx, n_takt, n_fort, n_unter, n_8f;
+    u16 n_schritt[6];
+    /* Messwerte, ändern nichts am Ablauf */
+    u16 n_irq, n_irq_rx, n_irq_takt, n_takt_fremd, n_vek_fehler;
+    u32 fort_slot, scheibe_min, scheibe_max, scheibe_summe;
+    u8 n_tasks;
+    struct {
+        u16 type, run_slot;
+        u8 sta, state, prio, eigen;
+    } task[6];
+    struct {
+        u16 rxstat, rxphdr, rxbit;
+        u8 schritt, rx_schritt, kanal;
+        u32 clkn;
+        u8 d[17];
+    } rx[RX_MERK];
+    u8 p2[17];
+    u32 p2_clkn, uhr, uhr_off;
+    u32 txpwer, txset, dauer_slots, start_slot;
+    /* Phase 4 (15e) */
+    u32 link, p4_slot;
+    u16 p4_rxbit, p4_bitoff;
+    u8 n_ev;
+    struct {
+        u8 art, ev, wert, rx;
+        u16 zeit;
+    } ev[EV_MERK];
+    /* 15f: Empfänge auf dem Link-Rahmen nach Phase 4 (nur Beobachtung) */
+    u16 n_l_rx, n_l_8f, n_l_andere, n_l_weg;
+    u16 n_lm;                /* 15q: Anzahl Pakete mit Nutzdaten; l[] hält die letzten L_MERK (Ring) */
+    u8 hcr;                  /* 0 nicht, 1 host_connection_req gesendet, 2 Verbindung nicht gefunden, 3 Rolle nicht Slave,
+                              * Weg B: 4 normaler Anruf gestartet, 5 keine Kopplung; 16j: 1 Slave→Master umgestellt,
+                              * 8 war schon Rolle 0, 9 keine Verbindung binnen 5 s, 10 Werks-Weg (16k, nichts getan); hcr_rolle = Rolle der Bibliothek */
+    u8 hcr_rolle;
+    u16 hcr_versuche;
+    u16 hcr_slot;            /* Slots nach P4 */
+    u8 nach_da, nach_anruf;  /* 15m: Weck-Link bei 2 s noch da; Anruf 1 gestartet / 2 keine Kopplung */
+    u16 nach_warte;          /* 10-ms-Takte bis der Weck-Link weg war */
+    u8 hcr_ptt;              /* 15v: Frame-miscntl vor HCR; Bit 3 = echtes PTT (lc->frame->miscntl), 0xff = kein Frame */
+    u8 lmp_aurand, lmp_sres, lmp_encreq, lmp_detach_rx, lmp_detach_tx; /* 15t */
+    /* 15x: AFH-Beobachtung */
+    u8 afh_seen, afh_mode;
+    u32 afh_instant, afh_rx_clkn;   /* Instant aus SET_AFH; RX-Uhr beim Empfang von SET_AFH */
+    u8 afh_map[10];
+    u16 rx_vor_afh, rx_nach_afh;    /* gültige RX (LLID3, len>=1) vor/nach SET_AFH */
+    u8 setupc_rx, setupc_tx, acc_rx, acc_tx, hcr_rx, hcr_tx; /* 15y/16b: Handshake-Zähler rx+tx */
+    u8 modus; /* 16b: 0 = Weck-Link, 1 = normaler Reconnect (Mithörer) */
+    u32 letzte_rx_clkn;             /* Uhr des letzten RX (beliebig) auf dem Link */
+    /* 16l: Nintendo-PDUs mit Opcode-Byte 0 wie Werk 0x344e8 (A: 00 04 00 Adresssumme → 01 04 00 00) und
+     * 0x34522 (B: 00 00 32 15 → 00 01 32 1d 00…) */
+    u8 op0_a_rx, op0_a_tx, op0_b_rx, op0_b_tx, op0_andere, op0_summe;
+    u8 op0_letzt[4];
+    u16 op0_a_slot;                 /* Slots nach P4 beim Senden der Antwort A */
+    /* 16n: LMP-Verlauf des Weck-Links (alle LLID-3-Pakete, rx und neue tx-Inhalte), Slots nach P4 */
+    u8 n_lmp;
+    struct {
+        u16 slot;
+        u8 dir_len; /* Bit 7 = von uns (tx), Bits 0..4 = Länge */
+        u8 b[5];
+    } lmp[LMP_MERK];
+    struct {
+        u16 rxstat, rxphdr, link0, link1;
+        u16 txphdr0, txphdr1;
+        u8 txtog, txb0, txb1, idx;
+        u16 clk16;  /* untere 16 Bit rx_clkn */
+        u8 rlen, tlen, rllid, tllid;
+        u8 rx[16];  /* 15x: volle LMP-Nutzlast (SET_AFH = 16 Byte) */
+        u8 tx[11];
+    } l[L_MERK];
+};
+_Static_assert(sizeof(struct s1_bericht_t) <= 0x2FF50 - 0x2FC60, "RAM1-Platz");
+#define BER (*(struct s1_bericht_t *)0x2FC60)
+static u8 s1_tx_alt[5];
+static u16 s1_tx_ph_alt;
+static void s1_lmp_merk(u8 dir, const u8 *p, u8 len, u32 clkn)
+{
+    if (BER.n_lmp >= LMP_MERK) {
+        return;
+    }
+    int k = BER.n_lmp++;
+    BER.lmp[k].slot = (u16)(clkn - BER.p4_slot);
+    BER.lmp[k].dir_len = dir | (len & 0x1f);
+    for (int i = 0; i < 5; i++) {
+        BER.lmp[k].b[i] = i < len ? p[i] : 0;
+    }
+}
