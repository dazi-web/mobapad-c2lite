+/* Kontext wie im Werk (0x78 Byte, Offsets aus 0x391b2/0x3dd72/0x3d0aa) */
+struct s1_ctx {
+    u8 agc;            /* 0x00 AGC-Index 0..5 */
+    u8 lt;             /* 0x01 eigene LT_ADDR (__get_lt_addr) */
+    u8 zustand;        /* 0x02 1 angelegt, 2 läuft, 3 unterbrochen */
+    u8 schritt;        /* 0x03 Zeitgeber-Zustand 0..5 */
+    u8 rx_schritt;     /* 0x04 0 warten auf Phase 2, 1 Phase 3 geplant */
+    u8 kanal;          /* 0x05 Index in KANAL[] */
+    u8 eigen[6];       /* 0x06 eigene BD_ADDR */
+    u8 eigen_bch[5];   /* 0x0c eigener Access Code (Parität) */
+    u8 rx[17];         /* 0x11 Phase-2-Nutzdaten */
+    u8 r22;
+    u8 tx[18];         /* 0x23 Sendepuffer: Phase 1 Weckcode W, Phase 3 eigene Adresse */
+    u8 r35;
+    u16 r36;           /* 0x36 Werk: Wert aus [0x43d4+76], hier unbenutzt */
+    u32 frist;         /* 0x38 Ende in Slots (3200 ms) */
+    struct s1_task task; /* 0x3c */
+    u8 r58[2];
+    u8 p2_lt;          /* 0x5a LT_ADDR aus Phase 2 */
+    u8 r5b;
+    u8 konsole[6];     /* 0x5c */
+    u8 konsole_bch[5]; /* 0x62 Weck-Access-Code der Konsole (untere 32 Paritätsbits invertiert) */
+    u8 r67;
+    u32 uhr;           /* 0x68 Uhr der Konsole aus Phase 2 */
+    u32 uhr_off;       /* 0x6c */
+    u32 r70;
+    void *rahmen;      /* 0x74 */
+};
