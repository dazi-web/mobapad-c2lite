+static void s1_irq(void);
+
+/* Ende wie Werk 0x3945c; läuft im Interrupt oder mit gesperrten Interrupts. Speicher gibt der App-Task frei. */
+static void s1_ende(u8 grund)
+{
+    struct s1_ctx *c = s1;
+    if (!c) {
+        return;
+    }
+    __put_lt_addr(c->lt);
+    REG(0x1C00D0) &= ~4;
+    REG(0x1C0000) &= ~0x80000;
+    REG(0x1C0000) &= ~0x10000;
+    link_task_del(&c->task); /* ruft s1_unterbrechen, wenn wir gerade laufen */
+    link_idle_task_enable_detect();
+    bredr_link_v[99] &= ~0x80;
+    if (c->rahmen) {
+        bredr_bd_put_frame(c->rahmen);
+        c->rahmen = NULL;
+    }
+    s1 = NULL;
+    s1_freigeben = c;
+    BER.ende = grund;
+    BER.aktiv = 0;
+    if (!s1_beob && ((void (**)(void))IRQ_MEM_ADDR)[IRQ_BREDR_IDX] == s1_irq && irq27_alt) {
+        ((void (**)(void))IRQ_MEM_ADDR)[IRQ_BREDR_IDX] = irq27_alt;
+    }
+}
+
+/* 15f: Beobachtung beenden (App-Task) */
+static void s1_beob_ende(void *priv)
+{
+    local_irq_disable();
+    s1_beob = NULL;
+    if (!s1 && ((void (**)(void))IRQ_MEM_ADDR)[IRQ_BREDR_IDX] == s1_irq && irq27_alt) {
+        ((void (**)(void))IRQ_MEM_ADDR)[IRQ_BREDR_IDX] = irq27_alt;
+    }
+    local_irq_enable();
+    c2_log("switch1: P4-Beobachtung Ende rx=%u 8f=%u andere=%u\r\n", BER.n_l_rx, BER.n_l_8f, BER.n_l_andere);
+}
+
+/* Fortsetzen (Werk 0x3dd72), vom Zeitplaner der Bibliothek */
+static int s1_fortsetzen(void *task)
+{
+    struct s1_ctx *c = s1;
+    void *f = c ? c->rahmen : NULL;
+    if (!f) {
+        return 0;
+    }
+    BER.n_fort++;
+    BER.fort_slot = READ_SLOT_CLK();
+    if (((void (**)(void))IRQ_MEM_ADDR)[IRQ_BREDR_IDX] != s1_irq) {
+        BER.n_vek_fehler++;
+    }
+    if (BER.n_fort == 1) {
+        /* Taskliste der Bibliothek: unser Task hängt mit entry (+0x10) in derselben Ringliste */
+        void **e = c->task.entry[0];
+        int n = 0;
+        while (e && e != (void **)c->task.entry && n < 12) {
+            struct s1_task *t = (struct s1_task *)((u8 *)e - 16);
+            if (n < 6 && (u32)t >= 0x1000 && (u32)t < 0x30000) {
+                BER.task[n].type = t->type, BER.task[n].run_slot = t->run_slot;
+                BER.task[n].sta = t->sta_attribute, BER.task[n].state = t->state, BER.task[n].prio = t->priority;
+                BER.task[n].eigen = 0;
+            }
+            n++;
+            e = (void **)e[0];
+        }
+        BER.n_tasks = n;
+    }
+    c->rx_schritt = 0;
+    c->schritt = 0;
+    __write_reg_clkoffset(f, c->uhr_off);
+    __write_reg_bdaddr(f, c->konsole);
+    __write_reg_bch(f, c->konsole_bch);
+    F8(f, R_MISCNTL) = 0;
+    F16(f, R_WINCNTL) = 0x8010;
+    F16(f, R_BITOFF) = 0x4000;
+    __write_reg_txptr(f, 0, c->tx);
+    __write_reg_txptr(f, 1, c->tx);
+    __write_reg_format(f, 0, 2);
+    F16(f, R_LINKCNTL) = 0x4004;
+    F16(f, R_LINKCNTL + 2) = 0x4004;
+    F16(f, R_TXPHDR) = 18;
+    F16(f, R_TXPHDR + 2) = 18;
+    F8(f, R_TXBUF0CNTL) &= ~1;
+    F8(f, R_TXBUF1CNTL) &= ~1;
+    c->kanal = 0;
+    REG(0x1C00D0) &= ~1;
+    REG(0x1C00D0) |= 4;
+    REG(0x1C0000) |= 0x80000;
+    REG(0x1C0000) |= 0x10000;
+    F8(f, R_RXFREQ) = 0;
+    F8(f, R_TXFREQ) = 0;
+    agc_weiter(c, f);
+    bredr_bd_frame_enable(f, 2, 1);
+    c->zustand = 2;
+    zeitgeber(64);
+    return 0;
+}
+
+/* Unterbrechen (Werk 0x3de50) */
+static int s1_unterbrechen(void *task)
+{
+    struct s1_ctx *c = s1;
+    if (!c || !c->rahmen) {
+        return 0;
+    }
+    BER.n_unter++;
+    if (BER.fort_slot) {
+        u32 d = (READ_SLOT_CLK() - BER.fort_slot) & 0x7FFFFFF;
+        if (!BER.scheibe_min || d < BER.scheibe_min) {
+            BER.scheibe_min = d;
+        }
+        if (d > BER.scheibe_max) {
+            BER.scheibe_max = d;
+        }
+        BER.scheibe_summe += d;
+    }
+    c->zustand = 3;
+    bredr_bd_frame_disable(c->rahmen);
+    REG(0x1C0000) |= 0x80000000;
+    zeitgeber_aus();
+    return 0;
+}
+
+static const struct {
+    int (*fortsetzen)(void *);
+    int (*unterbrechen)(void *);
+} S1_OPS = {s1_fortsetzen, s1_unterbrechen};
+
+/* Empfang auf unserem Rahmen (Werk 0x3c8a4..0x3c9f2, 0x3cc98..0x3cd20) */
+static void s1_empfang(struct s1_ctx *c, void *f)
+{
+    int idx = 1 & ~F8(f, R_RXTOG);
+    u16 rxstat = F16(f, R_RXSTAT + 2 * idx);
+    u16 rxphdr = F16(f, R_RXPHDR + 2 * idx);
+    u8 rs = c->rx_schritt, sch = c->schritt;
+    if (rs == 1) {
+        if (((rxstat >> 8) & 0xff) == 0x8f) {
+            c->schritt = 5;
+            zeitgeber(8);
+            BER.n_8f++;
+        }
+        c->rx_schritt = 0;
+    } else if (rs == 0) {
+        c->rx_schritt = 1;
+        u16 rxbit = F16(f, R_RXBIT) & 0x3ff;
+        int d = (int)rxbit - 83;
+        u16 clk = F16(f, R_RXCLKN);
+        u8 kanal = c->kanal;
+        u8 modus;
+        if (d < 0) {
+            F16(f, R_BITOFF) = rxbit + 542;
+            modus = clk & 1;
+        } else {
+            F16(f, R_BITOFF) = d;
+            modus = !(clk & 1);
+        }
+        bredr_bd_frame_enable(f, modus, 1);
+        if (kanal <= 1) {
+            __write_reg_clkoffset(f, 0);
+        } else if (kanal == 2) {
+            __write_reg_clkoffset(f, 0xB - READ_SLOT_CLK());
+        }
+        c->schritt = 4;
+        zeitgeber(2);
+        F16(f, R_LINKCNTL) = 0x4003;
+        F16(f, R_LINKCNTL + 2) = 0x4003;
+        F16(f, R_TXPHDR) = 99;
+        F16(f, R_TXPHDR + 2) = 99;
+        memset(c->tx, 0, sizeof(c->tx));
+        memcpy(c->tx, c->eigen, 6);
+        zeitgeber(16);
+    }
+    __clean_reg_rxfull(f, 0);
+    __clean_reg_rxfull(f, 1);
+    /* Merken erst nach dem zeitkritischen Teil */
+    if (BER.n_rx < RX_MERK) {
+        int i = BER.n_rx;
+        BER.rx[i].rxstat = rxstat, BER.rx[i].rxphdr = rxphdr, BER.rx[i].rxbit = F16(f, R_RXBIT);
+        BER.rx[i].schritt = sch, BER.rx[i].rx_schritt = rs, BER.rx[i].kanal = c->kanal;
+        BER.rx[i].clkn = F16(f, R_RXCLKN) | (u32)F16(f, R_RXCLKN + 2) << 16;
+        memcpy(BER.rx[i].d, c->rx, 17);
+    }
+    BER.n_rx++;
+}
+
+/* Zeitgeber-Zustände (Werk 0x3cfa6..0x3d276) */
+static void s1_takt(struct s1_ctx *c)
+{
+    void *f = c->rahmen;
+    u8 k = c->kanal;
+    BER.n_takt++;
+    if (c->schritt < 6) {
+        BER.n_schritt[c->schritt]++;
+    }
+    switch (c->schritt) {
+    case 0: /* nach 64 Slots Senden: 16 Slots umschalten */
+        c->schritt = 2;
+        F16(f, R_BITOFF) = 0x4000;
+        bredr_bd_frame_enable(f, 2, 1);
+        if (k <= 1) {
+            REG(0x1C0000) |= 0x80000;
+            __write_reg_clkoffset(f, 0);
+        } else if (k == 2) {
+            REG(0x1C0000) &= ~0x80000;
+            __write_reg_clkoffset(f, 0xD - READ_SLOT_CLK());
+        }
+        REG(0x1C00D0) &= ~4;
+        REG(0x1C0000) |= 0x4000000;
+        REG(0x1C0000) |= 0x80000000;
+        zeitgeber(16);
+        break;
+    case 2: /* wieder Phase 1 auf dem nächsten Kanal, 64 Slots */
+        c->schritt = 0;
+        bredr_bd_frame_enable(f, 0, 1);
+        REG(0x1C0000) |= 0x80000;
+        REG(0x1C00D0) |= 4;
+        c->rx_schritt = 0;
+        memcpy(c->tx, c->konsole_bch, 4);
+        F16(f, R_LINKCNTL) = 0x4004;
+        F16(f, R_LINKCNTL + 2) = 0x4004;
+        F16(f, R_TXPHDR) = 18;
+        F16(f, R_TXPHDR + 2) = 18;
+        k = k + 1 <= 2 ? k + 1 : 0;
+        c->kanal = k;
+        F8(f, R_RXFREQ) = frequenz(KANAL[k]);
+        F8(f, R_TXFREQ) = frequenz(KANAL[k]);
+        REG(0x1C0000) |= 0x80000000;
+        zeitgeber(64);
+        break;
+    case 4: /* Phase 3 ohne Bestätigung: zurück */
+        if (k <= 1) {
+            __write_reg_clkoffset(f, 0);
+        } else if (k == 2) {
+            __write_reg_clkoffset(f, 0xA - READ_SLOT_CLK());
+        }
+        c->schritt = 2;
+        zeitgeber(16);
+        break;
+    case 5: { /* Phase 2 + 3 angenommen: Phase 4, ACL-Verbindung wie Werk 0x3d09a..0x3d1ea */
+        u8 tog = F8(f, R_TXTOG) & 1;
+        bredr_bd_frame_disable(f);
+        zeitgeber_aus();
+        memcpy(BER.p2, c->rx, 17);
+        c->p2_lt = c->rx[0];
+        memcpy(c->konsole, c->rx + 1, 6);
+        u32 u = c->rx[13] | (u32)c->rx[14] << 8 | (u32)c->rx[15] << 16 | (u32)(c->rx[16] & 0x1f) << 24;
+        c->uhr = u >> 2;
+        BER.p2_clkn = F16(f, R_RXCLKN) | (u32)F16(f, R_RXCLKN + 2) << 16;
+        c->uhr_off = c->uhr - BER.p2_clkn;
+        F16(f, R_WINCNTL) = REG(0x1C0028);
+        u16 rxbit = F16(f, R_RXBIT);
+        u16 bitoff = (rxbit + ((rxbit & 0x3F8) >= 88 ? 936 : 537)) & 1023; /* = rxbit − 88 im 625er Slot */
+        F16(f, R_BITOFF) = bitoff;
+        if ((rxbit & 0x3F8) <= 87) {
+            c->uhr_off++;
+        }
+        BER.uhr = c->uhr, BER.uhr_off = c->uhr_off, BER.p4_rxbit = rxbit, BER.p4_bitoff = bitoff;
+        bch_bytes(c->konsole_bch, c->konsole); /* jetzt der normale Access Code der Konsole (Werk 0x33c40) */
+        __write_reg_lt_addr(f, c->p2_lt);
+        __write_reg_clkoffset(f, c->uhr_off);
+        __write_reg_bdaddr(f, c->konsole);
+        __write_reg_bch(f, c->konsole_bch);
+        __write_reg_format(f, 0, 3);
+        F16(f, R_LINKCNTL + 2 * tog) = 0x4010;
+        F16(f, R_LINKCNTL + 2 * (tog ^ 1)) = 0x4000;
+        F16(f, R_TXPHDR + 2 * tog) = 2;
+        c->zustand = 4;
+        F8(f, R_RXTOG) = 0;
+        F16(f, R_BUFCNTL) &= ~0xF00;
+        F16(f, R_BUFCNTL) = F16(f, R_BUFCNTL);
+        F16(f, R_BUFCNTL) &= ~0x20;
+        F16(f, R_BUFCNTL) |= 3;
+        F8(f, R_TXBUF0CNTL) |= 1;
+        F8(f, R_TXBUF1CNTL) |= 1;
+        c->rahmen = NULL; /* der Rahmen gehört jetzt der Verbindung */
+        REG(0x1C00D0) &= ~4;
+        REG(0x1C0000) &= ~0x80000;
+        REG(0x1C0000) &= ~0x10000;
+        REG(0x1C0000) |= 0x80000000;
+        /* Werk 0x3b9ea(frame, remote, 1, bitoff) = Bibliothek create_link_connection ohne TWS; das Werk beendet darin
+         * den Weckablauf (0x3945c) vor link_task_add, darum hier s1_ende davor. Rolle 1 wie Page-Scan (Konsole ist
+         * Central: sie vergibt LT_ADDR und Uhr). Von remote liest die Bibliothek nur sr, Adresse und class_dev. */
+        static struct bredr_remote_device_s1 rem;
+        memset(&rem, 0, sizeof(rem));
+        rem.sr = 1; /* nicht auf der Luft; Werk: ungesetztes Kontextbyte; 1 wie unser Anruf (PSRM 1) */
+        rem.lt_addr = c->p2_lt;
+        memcpy(rem.addr, c->konsole, 6);
+        rem.clkn = c->uhr, rem.clk_offset = c->uhr_off;
+        u8 ungerade = c->uhr_off & 1;
+        s16 sbitoff = (s16)F16(f, R_BITOFF);
+        s1_beob = f; /* Vektor bleibt bei s1_irq, der nur mitschreibt und weiterreicht */
+        s1_ende(2);
+        void *link = create_link_connection(f, &rem, bt_get_mac_addr(), 1, sbitoff, 0, 0);
+        BER.link = (u32)link;
+        BER.p4_slot = READ_SLOT_CLK();
+        if (!link) {
+            s1_beob = NULL;
+            if (((void (**)(void))IRQ_MEM_ADDR)[IRQ_BREDR_IDX] == s1_irq && irq27_alt) {
+                ((void (**)(void))IRQ_MEM_ADDR)[IRQ_BREDR_IDX] = irq27_alt;
+            }
+            bredr_bd_put_frame(f); /* keine Verbindung angelegt: Rahmen zurück */
+        } else {
+            bd_frame_odd_even(f, ungerade);
+            s1_spiegel = 1;
+        }
+        return;
+    }
+    default:
+        break;
+    }
+    if (c->frist && frist_vorbei(READ_SLOT_CLK(), c->frist)) {
+        s1_ende(1);
+    }
+}
+
+/* Ersatz für bredr_rx_irq_handler (IRQ 27) während des Weckens: gleicher Ablauf wie die Bibliothek, dazu unser
+ * Rahmen beim Empfang (Werk-Verteiler 0x3bdfe) und unsere Zustände beim Zeitgeber (Bit 9). */
+___interrupt static void s1_irq(void)
+{
+    BER.n_irq++;
+    if (REG(0x1C0010) & 1) {
+        REG(0x1C0018) |= 1;
+    }
+    if (REG(0x1C0010) & 2) {
+        REG(0x1C0018) |= 2;
+        BER.n_irq_rx++;
+        for (int i = 0; i < 4; i++) {
+            if (!(BD_AKTIV & (1 << i))) {
+                continue;
+            }
+            u8 *f = BD_RAHMEN(i);
+            u32 clkn = F16(f, R_RXCLKN) | (u32)F16(f, R_RXCLKN + 2) << 16;
+            if (clkn == BD_RXCLKN_ALT(i)) {
+                continue;
+            }
+            BD_RXCLKN_ALT(i) = clkn;
+            struct s1_ctx *c = s1;
+            if (c && f == c->rahmen) {
+                s1_empfang(c, f);
+            } else {
+                if (s1_beob) {
+                    if (f == s1_beob) {
+                        int idx = 1 & ~F8(f, R_RXTOG);
+                        u16 st = F16(f, R_RXSTAT + 2 * idx);
+                        u8 typ0 = F16(f, R_RXSTAT + 2 * idx) & 0xf;
+                        { /* 16n: LMP-Verlauf (nur beobachten) */
+                            u16 lph = F16(f, R_RXPHDR + 2 * idx);
+                            u8 lrl = (lph >> 3) & 0x1f;
+                            if ((st >> 8) == 0x8f && typ0 != 0 && typ0 != 1 && (lph & 3) == 3 && lrl >= 1) {
+                                s1_lmp_merk(0, (const u8 *)(BT_BASIS + F16(f, R_LMPRXPTR + 2 * idx)), lrl, clkn);
+                            }
+                            u8 ltog = F8(f, R_TXTOG) & 1;
+                            u16 ltph = F16(f, R_TXPHDR + 2 * ltog);
+                            u8 ltl = (ltph >> 3) & 0x1f;
+                            if ((ltph & 3) == 3 && ltl >= 1) {
+                                const u8 *t = (const u8 *)(BT_BASIS + F16(f, R_TXPTR + 2 * ltog));
+                                if (ltph != s1_tx_ph_alt || memcmp(t, s1_tx_alt, 5)) {
+                                    memcpy(s1_tx_alt, t, 5);
+                                    s1_tx_ph_alt = ltph;
+                                    s1_lmp_merk(0x80, t, ltl, clkn);
+                                }
+                            }
+                        }
+                        if (typ0 != 0 && typ0 != 1 && BER.n_lm < L_MERK) { /* 15y: die ERSTEN L_MERK Pakete festhalten */
+                            int k = BER.n_lm++;
+                            u16 ph = F16(f, R_RXPHDR + 2 * idx);
+                            u8 tog = F8(f, R_TXTOG) & 1;
+                            BER.l[k].rxstat = st, BER.l[k].rxphdr = ph, BER.l[k].idx = idx;
+                            BER.l[k].link0 = F16(f, R_LINKCNTL), BER.l[k].link1 = F16(f, R_LINKCNTL + 2);
+                            BER.l[k].txphdr0 = F16(f, R_TXPHDR), BER.l[k].txphdr1 = F16(f, R_TXPHDR + 2);
+                            BER.l[k].txtog = F8(f, R_TXTOG), BER.l[k].txb0 = F8(f, R_TXBUF0CNTL), BER.l[k].txb1 = F8(f, R_TXBUF1CNTL);
+                            BER.l[k].clk16 = clkn;
+                            const u8 *q = (const u8 *)(BT_BASIS + F16(f, ((ph & 3) == 3 ? R_LMPRXPTR : R_RXPTR) + 2 * idx));
+                            const u8 *t = (const u8 *)(BT_BASIS + F16(f, R_TXPTR + 2 * tog));
+                            u16 tph = (tog ? BER.l[k].txphdr1 : BER.l[k].txphdr0);
+                            u8 rl = (ph >> 3) & 0x1f, tl = (tph >> 3) & 0x1f; /* DM1: 5-Bit-Länge */
+                            u8 llid = ph & 3, tllid = tph & 3;
+                            BER.l[k].rlen = rl, BER.l[k].tlen = tl;
+                            BER.l[k].rllid = llid, BER.l[k].tllid = tllid;
+                            for (int b = 0; b < 16; b++) {
+                                BER.l[k].rx[b] = b < rl ? q[b] : 0;   /* nur gültige Bytes, kein Puffer-Rest */
+                            }
+                            for (int b = 0; b < 11; b++) {
+                                BER.l[k].tx[b] = b < tl ? t[b] : 0;
+                            }
+                            /* LMP nur bei LLID 3 und Länge ≥1; Opcode = Byte0>>1, TID = Byte0&1 */
+                            if (llid == 3 && rl >= 1) {
+                                u8 op = q[0] >> 1;
+                                if (op == 11) BER.lmp_aurand++;
+                                if (op == 12) BER.lmp_sres++;
+                                if (op == 17) BER.lmp_encreq++;
+                                if (op == 7) BER.lmp_detach_rx++;
+                            }
+                            if (tllid == 3 && tl >= 1 && (t[0] >> 1) == 7) BER.lmp_detach_tx++;
+                            if (llid == 3 && rl >= 1 && (q[0] >> 1) == 49) BER.setupc_rx++;   /* setup_complete von Switch */
+                            if (tllid == 3 && tl >= 1 && (t[0] >> 1) == 49) BER.setupc_tx++;  /* von uns */
+                            if (llid == 3 && rl >= 1 && (q[0] >> 1) == 3) BER.acc_rx++;        /* accepted von Switch */
+                            if (llid == 3 && rl >= 1 && (q[0] >> 1) == 51) BER.hcr_rx++;       /* host_connection_req von Switch */
+                            if (tllid == 3 && tl >= 1 && (t[0] >> 1) == 3) BER.acc_tx++;        /* accepted von uns */
+                            if (tllid == 3 && tl >= 1 && (t[0] >> 1) == 51) BER.hcr_tx++;       /* host_connection_req von uns */
+                            /* 15z: Switch-Features-/Version-Austausch gesehen? features_req_ext = escape3 (fe 03) */
+                            if (llid == 3 && rl >= 2 && (q[0] >> 1) == 127 && q[1] == 3) s1_feat_ext = 1;
+                            if (llid == 3 && rl >= 1 && (q[0] >> 1) == 39) s1_feat_ext = 1; /* features_req */
+                            /* 15x: AFH. SET_AFH = Opcode 60, 16 Byte: op, instant[4], mode, map[10] */
+                            if (llid == 3 && rl >= 16 && (q[0] >> 1) == 60 && !BER.afh_seen) {
+                                BER.afh_seen = 1;
+                                BER.afh_instant = q[1] | (u32)q[2] << 8 | (u32)q[3] << 16 | (u32)q[4] << 24;
+                                BER.afh_mode = q[5];
+                                for (int b = 0; b < 10; b++) BER.afh_map[b] = q[6 + b];
+                                BER.afh_rx_clkn = clkn;
+                            }
+                            if (llid == 3 && rl >= 1) {
+                                if (BER.afh_seen) BER.rx_nach_afh++; else BER.rx_vor_afh++;
+                            }
+                        }
+                        BER.n_l_rx++;
+                        BER.letzte_rx_clkn = clkn;
+                        if ((st >> 8) == 0x8f) {
+                            BER.n_l_8f++;
+                            /* 15h: LMP-PDU der Switch mit Opcode-Byte 0 (am Gerät 15g: 00 04 00 2d) nicht ablehnen.
+                             * Unsere Bibliothek antwortet sonst LMP_not_accepted (08 00 1a), danach gibt die Switch auf.
+                             * Quelle: 608/NS1-Wakeup-Demo bb_lmp.c unterdrückt genau diese Antwort (not_accepted auf
+                             * Opcode 0). Länge 0 → connection_rx_handler verwirft die PDU (__clean_reg_rxfull). */
+                            u16 ph = F16(f, R_RXPHDR + 2 * idx);
+                            u8 typ = st & 0xf;
+                            /* 16l: Werk 0x344e8 verbraucht die Opcode-0-PDUs der Switch selbst (kein not_accepted)
+                             * und antwortet; hier: der Bibliothek entziehen (Länge 0), Antwort sendet s1_hcr_takt. */
+                            if (S1_OPCODE0_WEG && (ph & 3) == 3 && ((ph >> 3) & 0x3ff) && typ != 0 && typ != 1 &&
+                                typ != 2 && typ != 9) {
+                                const u8 *q = (const u8 *)(BT_BASIS + F16(f, R_LMPRXPTR + 2 * idx));
+                                if ((q[0] & 0xfe) == 0x00) {
+                                    u8 len = (ph >> 3) & 0x1f;
+                                    memcpy(BER.op0_letzt, q, 4);
+                                    if (len >= 4 && q[1] == 4 && q[2] == 0 && q[3] == BER.op0_summe) {
+                                        BER.op0_a_rx++;
+                                        s1_op0 |= 1;
+                                    } else if (len >= 4 && q[1] == 0 && q[2] == 0x32 && q[3] == 0x15) {
+                                        BER.op0_b_rx++;
+                                        s1_op0_tid = q[0] & 1;
+                                        s1_op0 |= 2;
+                                    } else {
+                                        BER.op0_andere++;
+                                    }
+                                    F16(f, R_RXPHDR + 2 * idx) = ph & 7;
+                                    BER.n_l_weg++;
+                                }
+                            }
+                        }
+                    } else {
+                        BER.n_l_andere++;
+                    }
+                }
+                bredr_link_rx_irq_handler(f);
+            }
+        }
+    }
+    if (REG(0x1C0010) & 0x400) {
+        REG(0x1C0018) |= 0x400;
+    }
+    if (REG(0x1C0010) & 0x200) {
+        REG(0x1C0018) |= 0x200;
+        BER.n_irq_takt++;
+        bredr_link_timeout_irq_handler();
+        struct s1_ctx *c = s1;
+        if (c && c->zustand == 2) {
+            s1_takt(c);
+        } else if (c) {
+            BER.n_takt_fremd++;
+        }
+    }
+    if (REG(0x1C0010) & 0x800) {
+        REG(0x1C0018) |= 0x800;
+    }
+    if (REG(0x1C0010) & 4) {
+        REG(0x1C0018) |= 4;
+    }
+}
+
+/* Bericht ausgeben (kurz: nach einem Neustart liefert der Nachlass nur die letzten 1024 Zeichen) */
+int c2_s1_weck_bericht(void)
+{
+    if (BER.magic != BERICHT_MAGIC) {
+        c2_log("switch1: kein Weckbericht\r\n");
+        return 0;
+    }
+    static const char *const ENDE[] = {"laeuft", "Frist", "angenommen", "Notabbruch"};
+    if (AUTO.magic == AUTO_MAGIC) {
+        char z[40], *q = z;
+        for (int i = 0; i < AUTO.n_verlauf && i < 16; i++) {
+            q += sprintf(q, "%x", AUTO.verlauf[i]);
+        }
+        *q = 0;
+        c2_log("switch1: AUTO versuche=%u p2=%u link=%u HID=%u frist=%u abbruch=%u hid_letzt=%u.%us verlauf=%s\r\n",
+               AUTO.versuche, AUTO.p2, AUTO.link, AUTO.hid, AUTO.frist, AUTO.abbruch, AUTO.hid_letzt_ds / 10,
+               AUTO.hid_letzt_ds % 10, z);
+    }
+    c2_log("switch1: weck %s rx=%u 8f=%u takt=%u s0/2/4/5=%u/%u/%u/%u fort=%u unter=%u pwr=%08lx/%08lx\r\n",
+           ENDE[BER.ende < 4 ? BER.ende : 0], BER.n_rx, BER.n_8f, BER.n_takt, BER.n_schritt[0], BER.n_schritt[2], BER.n_schritt[4],
+           BER.n_schritt[5], BER.n_fort, BER.n_unter, BER.txpwer, BER.txset);
+    c2_log("switch1: mess irq=%u rx=%u takt=%u fremd=%u vek=%u scheibe=%lu..%lu summe=%lu slots tasks=%u\r\n", BER.n_irq,
+           BER.n_irq_rx, BER.n_irq_takt, BER.n_takt_fremd, BER.n_vek_fehler, BER.scheibe_min, BER.scheibe_max,
+           BER.scheibe_summe, BER.n_tasks);
+    for (int i = 0; i < BER.n_tasks && i < 6; i++) {
+        c2_log("switch1: task%d typ=%04x run_slot=%u sta=%u state=%u prio=%u\r\n", i, BER.task[i].type,
+               BER.task[i].run_slot, BER.task[i].sta, BER.task[i].state, BER.task[i].prio);
+    }
+    for (int i = 0; i < BER.n_rx && i < RX_MERK; i++) {
+        u8 *d = BER.rx[i].d;
+        c2_log("switch1: rx%d st=%04x h=%04x bit=%u clk=%07lx %u/%u k%u: %02x %02x%02x%02x%02x%02x%02x %02x%02x%02x%02x\r\n",
+               i, BER.rx[i].rxstat, BER.rx[i].rxphdr, BER.rx[i].rxbit, BER.rx[i].clkn, BER.rx[i].schritt, BER.rx[i].rx_schritt,
+               BER.rx[i].kanal, d[0], d[6], d[5], d[4], d[3], d[2], d[1], d[13], d[14], d[15], d[16]);
