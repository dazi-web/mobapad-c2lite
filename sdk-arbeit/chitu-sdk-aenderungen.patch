+#define S1_TRENNEN 0     /* 15m: 1 = nach 2 s trennen und normal anrufen; 15o: aus */
+#define S1_OPCODE0_WEG 1 /* 16l: 1 = Opcode-0-PDUs der Switch selbst behandeln wie Werk 0x344e8 (verbrauchen + antworten) */
