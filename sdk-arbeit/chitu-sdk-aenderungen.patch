+static const u8 AGC[6] = {8, 8, 21, 21, 27, 27};  /* Werk app.bin 0x2391b */
+static const u8 KANAL[3] = {0, 0, 78};            /* Werk app.bin 0x38cac (2402, 2402, 2480 MHz) */
