+/* 15p: automatischer Dauertest im Modus Switch 1 (aus c2_switch.c alle 10 ms). Ohne Verbindung frühestens 40 s nach
+ * dem Start und dann 60 s nach jedem Versuch oder jeder Trennung ein Weckablauf (bis zu 5 Läufe). Erfolg = HID-
+ * Verbindung binnen 30 s. Die Switch schläft mit „Automatischer Standby“ von selbst wieder ein. */
+#define S1_AUTOTEST 0 /* 16i: aus – weckte die Switch 60 s nach jedem Einschlafen erneut; Wecken nur per Home */
+int c2_s1_weck_dauer(int n);
+void c2_s1_autotest_takt(void)
+{
+    if (!S1_AUTOTEST) {
+        return;
+    }
+    static u32 t, naechster = 2000, start;
+    static u8 laeuft, neu = 1;
+    extern int c2_switch_bt_verbunden(void);
+    t++;
+    int verbunden = c2_switch_bt_verbunden();
+    if (laeuft) {
+        int busy = c2_s1_beschaeftigt();
+        if (verbunden || (!busy && t - start > 3000)) {
+            u8 v = BER.magic == BERICHT_MAGIC ? (BER.ende & 3) : 0;
+            if (BER.magic == BERICHT_MAGIC && BER.hcr == 1) {
+                v |= 4, AUTO.link++;
+            }
+            if (v == 2 || (v & 3) == 2) {
+                AUTO.p2++;
+            }
+            if ((v & 3) == 1) {
+                AUTO.frist++;
+            } else if ((v & 3) == 3) {
+                AUTO.abbruch++;
+            }
+            if (verbunden) {
+                v |= 8, AUTO.hid++;
+                AUTO.hid_letzt_ds = (t - start) / 10;
+            }
+            if (AUTO.n_verlauf < 16) {
+                AUTO.verlauf[AUTO.n_verlauf++] = v;
+            }
+            laeuft = 0;
+            naechster = t + 300; /* 15u: ohne Weck-Link schnell wieder versuchen, Listen-Fenster der Switch treffen */
+            if (v & 4) {
+                naechster = t + 0x7FFFFFF; /* nach dem ersten Weck-Link anhalten, Bericht bleibt erhalten */
+                c2_log("switch1: AUTO angehalten nach Weck-Link\r\n");
+            }
+        }
+        return;
+    }
+    if (verbunden) {
+        naechster = t + 6000; /* erst 60 s nach der Trennung wieder versuchen (Switch sicher eingeschlafen) */
+        return;
+    }
+    if ((s32)(t - naechster) < 0 || c2_s1_beschaeftigt()) {
+        return;
+    }
+    if (neu || AUTO.magic != AUTO_MAGIC) {
+        memset(&AUTO, 0, sizeof(AUTO));
+        AUTO.magic = AUTO_MAGIC;
+        neu = 0;
+    }
+    if (c2_s1_weck_dauer(5) == 0) {
+        AUTO.versuche++;
+        laeuft = 1;
+        start = t;
+        c2_log("switch1: AUTO Versuch %u\r\n", AUTO.versuche);
+    } else {
+        naechster = t + 1000;
+    }
+}
+
+
+/* c2_switch.c: kein normaler Anruf während Weckablauf (Läufe) oder Beobachtung des Weck-Links */
+int c2_s1_beschaeftigt(void)
+{
+    return s1 || s1_freigeben || s1_wiederholen_laeuft || s1_beob;
+}
+
+/* c2_switch.c: jedes Bluetooth-Ereignis nach einer Phase 4 auch in den RAM1-Bericht (übersteht den Schieberwechsel;
+ * im Modus Switch 1 gibt es kein USB-seriell). Nur Beobachtung. */
+void c2_s1_ereignis(u8 art, u8 ev, u8 wert, u8 rx, u16 zeit)
+{
+    if (!s1_spiegel || BER.magic != BERICHT_MAGIC || BER.ende != 2 || !BER.link || BER.n_ev >= EV_MERK) {
+        return;
+    }
+    int i = BER.n_ev++;
+    BER.ev[i].art = art, BER.ev[i].ev = ev, BER.ev[i].wert = wert, BER.ev[i].rx = rx, BER.ev[i].zeit = zeit;
+}
+
+/* Während des Weckens page scan und inquiry scan aus: sonst teilt der Zeitplaner unserem Task nur 32 Slots zu
+ * (am Gerät gemessen, 15c) und der 64-Slot-Zeitgeber des Werks-Ablaufs löst nie aus. Das Werk passt den Weck-Task
+ * für die leere Taskliste an (FUN_01e0a200), läuft also ohne Konkurrenz. */
+void bt_wait_phone_connect_control_ext(u8 inquiry_en, u8 page_scan_en);
+static u8 s1_scans_aus;
+
+static void s1_scans_wieder(void)
+{
+    if (s1_scans_aus && BER.ende == 2 && BER.link) {
+        /* Phase 4 hat eine Verbindung angelegt: die App schaltet die Scans beim Verbinden aus und beim Trennen
+         * wieder ein (app_comm_edr.c), also hier nichts tun */
+        s1_scans_aus = 0;
+        c2_log("switch1: Phase 4, Scans bleiben bei der App\r\n");
+        return;
+    }
+    if (s1_scans_aus) {
+        s1_scans_aus = 0;
+        bt_wait_phone_connect_control_ext(1, 1);
+        c2_log("switch1: Scans wieder an\r\n");
+    }
+}
+
+/* 15i: Nach Phase 4 sendet der C2 Lite als Peripheral selbst LMP_host_connection_req (Opcode 51). Quelle:
+ * 608/NS1-Wakeup-Demo bb_handoff.c – beim Linkstart stößt der Nachbau sofort LMP_host_connection_req an; Kommentar:
+ * „Die Switch sendet kein LMP, bis sie diese PDU empfängt“, sie antwortet mit derselben PDU. Unsere Bibliothek wartet
+ * als Slave nur auf die der Konsole (am Gerät 15h: danach nur POLL, Abbruch nach ~110 ms).
+ * Bibliothek: lmp_request(conn, Format, Opcode<<1, …) wie lmp_tx_version_req (74 = 37<<1); Format "l" = 1 Byte;
+ * lmp_request setzt bei Rolle Slave (conn+138 == 1) das TID-Bit selbst → 0x67. Verbindung über Handle
+ * (lmp_private_handler_for_remote_addr wie c2_switch.c, dann lmp_conn_for_handle); Prüfung conn+220 == unser Link. */
+u16 lmp_private_handler_for_remote_addr(u8 *addr, int link_type);
+void *lmp_conn_for_handle(u16 handle);
+/* SDK-Helfer setzt den lokalen HCR-Pending-Zustand (conn->state|=1) vor dem Senden. */
+/* 16g: HCR nicht mehr von Hand – die Bibliothek legt die Verbindung an (lmp_event_handler) */
+static u16 s1_hcr_timer;
+
+static void s1_hcr_takt(void *priv)
+{
+    if (BER.magic != BERICHT_MAGIC) {
+        goto ende;
+    }
+    if (BER.hcr == 1) {
+        return; /* 15s: gesendet, warten – die Switch treibt Auth/Verschlüsselung, HID öffnet c2_switch.c */
+    }
+    BER.hcr_versuche++;
+    if (BER.ende == 2 && BER.link) {
+        /* 16g WERKS-WEG: Die LMP-Verbindung wie die Werks-Firmware über die Bibliothek anlegen, NICHT die HCR von
+         * Hand senden. Werk: NS1-IRQ Zustand 5 ruft FUN_01e3baaa, das den Linktask baut und intern das Ereignis
+         * 0x400001 postet; dessen Handler FUN_01e36f98 ruft lmp_connection_start(link, role=0 = Initiator). Die
+         * Bibliotheks-Verbindungsmaschine sendet dann HCR in der richtigen Reihenfolge, verarbeitet accepted,
+         * sendet setup_complete und fährt Authentifizierung/Verschlüsselung selbst. SDK: lmp_event_handler({link,
+         * 1, 0}) ruft genau dieses lmp_connection_start. */
+        /* 16j: create_link_connection stellt selbst LMP_EVENT {link, 1, role=1} in die Bibliotheks-Warteschlange
+         * (bredr_link.c.ll, Ende von create_link_connection) → lmp_connection_start(link, 1) = Slave-Maschine, die nur
+         * wartet. lmp_acl_link hat Platz für genau EINE Verbindung (nm: 0x118 = 280 Byte = 1 lmp_connection), und
+         * lmp_connection_start prüft nicht auf Bestehendes. 16g rief lmp_event_handler({link,1,0}) im 10-ms-Takt:
+         * gewann der Takt, scheiterte das Nachzügler-Ereignis (lmp_create_conn NULL → Assert/Reset); gewann die
+         * Bibliothek, blieb Slave (hcr=7, am 2.11. 6 von 6). Jetzt: auf die Verbindung der Bibliothek warten und sie
+         * mit deren eigenem Rolle-0-Zweig (wie lmp_connection_start bei role==0) zur Master-Maschine machen. */
+        extern void c2_switch_weck_link(void);
+        extern void *lmp_conn_for_link(void *link);
+        extern void lmp_role_machine_handler_register(void *conn, void *handle);
+        extern int lmp_master_machine(void *conn, void *rx, void *hci_cmd);
+        extern void lmp_master_init(void *conn);
+        u8 *conn = lmp_conn_for_link((void *)BER.link);
+        if (!conn) {
+            if (BER.hcr_versuche < 500) {
+                return; /* Ereignis der Bibliothek noch nicht verarbeitet */
+            }
+            BER.hcr = 9; /* binnen 5 s keine Verbindung angelegt */
+            goto ende;
+        }
+        BER.hcr_rolle = conn[138]; /* lmp_connection.core.role (IR: Feld 28.2; 15i: conn+138 == 1 Slave) */
+#if 0
+        /* 16j: Umstellung auf Rolle 0 – am Gerät widerlegt (TID 0 → Switch: not_accepted 0x24). Werk tut das nicht:
+         * 0x3b9ea postet {link,1,1}, Handler 0x36ed8 startet die Slave-Maschine (objdump, STATUS 16j). */
+        if (conn[138] == 1) {
+            conn[138] = 0;
+            lmp_role_machine_handler_register(conn, (void *)lmp_master_machine);
+            lmp_master_init(conn);
+        }
+#endif
+        (void)lmp_role_machine_handler_register, (void)lmp_master_machine, (void)lmp_master_init;
+        if (BER.hcr != 10) {
+            BER.hcr = 10; /* 16k Werks-Weg: Bibliothek fährt die Slave-Maschine wie das Werk */
+            BER.hcr_slot = READ_SLOT_CLK() - BER.p4_slot;
+            c2_switch_weck_link(); /* HID nach der (Switch-getriebenen) Verschlüsselung */
+        }
+        /* 16l: Antworten auf die Opcode-0-PDUs wie Werk 0x3451c (lmp_request, TID nach Rolle) und 0x34e4e
+         * (lmp_response, TID der empfangenen PDU = lmp_connection.tran_id, SDK-Feld 1) */
+        extern int lmp_request(void *conn, const char *format, ...);
+        extern int lmp_response(void *conn, const char *format, ...);
+        u8 faellig = s1_op0;
+        if (faellig & 1) {
+            s1_op0 &= ~1;
+            lmp_request(conn, "1111", 0x01, 0x04, 0x00, 0x00);
+            BER.op0_a_tx++;
+            BER.op0_a_slot = READ_SLOT_CLK() - BER.p4_slot;
+        }
+        if (faellig & 2) {
+            s1_op0 &= ~2;
+            conn[1] = s1_op0_tid;
+            lmp_response(conn, "1111111111", 0x00, 0x01, 0x32, 0x1d, 0, 0, 0, 0, 0, 0);
+            BER.op0_b_tx++;
+        }
+        if (BER.hcr_versuche < 800) {
+            return; /* bis 8 s nach dem Weckstart weiter auf Opcode-0-PDUs der Switch achten */
+        }
+        goto ende;
+    }
+    if (BER.hcr_versuche < 500) {
+        return;
+    }
+ende:
+    if (s1_hcr_timer) {
+        sys_timer_del(s1_hcr_timer);
+        s1_hcr_timer = 0;
+    }
+}
+
+static void s1_bericht(void *priv)
+{
+    if (BER.aktiv) { /* Notbremse: die Frist hätte längst greifen müssen */
+        local_irq_disable();
+        s1_ende(3);
+        local_irq_enable();
+    }
+    if (s1_freigeben) {
+        bt_free(s1_freigeben);
+        s1_freigeben = NULL;
+    }
+    c2_s1_weck_bericht();
+    if (s1_beob) {
+        sys_timeout_add(NULL, s1_beob_ende, 5000);
+    }
+    if (s1_wiederholen && BER.ende != 2) {
+        s1_wiederholen--;
+        s1_wiederholen_laeuft = 1;
+        sys_timeout_add(NULL, s1_naechster, 300);
+    } else {
+        s1_wiederholen = 0;
+        s1_wiederholen_laeuft = 0;
+        s1_scans_wieder();
+    }
+}
+
+static void s1_naechster(void *priv)
+{
+    if (!s1_wiederholen_laeuft) {
+        s1_scans_wieder();
+        return;
+    }
+    int r = c2_s1_weck_senden();
+    if (r) {
+        c2_log("switch1: weck Start fehlgeschlagen (%d)\r\n", r);
+        s1_wiederholen = 0;
+        s1_wiederholen_laeuft = 0;
+        s1_scans_wieder();
+    }
+}
+
+/* Start für Befehl und Kamera+Home: Scans aus, nach 200 ms bis zu n Läufe zu 3,2 s, bis Phase 2+3 angenommen sind
+ * (höchstens 20), danach Scans wieder an. */
+int c2_s1_weck_dauer(int n)
+{
+    if (n < 1) {
+        n = 1;
+    }
+    if (n > 20) {
+        n = 20;
+    }
+    if (s1 || s1_freigeben || s1_wiederholen_laeuft) {
+        return -16;
+    }
+    s1_wiederholen = n - 1;
+    s1_wiederholen_laeuft = 1;
+    s1_scans_aus = 1;
+    user_send_cmd_prepare(USER_CTRL_PAGE_CANCEL, 0, NULL); /* laufenden normalen Anruf abbrechen */
+    bt_wait_phone_connect_control_ext(0, 0);
+    sys_timeout_add(NULL, s1_naechster, 200);
+    return 0;
+}
+
+void c2_s1_weck_stopp(void)
+{
+    s1_wiederholen = 0;
+    if (!s1 && !BER.aktiv) {
+        s1_wiederholen_laeuft = 0;
+    }
+}
+
+/* Start wie Werk 0x391b2 (link_rand_page_enable(Konsole, 3200 ms)). Rückgabe 0 = läuft, sonst Fehler. */
+int c2_s1_weck_senden(void)
+{
+    u8 konsole[6];
+    if (s1 || s1_freigeben) {
+        return -16;
+    }
+    if (!restore_remote_device_info_opt((bd_addr_t *)konsole, 1, get_remote_dev_info_index())) {
+        return -2;
+    }
+    /* Klassisches Basisband eingerichtet? bredr_bd_init setzt die Basis auf bd_base. Sonst würde
+     * bredr_bd_frame_enable die CPU zurücksetzen (Bereichsprüfung gegen die Basis). */
+    if (BT_BASIS != (u32)bd_base) {
+        return -19;
+    }
+    void *f = bredr_bd_get_frame();
+    if (!f) {
+        return -12;
+    }
+    struct s1_ctx *c = bt_malloc(sizeof(struct s1_ctx));
+    if (!c) {
+        bredr_bd_put_frame(f);
+        return -12;
+    }
+    if ((u32)c - BT_BASIS >= 32767 - sizeof(struct s1_ctx)) {
+        bt_free(c);
+        bredr_bd_put_frame(f);
+        return -22;
+    }
+    memset(c, 0, sizeof(*c));
+    if (s1_beob) {
+        return -16; /* Beobachtung des letzten Links läuft noch */
+    }
+    extern u8 c2_switch_weck_link_aktiv;
+    c2_switch_weck_link_aktiv = 0; /* 15r: sauberer Zustand je Versuch */
+    s1_feat_ext = 0;
+    s1_spiegel = 0;
+    memset(&BER, 0, sizeof(BER));
+    BER.magic = BERICHT_MAGIC;
+    /* Werks-Rahmenvorgaben (0x38e60, 0x38e84) und Leistung Index 4 (0x38dc4: TXPWER/TXSET aus der Werks-Tabelle) */
+    F16(f, R_RXMAXBUF) = 1021;
+    F16(f, R_BUFCNTL) = 0x206c;
+    F32(f, R_TXPWER) = 0x007022d9;
+    F32(f, R_TXSET) = 0x00ffffc2;
+    BER.txpwer = F32(f, R_TXPWER), BER.txset = F32(f, R_TXSET);
+    __write_reg_lmprxptr(f, 0, c->rx);
+    __write_reg_lmprxptr(f, 1, c->rx);
+    __write_reg_rxptr(f, 0, c->rx);
+    __write_reg_rxptr(f, 1, c->rx);
+    memcpy(c->konsole, konsole, 6);
+    memcpy(c->eigen, bt_get_mac_addr(), 6);
+    /* 16l: Werk 0x33bca legt in hci_param+114 die Bytesumme der eigenen Adresse ab; Werk 0x34500 vergleicht damit
+     * Byte 3 der Switch-PDU 00 04 00 xx (am Gerät 16a/16i/16k: xx = 0x2d = Summe unserer Adresse) */
+    s1_op0 = 0;
+    s1_tx_ph_alt = 0;
+    memset(s1_tx_alt, 0, sizeof(s1_tx_alt));
+    BER.op0_summe = 0;
+    for (int i = 0; i < 6; i++) {
+        BER.op0_summe += c->eigen[i];
+    }
+    bch_bytes(c->konsole_bch, c->konsole);
+    bch_bytes(c->eigen_bch, c->eigen);
+    for (int i = 0; i < 4; i++) {
+        c->konsole_bch[i] = ~c->konsole_bch[i];
+    }
+    c->schritt = 0;
+    c->lt = __get_lt_addr();
+    c->rahmen = f;
+    c->zustand = 1;
+    memcpy(c->tx, c->konsole_bch, 4);
+    BER.start_slot = READ_SLOT_CLK();
+    BER.dauer_slots = WECK_MS * 1000 / 625;
+    c->frist = (BER.start_slot + BER.dauer_slots) & 0x7FFFFFF;
+    bredr_link_v[99] |= 0x80;
+    c->task.type = 0x200;
+    c->task.run_slot = 100;
+    c->task.run_num = 1;
+    c->task.priority = 1;
+    c->task.ops = &S1_OPS;
+    c->task.sta_attribute = 1;
+    BER.aktiv = 1;
+    local_irq_disable();
+    s1 = c;
+    void (**vek)(void) = (void (**)(void))IRQ_MEM_ADDR;
+    irq27_alt = vek[IRQ_BREDR_IDX];
+    vek[IRQ_BREDR_IDX] = s1_irq;
+    local_irq_enable();
+    link_task_idle_disable();
+    link_task_add(&c->task);
+    c2_log("switch1: weck senden an %02x:%02x:%02x:%02x:%02x:%02x Weck-BCH %02x%02x%02x%02x%02x lt=%u rahmen=%08lx "
+           "ctx=%08lx basis=%08lx slot=%07lx\r\n",
+           konsole[5], konsole[4], konsole[3], konsole[2], konsole[1], konsole[0], c->konsole_bch[4],
+           c->konsole_bch[3], c->konsole_bch[2], c->konsole_bch[1], c->konsole_bch[0], c->lt, (u32)f, (u32)c,
+           BT_BASIS, BER.start_slot);
+    sys_timeout_add(NULL, s1_bericht, WECK_MS + 800);
+    if (!s1_hcr_timer) {
+        s1_hcr_timer = sys_timer_add(NULL, s1_hcr_takt, 10);
+    }
+    return 0;
+}
+
+/* Home ohne Verbindung im Modus Switch 1 (c2_switch.c, höchstens alle 3 s): derselbe Weckablauf wie Kamera + Home,
+ * bis zu 5 Läufe, Ende bei angenommener Phase 3. Danach ruft c2_switch.c eine wache Switch wieder normal an. */
+void c2_s1_wecken(void)
+{
+    int r = c2_s1_weck_dauer(5);
+    c2_log("switch1: Home -> weck senden %d\r\n", r);
+}
+
+#else
+
+int c2_s1_weck_selbsttest(void)
+{
+    return 0;
+}
+
+int c2_s1_weck_info(void)
+{
+    return 0;
+}
+
+void c2_s1_wecken(void)
+{
+}
+
+int c2_s1_weck_senden(void)
+{
+    return -1;
+}
+
+int c2_s1_weck_bericht(void)
+{
+    return 0;
+}
+
+int c2_s1_weck_dauer(int n)
+{
+    return -1;
+}
+
+void c2_s1_weck_stopp(void)
+{
+}
+
+void c2_s1_ereignis(u8 art, u8 ev, u8 wert, u8 rx, u16 zeit)
+{
+}
+
+int c2_s1_beschaeftigt(void)
+{
+    return 0;
+}
+
+
+void c2_s1_autotest_takt(void)
+{
+}
+
