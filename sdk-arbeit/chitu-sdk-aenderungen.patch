+}
+
+static void c2_usb_reg_schreiben(u32 reg, u32 wert)
+{
+    if (!(JL_USB->CON0 & BIT(2))) {
+        return;
+    }
+    JL_USB->CON1 = ((reg << 8) & 0xFFFF) | (wert & 0xFF);
+    for (u32 i = 0; i < 20000; i++) {
+        if (JL_USB->CON1 & BIT(15)) {
+            return;
+        }
+    }
+}
+
+/* Auch für den kabelgebundenen Pro Controller im Switch-Modus (custom_hid.c, Stufe 14b) */
+int c2_ep_tx_belegt(u32 ep)
+{
+    local_irq_disable();
+    c2_usb_reg_schreiben(14, ep); /* Index */
+    u32 csr = c2_usb_reg_lesen(17) | c2_usb_reg_lesen(18) << 8;
+    local_irq_enable();
+    return (csr & 0x4001) == 1;
+}
+
+/* Gamepad-Report senden; 0 = nicht gesendet (USB nicht bereit oder vorheriger Report noch nicht abgeholt) */
+u32 c2_hid_senden(const u8 *report, u32 len)
+{
+    if (!hid_bereit || usb_get_ep_status(0, HID_EP_IN) || c2_ep_tx_belegt(HID_EP_IN)) {
+        return 0;
+    }
+    return usb_g_intr_write(0, HID_EP_IN, report, len);
+}
