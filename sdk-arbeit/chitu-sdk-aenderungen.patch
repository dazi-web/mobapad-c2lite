+static void eingang(u32 pin, int pull_up, int pull_down)
+{
+    if (pin >= IO_PORT_PR_00) {
+        u8 pr = pin - IO_PORT_PR_00;
+        rtc_port_pr_in(pr);
+        rtc_port_pr_die(pr, 1);
+        rtc_port_pr_pu(pr, pull_up);
+        rtc_port_pr_pd(pr, pull_down);
+        return;
+    }
+    gpio_set_direction(pin, 1);
+    gpio_set_die(pin, 1);
+    gpio_set_pull_up(pin, pull_up);
+    gpio_set_pull_down(pin, pull_down);
+}
+
+/* Liest eine Phase und setzt die Rollen-Bits der gedrückten Tasten */
+static u64 phase_lesen(const struct taste *t, int n, int gedrueckt_high)
+{
+    for (int i = 0; i < n; i++) {
+        eingang(t[i].pin, !gedrueckt_high, gedrueckt_high);
+    }
+    for (volatile int w = 0; w < 1000; w++) { /* Pulls und PA8 einschwingen lassen (einige µs) */
+    }
+    u64 bits = 0;
+    for (int i = 0; i < n; i++) {
+        int pegel = t[i].pin >= IO_PORT_PR_00 ? rtc_port_pr_read(t[i].pin - IO_PORT_PR_00) : gpio_read(t[i].pin);
+        if (!!pegel == gedrueckt_high) {
+            bits |= 1ULL << t[i].rolle;
+        }
+    }
+    return bits;
+}
+
+static const char *rollen_name(int r)
+{
+    static const struct taste *const LISTEN[] = {PHASE_A, PHASE_B, DIREKT};
+    static const int N[] = {ARRAY_SIZE(PHASE_A), ARRAY_SIZE(PHASE_B), ARRAY_SIZE(DIREKT)};
+    for (int l = 0; l < 3; l++) {
+        for (int i = 0; i < N[l]; i++) {
+            if (LISTEN[l][i].rolle == r) {
+                return LISTEN[l][i].name;
+            }
+        }
+    }
+    return "?";
+}
+
+/* Steuerkreuz -> Hat (0 = hoch, im Uhrzeigersinn in 45°-Schritten, 8 = Mitte) */
+static u8 hat(u64 r)
+{
+    int h = !!(r & (1ULL << K_HOCH)), rt = !!(r & (1ULL << K_RECHTS)), u = !!(r & (1ULL << K_RUNTER)),
+        l = !!(r & (1ULL << K_LINKS));
+    if (h && rt) return 1;
+    if (rt && u) return 3;
+    if (u && l) return 5;
+    if (l && h) return 7;
+    if (h) return 0;
+    if (rt) return 2;
+    if (u) return 4;
+    if (l) return 6;
+    return 8;
+}
+
+/* Rohwert -> 0..1023 um die beim Start gemessene Mitte, mit kleiner Totzone */
+static u16 achse(u32 roh, u32 m)
+{
+    int d = (int)roh - (int)m;
+    if (d > -(int)einst.totzone && d < (int)einst.totzone) {
+        return 512;
+    }
+    int v = 512 + d * 511 / STICK_HUB;
+    return v < 0 ? 0 : v > 1023 ? 1023 : v;
+}
+
+/* Failsafe: Home + Minus 5 s halten, während USB-5V anliegt -> ROM-Download-Modus (BR23 UBOOT1.00 am USB), ohne
+ * ESP32-Schlüsselsender. go_mask_usb_updata() (msd_upgrade.c) setzt die ROM-Boot-Markierung
+ * nvram_set_boot_state(UPGRADE_USB_SOFT_KEY) und löst einen System-Reset aus. Nur mit USB, damit der Chip nicht ohne
+ * Host im Download-Modus hängt (zurück dann nur über Strom aus). */
+#define RETTUNG_TASTEN ((1ULL << T_HOME) | (1ULL << T_MINUS))
+#define RETTUNG_MS 5000
+void go_mask_usb_updata(void);
+static u32 gehalten; /* Runden, die Home + Minus schon gehalten sind (auch für die Anzeige) */
+static void rettung_pruefen(u64 r)
+{
+    if ((r & RETTUNG_TASTEN) != RETTUNG_TASTEN || !gpio_read(IO_PORTB_05)) {
+        gehalten = 0;
+        return;
+    }
+    gehalten++;
+    if (gehalten == 1000 / TAKT_MS) {
+        c2_log("Rettung: Home + Minus weiter halten -> Download-Modus in 4 s\r\n");
+    }
+    if (gehalten >= RETTUNG_MS / TAKT_MS) {
+        c2_log("Rettung: starte in den ROM-Download-Modus (Licht rot)\r\n");
+        c2_download_springen();
+    }
+}
+
+/* LEDs: 7 Stück an den Tastenpins (an = low), Versorgung über PA7 (high). Wie die Werks-Firmware im Zeitmultiplex
+ * mit der Tastenabfrage: vor dem Lesen PA7 low, danach die LED-Pins als Ausgänge setzen und PA7 high.
+ * Bit n der Maske = LED_PIN[n] (Reihenfolge der Werks-Tabelle). Am Gerät geprüft: 0x04..0x20 = Spieler 1..4,
+ * 0x01/0x02/0x40 nicht sichtbar. */
+static const u32 LED_PIN[7] = {IO_PORTC_00, IO_PORTC_01, IO_PORTC_05, IO_PORTC_04, IO_PORTC_03, IO_PORTC_02, IO_PORTA_12};
+static volatile u8 led_maske;   /* diese Runde ausgegeben */
+static volatile u8 led_manuell; /* vom Befehl „led“ gesetzt; C2_LED_AUTO = Zustandsanzeige */
+#define C2_LED_AUTO 0xFF
+
+/* maske 0..0x7F: fest (überschreibt die Zustandsanzeige), 0xFF: zurück zur Zustandsanzeige */
+void c2_led_setzen(u8 maske)
+{
+    led_manuell = maske == C2_LED_AUTO ? C2_LED_AUTO : maske & 0x7F;
+}
+
+/* Akku (am Gerät gemessen, 30.10.):
+ *   Akkuspannung über den internen Kanal AD_CH_VBAT (×4): stimmt im Akkubetrieb und am Kabel (4172 / 4088 mV).
+ *   PB4 (1:2-Teiler): im Akkubetrieb = VBAT/2 (2077 mV); am Kabel zieht der Lade-IC PB4 herunter, solange er lädt
+ *   (1418 mV), und lässt es los, wenn der Akku voll ist (dann ~2190 mV). Daraus „lädt“ / „voll“.
+ * Die Werks-Stufen (PB4 <= 1700/1750/1800/1980) passen nicht zu diesen Werten und werden nicht benutzt. */
+static u16 akku_mv;   /* Akkuspannung (VBAT), gleitend gemittelt */
+static u16 pb4_mv;    /* Pin-Spannung PB4, gleitend gemittelt */
+
+static void akku_messen(void)
+{
+    u16 v = adc_get_voltage(AD_CH_VBAT) * 4, p = adc_get_voltage(AD_CH_PB4);
+    akku_mv = akku_mv ? (akku_mv * 7 + v) / 8 : v;
+    pb4_mv = pb4_mv ? (pb4_mv * 7 + p) / 8 : p;
+}
+
+/* Lädt der Akku gerade? Nur am USB: PB4 deutlich unter VBAT/2 */
+u8 c2_akku_laedt(void)
+{
+#if C2_CHITU
+    /* Chitu (CRh, gemessen 4.11.): VBAT liest am USB-Kabel ~4,86 V, der Vergleich mit VBAT/2 meldete dort auch bei vollem
+     * Akku „lädt“. PB4 beim Laden 1383..1551 mV (Dock), voll 2155..2157 mV (Kabel) -> feste Schwelle dazwischen. */
+    return gpio_read(IO_PORTB_05) && pb4_mv && pb4_mv < 1800;
+#else
+    return gpio_read(IO_PORTB_05) && akku_mv && pb4_mv * 2 + 400 < akku_mv;
+#endif
+}
+
+/* LiPo-Kennlinie grob (Ruhespannung): 3,40 V = 0 %, 4,15 V = 100 % */
+static u8 prozent_von(u16 v)
+{
+    static const u16 MV[] = {3400, 3600, 3700, 3750, 3800, 3850, 3900, 3950, 4000, 4050, 4100, 4150};
+    static const u8 PROZENT[] = {0, 8, 15, 25, 35, 45, 55, 65, 75, 85, 95, 100};
+    if (!v) {
+        return 0;
+    }
+    if (v <= MV[0]) {
+        return 1;
+    }
+    for (int i = 1; i < (int)(sizeof(MV) / sizeof(MV[0])); i++) {
+        if (v < MV[i]) {
+            return PROZENT[i - 1] + (u32)(PROZENT[i] - PROZENT[i - 1]) * (v - MV[i - 1]) / (MV[i] - MV[i - 1]);
+        }
+    }
+    return 100;
+}
+
+u8 c2_akku_prozent(void)
+{
+    return prozent_von(akku_mv);
+}
+
+/* Fehlersuche Akkumessung: Einstellungen von PB4 (und PB11, Versorgung) und Rohwerte */
+void c2_akku_diag(void)
+{
+    c2_log("akku: vbat=%umV pb4=%umV usb5v=%d laedt=%d prozent=%u\r\n", akku_mv, pb4_mv, gpio_read(IO_PORTB_05),
+           c2_akku_laedt(), c2_akku_prozent());
+    c2_log("akku: pb4 dir=%lu die=%lu dieh=%lu pu=%lu pd=%lu out=%lu | pb11 dir=%lu out=%lu hd=%lu | roh=%u mv=%u vbat=%u\r\n",
+           (JL_PORTB->DIR >> 4) & 1, (JL_PORTB->DIE >> 4) & 1, (JL_PORTB->DIEH >> 4) & 1, (JL_PORTB->PU >> 4) & 1,
+           (JL_PORTB->PD >> 4) & 1, (JL_PORTB->OUT >> 4) & 1, (JL_PORTB->DIR >> 11) & 1, (JL_PORTB->OUT >> 11) & 1,
+           (JL_PORTB->HD >> 11) & 1, adc_get_value(AD_CH_PB4), adc_get_voltage(AD_CH_PB4), adc_get_voltage(AD_CH_VBAT) * 4);
+}
