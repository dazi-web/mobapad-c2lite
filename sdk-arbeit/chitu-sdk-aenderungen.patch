diff --git a/apps/hid/modules/c2lite/c2_xinput.c b/apps/hid/modules/c2lite/c2_xinput.c
new file mode 100644
index 0000000..89390c6
--- /dev/null
+++ b/apps/hid/modules/c2lite/c2_xinput.c
@@ -0,0 +1,165 @@
+/* C2 Lite, PC-Modus über USB: XInput (Xbox-360-Protokoll) wie die Werks-Firmware (Schnittstelle ff/5d/01, Kennung
+ * 2345:e06e, MS-OS-Deskriptor „XUSB10“, Gegenprobe Werks-FW 0x1E26E7B/0x1E2703B). Damit binden Windows (xusb22) und
+ * Linux (xpad, Hersteller 2345) ihren Xbox-Treiber, und Spiele können die Motoren ansteuern.
+ * Eingabebericht (20 Byte): 00 14 | Tasten (16 Bit) | LT | RT | LX LY RX RY (je int16, Y oben positiv) | 6 × 0.
+ * Ausgabe vom Host: 00 08 00 <groß> <klein> 00 00 00 = Rumble, 01 03 <n> = LED-Muster (ignoriert). */
+#include "app_config.h"
+#include "system/includes.h"
+#include "c2_log.h"
+#include "c2_switch.h"
+
+#ifdef CONFIG_BOARD_C2LITE
+
+void c2_motor_setzen(u8 links, u8 rechts, u16 dauer_ms);
+u8 c2_vibration_staerke(void);
+
+/* Rollen-Bits (c2_eingaben.c, c2_switch.h) */
+#define BIT64(n) (1ULL << (n))
+
+/* XInput-Tastenbits: 0 hoch, 1 runter, 2 links, 3 rechts, 4 Start, 5 Back, 6 LS, 7 RS, 8 LB, 9 RB, 10 Guide,
+ * 12 A (unten), 13 B (rechts), 14 X (links), 15 Y (oben); positionsgleich zur Switch-Anordnung */
+static const struct {
+    u8 rolle, bit;
+} TASTEN[] = {
+    {C2_ROLLE_HOCH, 0},  {C2_ROLLE_RUNTER, 1}, {C2_ROLLE_LINKS, 2}, {C2_ROLLE_RECHTS, 3}, {C2_ROLLE_PLUS, 4},
+    {C2_ROLLE_MINUS, 5}, {C2_ROLLE_L3, 6},     {C2_ROLLE_R3, 7},    {C2_ROLLE_L, 8},      {C2_ROLLE_R, 9},
+    {C2_ROLLE_HOME, 10}, {C2_ROLLE_B, 12},     {C2_ROLLE_A, 13},    {C2_ROLLE_Y, 14},     {C2_ROLLE_X, 15},
+};
+
+static s16 achse(u16 v, int umkehren)
+{
+    s32 w = ((s32)v - 512) * 64;
+    if (umkehren) {
+        w = -w;
+    }
+    return w > 32767 ? 32767 : w < -32768 ? -32768 : w;
+}
+
+void c2_xinput_bericht(u64 r, const u16 a[4], u8 *b)
+{
+    memset(b, 0, 20);
+    b[0] = 0x00, b[1] = 0x14;
+    u16 t = 0;
+    for (int i = 0; i < (int)ARRAY_SIZE(TASTEN); i++) {
+        if (r & BIT64(TASTEN[i].rolle)) {
+            t |= 1 << TASTEN[i].bit;
+        }
+    }
+    b[2] = t, b[3] = t >> 8;
+    b[4] = (r & BIT64(C2_ROLLE_ZL)) ? 0xFF : 0; /* ZL/ZR sind digital: ganz oder gar nicht */
+    b[5] = (r & BIT64(C2_ROLLE_ZR)) ? 0xFF : 0;
+    for (int i = 0; i < 4; i++) {
+        s16 w = achse(a[i], i & 1); /* bei uns ist Y = 0 oben, bei XInput ist oben positiv */
+        b[6 + 2 * i] = w, b[7 + 2 * i] = w >> 8;
+    }
+}
+
+/* Bluetooth (PC-Modus): Bericht 1 des Xbox Wireless Controller 1708 (Berichtsbeschreibung in app_keyboard.c).
+ * 16 Byte: X Y Z Rz (u16, Mitte 0x8000, Y unten groß) | Bremse | Gas (10 Bit) | Hat 1..8, 0 = keine | Tasten (16 Bit) | 0.
+ * Tastenbits wie SDL (Xbox über Bluetooth): A 0, B 1, X 3, Y 4, LB 6, RB 7, Menü 11, Xbox 12, LS 13, RS 14;
+ * positionsgleich wie oben (unten = A, rechts = B, links = X, oben = Y). View kommt beim Modell 1708 als „AC Back“ in
+ * Byte 15 (nicht Bit 10): SDL-Zuordnung 045E:02FD „back:b15“ = KEY_BACK, am 31.10. am Gerät geprüft. */
+static const struct {
+    u8 rolle, bit;
+} XBOX_BLE[] = {
+    {C2_ROLLE_B, 0},  {C2_ROLLE_A, 1},     {C2_ROLLE_Y, 3},     {C2_ROLLE_X, 4},     {C2_ROLLE_L, 6},  {C2_ROLLE_R, 7},
+    {C2_ROLLE_PLUS, 11}, {C2_ROLLE_HOME, 12}, {C2_ROLLE_L3, 13}, {C2_ROLLE_R3, 14},
+};
+
+void c2_xbox_ble_bericht(u64 r, const u16 a[4], u8 *b, u8 hat)
+{
+    memset(b, 0, 16);
+    for (int i = 0; i < 4; i++) {
+        u32 v = (u32)a[i] * 64 + 32; /* 0..1023 -> 0..65535, Mitte 512 -> 0x8020 ≈ 0x8000 */
+        if (v > 0xFFFF) {
+            v = 0xFFFF;
+        }
+        b[2 * i] = v, b[2 * i + 1] = v >> 8;
+    }
+    u16 zl = (r & BIT64(C2_ROLLE_ZL)) ? 1023 : 0, zr = (r & BIT64(C2_ROLLE_ZR)) ? 1023 : 0; /* digital */
+    b[8] = zl, b[9] = zl >> 8;
+    b[10] = zr, b[11] = zr >> 8;
+    b[12] = hat > 7 ? 0 : hat + 1; /* c2_eingaben: 0 = hoch .. 7 = links-hoch, 8 = keine */
+    u16 t = 0;
+    for (int i = 0; i < (int)ARRAY_SIZE(XBOX_BLE); i++) {
+        if (r & BIT64(XBOX_BLE[i].rolle)) {
+            t |= 1 << XBOX_BLE[i].bit;
+        }
+    }
+    b[13] = t, b[14] = t >> 8;
+    b[15] = (r & BIT64(C2_ROLLE_MINUS)) ? 0x01 : 0; /* View = AC Back */
+}
+
+/* Rumble: vom USB-Interrupt bzw. vom Bluetooth-Schreibrückruf nur gemerkt, die Motoren setzt c2_xinput_takt in der
+ * Abfragerunde */
+static volatile u8 wunsch[2], neu;
+static u8 aktiv[2];
+static u32 runde;
+/* Bluetooth-Rumble endet spätestens zu dieser Runde (Dauer × Wiederholungen aus dem Bericht, höchstens 60 s) */
+static volatile u32 ble_bis;
+#define TAKT_MS_X 10
+
+void c2_xinput_empfang(const u8 *buf, u32 len)
+{
+    if (len >= 5 && buf[0] == 0x00 && buf[1] == 0x08) {
+        wunsch[0] = buf[3], wunsch[1] = buf[4];
+        neu = 1;
+    }
+}
+
+/* Ausgabebericht 3 über Bluetooth (hid-microsoft, Windows): Freigabe | L-Trigger | R-Trigger | stark (links) |
+ * schwach (rechts) | Dauer (10 ms) | Verzögerung | Wiederholungen. Der GATT-Wert kommt ohne Berichtsnummer; falls ein
+ * Host sie doch mitschickt (9 Byte, erstes 3), wird sie übersprungen. Freigabe Bit 1 = stark, Bit 0 = schwach. */
+void c2_xbox_ble_ausgabe(u8 *buf, u16 len)
+{
+    if (len == 9 && buf[0] == 0x03) {
+        buf++, len--;
+    }
+    if (len < 5) {
+        return;
+    }
+    u8 frei = buf[0];
+    u8 stark = (frei & 0x02) ? buf[3] : 0, schwach = (frei & 0x01) ? buf[4] : 0;
+    wunsch[0] = (u32)(stark > 100 ? 100 : stark) * 255 / 100;
+    wunsch[1] = (u32)(schwach > 100 ? 100 : schwach) * 255 / 100;
+    /* Linux schickt Dauer 255 und 255 Wiederholungen (≈ 650 s) und zum Stoppen Stärke 0; Windows echte Dauern */
+    u32 ms = len >= 8 ? ((u32)buf[5] * 10) * ((u32)buf[7] + 1) + (u32)buf[6] * 10 : 1000;
+    if (ms > 60000) {
+        ms = 60000;
+    }
+    ble_bis = runde + ms / TAKT_MS_X + 1;
+    neu = 1;
+}
+
+/* Anlaufschwelle wie an der Switch: kleine Werte wären sonst nicht spürbar; Stärke-Einstellung skaliert */
+#define ANLAUF 40
+static u8 staerke(u8 v)
+{
+    if (!v) {
+        return 0;
+    }
+    u32 p = (u32)v * 100 / 255;
+    return (ANLAUF + p * (100 - ANLAUF) / 100) * c2_vibration_staerke() / 100;
+}
+
+/* Jede Abfragerunde im PC-Modus: XInput hält Rumble, bis der Host etwas anderes schickt; ohne Host aus.
+ * host: USB-Host aktiv oder Bluetooth verbunden und abonniert. Bluetooth-Rumble endet zusätzlich nach seiner Dauer. */
+void c2_xinput_takt(int host)
+{
+    runde++;
+    if (!host || (ble_bis && (s32)(runde - ble_bis) >= 0)) {
+        wunsch[0] = wunsch[1] = 0;
+        ble_bis = 0;
+    }
+    u8 l = staerke(wunsch[0]), r = staerke(wunsch[1]);
+    if (neu || l != aktiv[0] || r != aktiv[1] || ((l || r) && runde % 10 == 0)) {
+        if (neu && (l || r) != (aktiv[0] || aktiv[1])) {
+            c2_log("XInput: Rumble %u/%u\r\n", wunsch[0], wunsch[1]);
+        }
+        neu = 0;
+        aktiv[0] = l, aktiv[1] = r;
+        c2_motor_setzen(l, r, 250); /* alle 100 ms erneuert; bleibt nichts mehr, endet es von selbst */
+    }
+}
+
+#endif
diff --git a/apps/hid/modules/c2lite/chitu.c b/apps/hid/modules/c2lite/chitu.c
new file mode 100644
index 0000000..e00f92f
--- /dev/null
+++ b/apps/hid/modules/c2lite/chitu.c
@@ -0,0 +1,834 @@
+/* Chitu 2 HD, Stufe C1: Sicherheitsnetze N3/N4 und Pin-Monitor (nur lesen und melden).
+ *
+ * Quellen (eigene Analyse der Werks-Firmware 0.20, Notizen nicht im Repo): Werks-FW 0.20 hat dieselbe Tastenmatrix wie der C2 Lite (Pin-Tabellen
+ * byte-gleich), Home+Y+X (Matrix Phase B: PB1, PC3, PC4) löst am Chitu nachweislich den Werks-Download aus.
+ * Sticks: Hilfsbaustein, 13-Byte-Rahmen, Takt PA6 (Ausgang), Daten PA5 (Eingang), PB8 Ausgang low.
+ *
+ * Netze:
+ *   N3 Früh-Notausgang  (c2_frueh_notausgang, aus setup_arch nach tick_timer_init, vor allem anderen der App):
+ *      USB-5V an PB5 und Home+Y+X ~1 s gehalten -> ROM-Download-Modus.
+ *   N4 Bootloop-Bremse  (Startzähler im reservierten RAM1, übersteht Soft-/Watchdog-Reset):
+ *      ab NETZ_GRENZE Starts ohne 20 s stabile Laufzeit -> Wartemodus statt normalem Start:
+ *        Home+Y+X mit USB-5V ~1 s -> ROM-Download-Modus,   Home allein ~2 s -> Zähler 0, normaler Neustart.
+ *      Kein selbsttätiger Sprung in den ROM-Modus: ohne PC als Gegenstelle hängt das ROM (Rückweg nur Akku ab).
+ *   N2 im Betrieb: Home+Y+X 3 s mit PC als USB-Host (SOF läuft) -> ROM-Download-Modus; Befehl „download-modus“
+ *      nur mit PC am USB (nicht über Bluetooth allein). Herzschlag-Wächter im Zeitgeber-Interrupt (15 s).
+ *   Home allein 10 s -> Neustart (ohne PC; zählt für N4).
+ *   Kein Soft-Off (Wecken am Chitu unbelegt): Unterspannungs-Aus und Bluetooth-Aus sind im Chitu-Bau abgeschaltet.
+ * Keine Ausgänge außer denen, die die Werks-FW genauso setzt (PA7/PA8 low bzw. PA8 high in der Matrix, PB11 high,
+ * PA6/PB8 für den Stick-Rahmen; ab CRg Spieler-LEDs PC0..PC5/PA12 + PA7 high wie Werks-FW 0x1a3dc; ab CRi
+ * RGB: Logo an PA7, Dock an PA8 wie Werks-FW 0x1b9a4). Kein Auto-Aus. */
+#include "app_config.h"
+#include "system/includes.h"
+#include "asm/gpio.h"
+#include "asm/rtc.h"
+#include "asm/cpu.h"
+#include "asm/wdt.h"
+#include "asm/usb.h"
+#include "asm/power_interface.h"
+#include "c2_log.h"
+#include "c2_spur.h"
+
+#if C2_CHITU
+
+/* ---------- N4: Startzähler im reservierten RAM1 ----------
+ * Nachlass (c2_log.c) belegt 0x2EF80 + 8 + 2048 = bis 0x2F788, Absturzbericht ab 0x2F800. Dazwischen frei. */
+#define NETZ_ADR 0x2F790
+#define NETZ_MAGIC 0xC4170C01u
+#define NETZ_GRENZE 4         /* so viele Starts in Folge ohne stabile Laufzeit -> Wartemodus */
+#define NETZ_STABIL_MS 20000  /* so lange muss ein Lauf halten, dann Zähler 0 */
+struct netz_t {
+    u32 magic;
+    u32 starts;
+    u32 starts_inv;
+};
+_Static_assert(NETZ_ADR >= 0x2EF80 + 8 + 2048 && NETZ_ADR + sizeof(struct netz_t) <= 0x2F800, "RAM1-Platz N4");
+#define NETZ (*(volatile struct netz_t *)NETZ_ADR)
+_Static_assert(SPUR_ADR >= NETZ_ADR + sizeof(struct netz_t) && SPUR_ADR + sizeof(struct spur_t) <= 0x2F800, "RAM1-Platz Spur");
+
+static u32 netz_starts_beim_start; /* .bss; laut setup.c läuft memory_init vor c2_frueh_notausgang (Prüfung CRc M7),
+                                    * beschrieben wird sie trotzdem erst im App-Teil */
+
+static u32 netz_lesen(void)
+{
+    if (NETZ.magic == NETZ_MAGIC && NETZ.starts_inv == ~NETZ.starts) {
+        return NETZ.starts;
+    }
+    return 0; /* Kaltstart oder zerstört: wie „noch kein Start“ */
+}
+
+static void netz_setzen(u32 n)
+{
+    NETZ.starts = n;
+    NETZ.starts_inv = ~n;
+    NETZ.magic = NETZ_MAGIC;
+}
+
+/* ---------- Pins direkt lesen (ohne Betriebssystem, ohne Zeitgeber) ---------- */
+static void warte_schleifen(u32 n)
+{
+    for (volatile u32 i = 0; i < n; i++) {
+    }
+}
+
+/* ~10 ms im Frühtakt. Gemessen in der Generalprobe (C2 Lite, 3.11.): 100 Schritte à 60000 = ~3,8 s, also ~38 ms je
+ * 60000 Durchläufe -> 16000 für ~10 ms. Genau muss es nicht sein. */
+#define SCHLEIFEN_10MS 16000
+
+static void eingang_pu(u32 pin)
+{
+    gpio_set_direction(pin, 1);
+    gpio_set_die(pin, 1);
+    gpio_set_pull_down(pin, 0);
+    gpio_set_pull_up(pin, 1);
+}
+
+/* Phase B der Matrix wie die Werks-FW: PA7 (LED-Leitung) und PA8 (Tastenleitung) low, Pins mit Pull-up,
+ * gedrückt = low. */
+static void matrix_b_vorbereiten(void)
+{
+    gpio_direction_output(IO_PORTA_07, 0);
+    gpio_direction_output(IO_PORTA_08, 0);
+    eingang_pu(IO_PORTB_01); /* Home */
+    eingang_pu(IO_PORTC_03); /* Y */
+    eingang_pu(IO_PORTC_04); /* X */
+    gpio_set_direction(IO_PORTB_05, 1); /* USB-5V, Pull-down wie Werks-FW */
+    gpio_set_die(IO_PORTB_05, 1);
+    gpio_set_pull_up(IO_PORTB_05, 0);
+    gpio_set_pull_down(IO_PORTB_05, 1);
+    warte_schleifen(2000);
+}
+
+static int home_gedrueckt(void)
+{
+    return !gpio_read(IO_PORTB_01);
+}
+
+static int notfall_tasten(void)
+{
+    return !gpio_read(IO_PORTB_01) && !gpio_read(IO_PORTC_03) && !gpio_read(IO_PORTC_04);
+}
+
+static int usb_5v(void)
+{
+    return !!gpio_read(IO_PORTB_05);
+}
+
+void go_mask_usb_updata(void);
+
+/* Sprung in den ROM-Download-Modus. Zähler vorher auf 0, damit die nach dem Flashen gestartete Firmware nicht im
+ * Wartemodus landet. Watchdog aus wie c2_download_springen (überlebt sonst den Sprung und beendet den ROM-Modus). */
+static void rom_springen(void)
+{
+    extern void c2_rgb_rot_vor_rom(void);
+    c2_rgb_rot_vor_rom();                  /* Logo und Dock rot (CRi), nur wenn das Licht schon lief */
+    gpio_direction_output(IO_PORTA_07, 0); /* LEDs aus (CRh): im ROM läuft keine Firmware, die sie umschaltet */
+    netz_setzen(0);
+    wdt_close();
+    go_mask_usb_updata();
+    while (1) {
+    }
+}
+
+/* Bedingung muss über ~n×10 ms ununterbrochen gelten (Prellen, kurzes Antippen zählt nicht) */
+static int gehalten(int (*bedingung)(void), u32 n)
+{
+    for (u32 i = 0; i < n; i++) {
+        clr_wdt();
+        if (!bedingung()) {
+            return 0;
+        }
+        warte_schleifen(SCHLEIFEN_10MS);
+    }
+    return 1;
+}
+
+static int notfall_mit_usb(void)
+{
+    return usb_5v() && notfall_tasten();
+}
+
+static int nur_home(void)
+{
+    return home_gedrueckt() && gpio_read(IO_PORTC_03) && gpio_read(IO_PORTC_04);
+}
+
+/* N4-Wartemodus: kein normaler Start, nur Tasten abfragen. Bleibt hier, bis der Nutzer handelt. */
+static void wartemodus(void)
+{
+    while (1) {
+        clr_wdt();
+        if (notfall_mit_usb() && gehalten(notfall_mit_usb, 150)) { /* ~1,5 s */
+            rom_springen();
+        }
+        if (nur_home() && gehalten(nur_home, 200)) { /* ~2 s */
+            netz_setzen(0);
+            cpu_reset();
+        }
+        warte_schleifen(SCHLEIFEN_10MS);
+    }
+}
+
+/* Aus setup_arch (cpu/br23/setup.c) nach tick_timer_init: Takt steht, sonst noch nichts von der App gelaufen. */
+void c2_frueh_notausgang(void)
+{
+    u32 n = netz_lesen() + 1;
+    netz_setzen(n);
+    matrix_b_vorbereiten();
+    /* N3: unabhängig vom Zähler */
+    if (notfall_mit_usb() && gehalten(notfall_mit_usb, 150)) { /* ~1,5 s */
+        rom_springen();
+    }
+    /* N4 */
+    if (n >= NETZ_GRENZE) {
+        wartemodus();
+    }
+}
+
+/* ---------- Für die übrigen Module ---------- */
+/* S1 (Prüfung 3.11.): vor jedem gewollten Neustart (Befehl, Update, Download) Zähler auf 0, damit gewollte Neustarts
+ * nicht in den Wartemodus führen. Ungewollte (Watchdog, Absturz, Herzschlag) zählen weiter. */
+void chitu_netz_ruhe(void)
+{
+    netz_setzen(0);
+}
+
+/* M-1: lange Bibliotheksschleifen (OTA-Prüfung) melden sich als lebendig */
+static volatile u32 herzschlag;
+void chitu_herzschlag(void)
+{
+    herzschlag++;
+}
+
+/* S4/B1: Läuft ein PC als USB-Host? SOF-Rahmenzähler ändert sich jede Millisekunde, nur wenn ein Host den Bus
+ * bedient (wie usb_host_pruefen in c2_eingaben.c). Ohne Host hinge der ROM-Modus (Rückweg nur Akku ab). */
+static int usb_host_jetzt(void)
+{
+    if (!gpio_read(IO_PORTB_05)) {
+        return 0;
+    }
+    u16 a = musb_read_sofframe(0);
+    for (int i = 0; i < 5; i++) {
+        warte_schleifen(SCHLEIFEN_10MS / 2); /* zur Laufzeit (48 MHz) kürzer, mehrere ms reichen */
+        if (musb_read_sofframe(0) != a) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Für den Befehl „download-modus“ (c2_log.c): nur mit PC am USB, nie über Bluetooth allein */
+int chitu_download_erlaubt(void)
+{
+    return usb_host_jetzt();
+}
+
+void chitu_download_springen(void)
+{
+    rom_springen(); /* setzt den Zähler auf 0 und schließt den Watchdog */
+}
+
+/* ---------- Pin-Monitor (läuft im Betrieb, Takt 10 ms) ---------- */
+struct pin_name {
+    u32 pin;
+    const char *name;
+};
+
+/* Listen wie die Werks-FW (C2 Lite PINS.md, Chitu-Tabellen byte-gleich) */
+static const struct pin_name PHASE_A[] = {
+    {IO_PORTC_04, "A:PC4"}, {IO_PORTC_05, "A:PC5"}, {IO_PORTC_00, "A:PC0"},  {IO_PORTA_15, "A:PA15"},
+    {IO_PORTC_02, "A:PC2"}, {IO_PORTC_01, "A:PC1"}, {IO_PORTC_03, "A:PC3"},  {IO_PORTA_03, "A:PA3"},
+    {IO_PORTA_12, "A:PA12"},
+};
+static const struct pin_name PHASE_B[] = {
+    {IO_PORT_PR_01, "B:PR1"}, {IO_PORT_PR_00, "B:PR0"}, {IO_PORTB_06, "B:PB6"}, {IO_PORTC_04, "B:PC4"},
+    {IO_PORTC_03, "B:PC3"},   {IO_PORTA_02, "B:PA2"},   {IO_PORTB_01, "B:PB1"}, {IO_PORTA_03, "B:PA3"},
+    {IO_PORTC_05, "B:PC5"},   {IO_PORTC_01, "B:PC1"},   {IO_PORTA_12, "B:PA12"}, {IO_PORTC_02, "B:PC2"},
+    {IO_PORTC_00, "B:PC0"},   {IO_PORTB_07, "B:PB7"},
+};
+static const struct pin_name DIREKT[] = {
+    {IO_PORTA_10, "D:PA10"}, {IO_PORTB_03, "D:PB3"},
+};
+#define N_A (sizeof(PHASE_A) / sizeof(PHASE_A[0]))
+#define N_B (sizeof(PHASE_B) / sizeof(PHASE_B[0]))
+#define N_D (sizeof(DIREKT) / sizeof(DIREKT[0]))
+_Static_assert(N_A + N_B + N_D <= 32, "Bits");
+
+static void eingang(u32 pin, int pull_up, int pull_down)
+{
+    if (pin >= IO_PORT_PR_00) {
+        u8 pr = pin - IO_PORT_PR_00;
+        rtc_port_pr_in(pr);
+        rtc_port_pr_die(pr, 1);
+        rtc_port_pr_pu(pr, pull_up);
+        rtc_port_pr_pd(pr, pull_down);
+        return;
+    }
+    gpio_set_direction(pin, 1);
+    gpio_set_die(pin, 1);
+    gpio_set_pull_up(pin, pull_up);
+    gpio_set_pull_down(pin, pull_down);
+}
+
+static int pegel(u32 pin)
+{
+    return pin >= IO_PORT_PR_00 ? rtc_port_pr_read(pin - IO_PORT_PR_00) : gpio_read(pin);
+}
+
+static u32 phase(const struct pin_name *t, u32 n, int gedrueckt_high, u32 erstes_bit)
+{
+    for (u32 i = 0; i < n; i++) {
+        eingang(t[i].pin, !gedrueckt_high, gedrueckt_high);
+    }
+    warte_schleifen(1000);
+    u32 bits = 0;
+    for (u32 i = 0; i < n; i++) {
+        if (!!pegel(t[i].pin) == gedrueckt_high) {
+            bits |= 1u << (erstes_bit + i);
+        }
+    }
+    return bits;
+}
+
+static const char *bit_name(u32 b)
+{
+    if (b < N_A) {
+        return PHASE_A[b].name;
+    }
+    if (b < N_A + N_B) {
+        return PHASE_B[b - N_A].name;
+    }
+    return DIREKT[b - N_A - N_B].name;
+}
+
+#define BIT_HOME (N_A + 6) /* PHASE_B[6] = PB1 */
+#define BIT_Y (N_A + 4)    /* PHASE_B[4] = PC3 */
+#define BIT_X (N_A + 3)    /* PHASE_B[3] = PC4 */
+#define NOTFALL_BITS ((1u << BIT_HOME) | (1u << BIT_Y) | (1u << BIT_X))
+
+static u32 matrix_lesen(void)
+{
+    gpio_direction_output(IO_PORTA_07, 0);
+    gpio_direction_output(IO_PORTA_08, 1);
+    u32 r = phase(PHASE_A, N_A, 1, 0);
+    gpio_direction_output(IO_PORTA_08, 0);
+    r |= phase(PHASE_B, N_B, 0, N_A);
+    r |= phase(DIREKT, N_D, 0, N_A + N_B);
+    return r;
+}
+
+/* ---------- Stick-Rahmen (nur Chitu-Abbild; im Generalprobe-Abbild für den C2 Lite aus, dort sind PA5/PA6/PB8
+ * Stick-Schleifer und dürfen nicht getrieben werden) ---------- */
+#ifndef C2_CHITU_STICKS
+#error "C2_CHITU_STICKS fehlt: Chitu-Abbild -DC2_CHITU_STICKS=1, Generalprobe am C2 Lite -DC2_CHITU_STICKS=0"
+#endif
+#define RAHMEN 13
+static u8 rahmen[RAHMEN], rahmen_alt[RAHMEN];
+static u32 rahmen_ok, rahmen_fehler, rahmen_fehler_folge;
+static u8 sticks_aus; /* nach zu vielen Fehlern in Folge abgeschaltet (Leitungen wieder Eingang) */
+
+#if C2_CHITU_STICKS
+/* Wie die Werks-FW 0.20 (Timer-2-Interrupt, RAM-Code app 0x59fc2..0x5a042, Takt-Hilfe 0x59f96): je Halbtakt 3 direkte
+ * Schreibzugriffe auf PA.OUT, je Bit Takt low, Takt high, PA5 lesen (MSB zuerst), 13 Byte ohne Unterbrechung, am Ende
+ * Takt low. C1c las langsam und unterbrechbar -> fast nur Prüfsummenfehler (Baustein synchronisiert offenbar über
+ * Taktpausen). Deshalb hier: RAM-Code, Interrupts für die ~50 µs aus. */
+/* Prüfung C2a S1: ohne Zählschleife (volatile-Zähler auf dem Stack kostete ~2,3 µs je Halbtakt, ~0,5 ms Interrupt-
+ * sperre). Wie die Werks-FW genau drei Schreibzugriffe je Halbtakt. */
+AT_VOLATILE_RAM_CODE
+static void takt_schnell(int hoch)
+{
+    if (hoch) {
+        JL_PORTA->OUT |= BIT(6);
+        JL_PORTA->OUT |= BIT(6);
+        JL_PORTA->OUT |= BIT(6);
+    } else {
+        JL_PORTA->OUT &= ~BIT(6);
+        JL_PORTA->OUT &= ~BIT(6);
+        JL_PORTA->OUT &= ~BIT(6);
+    }
+}
+
+AT_VOLATILE_RAM_CODE
+static void rahmen_roh_n(u8 *z, int n)
+{
+    local_irq_disable();
+    for (int i = 0; i < n; i++) {
+        u8 b = 0;
+        for (int k = 0; k < 8; k++) {
+            takt_schnell(0);
+            takt_schnell(1);
+            b = (b << 1) | ((JL_PORTA->IN >> 5) & 1);
+        }
+        z[i] = b;
+    }
+    takt_schnell(0);
+    local_irq_enable();
+}
+
+static void rahmen_roh(u8 *z)
+{
+    rahmen_roh_n(z, RAHMEN);
+}
+
+/* C1e (Messung): n zusätzliche Takte, um eine Bit-Verschiebung des Bausteins zu prüfen */
+AT_VOLATILE_RAM_CODE
+static void takte(int n)
+{
+    local_irq_disable();
+    for (int i = 0; i < n; i++) {
+        takt_schnell(0);
+        takt_schnell(1);
+    }
+    takt_schnell(0);
+    local_irq_enable();
+}
+
+/* Bit k (MSB zuerst) aus einem Bytestrom */
+static int bit_an(const u8 *b, int k)
+{
+    return (b[k >> 3] >> (7 - (k & 7))) & 1;
+}
+
+/* Sucht die Bit-Verschiebung, bei der 13 Byte die Prüfsumme erfüllen (Byte 12 = Summe 0..11, nicht alles 0) */
+static int bit_suche(const u8 *b, int nbytes, u8 *treffer)
+{
+    for (int k = 0; k + RAHMEN * 8 <= nbytes * 8; k++) {
+        u8 z[RAHMEN], summe = 0, oder = 0;
+        for (int i = 0; i < RAHMEN; i++) {
+            u8 v = 0;
+            for (int j = 0; j < 8; j++) {
+                v = (v << 1) | bit_an(b, k + i * 8 + j);
+            }
+            z[i] = v;
+        }
+        for (int i = 0; i < RAHMEN - 1; i++) {
+            summe += z[i];
+            oder |= z[i];
+        }
+        if (oder && summe == z[RAHMEN - 1]) {
+            memcpy(treffer, z, RAHMEN);
+            return k;
+        }
+    }
+    return -1;
+}
+
+static void doppel_melden(void)
+{
+    u8 b[2 * RAHMEN], t[RAHMEN];
+    rahmen_roh_n(b, 2 * RAHMEN);
+    int k = bit_suche(b, 2 * RAHMEN, t);
+    c2_log("Roh %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\r\n",
+           b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15], b[16],
+           b[17], b[18], b[19], b[20], b[21], b[22], b[23], b[24], b[25]);
+    if (k >= 0) {
+        c2_log("  Prüfsumme passt bei Bit-Versatz %d: %02x %02x %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x | %02x\r\n",
+               k, t[0], t[1], t[2], t[3], t[4], t[5], t[6], t[7], t[8], t[9], t[10], t[11], t[12]);
+    } else {
+        c2_log("  kein Bit-Versatz mit passender Prüfsumme\r\n");
+    }
+}
+
+static void sticks_init(void)
+{
+    gpio_set_die(IO_PORTB_08, 1);
+    gpio_direction_output(IO_PORTB_08, 0);
+    gpio_set_die(IO_PORTA_05, 1);
+    gpio_set_die(IO_PORTA_06, 1);
+    gpio_set_pull_up(IO_PORTA_05, 0);
+    gpio_set_pull_down(IO_PORTA_05, 0);
+    gpio_set_direction(IO_PORTA_05, 1);
+    gpio_direction_output(IO_PORTA_06, 0);
+}
+
+static void sticks_abschalten(void)
+{
+    sticks_aus = 1;
+    gpio_set_direction(IO_PORTA_06, 1);
+    gpio_set_pull_down(IO_PORTA_06, 1);
+    gpio_set_direction(IO_PORTB_08, 1);
+    gpio_set_pull_down(IO_PORTB_08, 1);
+    c2_log("Chitu: Stick-Rahmen nach %lu Fehlern in Folge abgeschaltet (PA6/PB8 wieder Eingang)\r\n",
+           rahmen_fehler_folge);
+}
+
+/* C1f: Werks-FW liest im Timer-2-Interrupt mit 375 Hz (app 0x90b8 r10 = 375, request_irq(6, …) bei 0x92be). Seltener
+ * gelesen (C1c–C1e: alle 20 ms) liefert der Baustein fast nur Nullen/halbe Rahmen. Hier im usr_timer-Interrupt alle
+ * 2 ms; der Monitor wertet nur den zuletzt gültigen Rahmen aus. */
+static u8 isr_rahmen[RAHMEN], gueltig[RAHMEN];
+static volatile u8 gueltig_neu;
+static volatile u32 isr_ok, isr_fehler, isr_fehler_folge, isr_laeufe;
+
+static void sticks_isr(void *priv)
+{
+    SPUR_IRQ(0x51);
+    SPUR.irq_n++;
+    if (sticks_aus) {
+        SPUR_IRQ(0x50);
+        return;
+    }
+    isr_laeufe++;
+    rahmen_roh(isr_rahmen);
+    u8 summe = 0, oder = 0;
+    for (int i = 0; i < RAHMEN - 1; i++) {
+        summe += isr_rahmen[i];
+        oder |= isr_rahmen[i];
+    }
+    if (oder && summe == isr_rahmen[RAHMEN - 1]) {
+        memcpy(gueltig, isr_rahmen, RAHMEN);
+        gueltig_neu = 1;
+        isr_ok++;
+        isr_fehler_folge = 0;
+    } else {
+        isr_fehler++;
+        isr_fehler_folge++;
+    }
+    SPUR_IRQ(0x50);
+}
+
+/* Letzten gültigen Rahmen nach „rahmen“ holen (Task-Kontext); 1 = es gab seit dem letzten Abholen einen neuen */
+static int rahmen_lesen(void)
+{
+    local_irq_disable();
+    int neu = gueltig_neu;
+    if (neu) {
+        memcpy(rahmen, gueltig, RAHMEN);
+        gueltig_neu = 0;
+    }
+    local_irq_enable();
+    return neu;
+}
+#endif
+
+static u16 achse(int i)
+{
+    return rahmen[2 * i] | ((rahmen[2 * i + 1] & 0x0F) << 8);
+}
+
+/* ---------- Takt ---------- */
+static u32 runde, alt_bits, notfall_runden, alt_usb = 2;
+static u32 host_runde, host_frame;
+
+/* S2 (Prüfung 3.11.): Hängt der App-Task, füttert die Idle-Task weiter den Watchdog, und N2 läuft nicht. Dieser
+ * Wächter läuft im Hardware-Zeitgeber (usr_timer, Interrupt) und startet neu, wenn der Monitor 15 s keinen Herzschlag
+ * gab. Der Neustart zählt für N4 (kein chitu_netz_ruhe). */
+static void waechter(void *priv)
+{
+    static u32 alt, still;
+    SPUR_IRQ(0x71);
+    if (herzschlag != alt) {
+        alt = herzschlag;
+        still = 0;
+        SPUR_IRQ(0x70);
+        return;
+    }
+    if (++still >= 30) { /* 30 × 500 ms */
+        cpu_reset();
+    }
+    SPUR_IRQ(0x70);
+}
+
+static void monitor(void *priv)
+{
+    u32 r = matrix_lesen();
+    u32 diff = r ^ alt_bits;
+    for (u32 b = 0; b < N_A + N_B + N_D; b++) {
+        if (diff & (1u << b)) {
+            c2_log("Pin %s %s\r\n", bit_name(b), (r & (1u << b)) ? "AN" : "aus");
+        }
+    }
+    alt_bits = r;
+
+    herzschlag++;
+    u16 f = musb_read_sofframe(0);
+    if (f != host_frame) {
+        host_frame = f;
+        host_runde = runde;
+    }
+    int host = gpio_read(IO_PORTB_05) && runde - host_runde < 20; /* SOF in den letzten 200 ms */
+
+    /* Prüfung C1b S-B: Neustart ohne PC (USB-Seite tot, nur Ladegerät): Home allein 10 s -> Neustart. Zähler bleibt
+     * (zählt für N4), danach greift beim Start N3 bzw. N4. */
+    {
+        static u32 home_runden;
+        if ((r & NOTFALL_BITS) == (1u << BIT_HOME)) {
+            if (++home_runden == 800) {
+                c2_log("Chitu: Home weiter halten -> Neustart in 2 s\r\n");
+            }
+            if (home_runden >= 1000) {
+                c2_log("Chitu: Home 10 s -> Neustart\r\n");
+                os_time_dly(5);
+                cpu_reset();
+            }
+        } else {
+            home_runden = 0;
+        }
+    }
+
+    /* N2: Home+Y+X 3 s, nur mit PC als USB-Host (S4) */
+    if ((r & NOTFALL_BITS) == NOTFALL_BITS && host) {
+        notfall_runden++;
+        if (notfall_runden == 100) {
+            c2_log("Rettung: Home+Y+X weiter halten -> Download-Modus in 2 s\r\n");
+        }
+        if (notfall_runden >= 300) {
+            c2_log("Rettung: starte in den ROM-Download-Modus\r\n");
+            os_time_dly(5);
+            rom_springen();
+        }
+    } else {
+        notfall_runden = 0;
+    }
+
+    int usb = gpio_read(IO_PORTB_05);
+    if (usb != (int)alt_usb) {
+        c2_log("Chitu: USB-5V (PB5) %s\r\n", usb ? "an" : "aus");
+        alt_usb = usb;
+    }
+
+#if C2_CHITU_STICKS
+    if (!sticks_aus && runde % 2 == 0) { /* Auswertung alle 20 ms, gelesen wird im Interrupt alle 2 ms */
+        rahmen_ok = isr_ok;
+        rahmen_fehler = isr_fehler;
+        rahmen_fehler_folge = isr_fehler_folge;
+        if (rahmen_fehler_folge >= 5000) { /* ~10 s nur Fehler */
+            sticks_abschalten();
+        }
+        if (rahmen_lesen()) {
+            int melden = 0;
+            for (int i = 0; i < 4; i++) {
+                u16 a = achse(i);
+                u16 b = rahmen_alt[2 * i] | ((rahmen_alt[2 * i + 1] & 0x0F) << 8);
+                if (a > b + 24 || a + 24 < b) {
+                    melden = 1;
+                }
+            }
+            for (int i = 8; i < RAHMEN - 1; i++) {
+                if (rahmen[i] > rahmen_alt[i] + 4 || rahmen[i] + 4 < rahmen_alt[i]) {
+                    melden = 1;
+                }
+            }
+            if (melden || runde % 300 == 0) {
+                memcpy(rahmen_alt, rahmen, RAHMEN);
+                c2_log("Sticks %4u %4u %4u %4u | %02x %02x %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x | %02x\r\n",
+                       achse(0), achse(1), achse(2), achse(3), rahmen[0], rahmen[1], rahmen[2], rahmen[3], rahmen[4],
+                       rahmen[5], rahmen[6], rahmen[7], rahmen[8], rahmen[9], rahmen[10], rahmen[11], rahmen[12]);
+            }
+        }
+    }
+    if (runde % 300 == 0) {
+        c2_log("Chitu: Stick-Rahmen ok %lu, Fehler %lu, Lesungen %lu\r\n", rahmen_ok, rahmen_fehler, isr_laeufe);
+        if (!sticks_aus) {
+            doppel_melden();
+        }
+    }
+#endif
+    runde++;
+}
+
+static void stabil(void *priv)
+{
+    SPUR_APP(0x92);
+    netz_setzen(0);
+    c2_log("Chitu: %lu s stabil, Startzähler zurückgesetzt (war %lu)\r\n", NETZ_STABIL_MS / 1000,
+           netz_starts_beim_start);
+    SPUR_APP(0x93);
+}
+
+/* Befehle „chitu …“ (c2_log.c) */
+void chitu_befehl(const char *a)
+{
+    if (!strncmp(a, "live ", 5)) {
+        extern void chitu_live_befehl(const char *a);
+        chitu_live_befehl(a + 5);
+        return;
+    }
+    if (!strcmp(a, "ton") || !strncmp(a, "ton ", 4)) {
+        extern void chitu_ton_befehl(const char *a);
+        chitu_ton_befehl(a + 3);
+        return;
+    }
+#if C2_CHITU_STICKS
+    if (!strncmp(a, "takt ", 5)) {
+        int n = 0;
+        for (const char *p = a + 5; *p >= '0' && *p <= '9'; p++) {
+            n = n * 10 + (*p - '0');
+        }
+        if (n < 1 || n > 200) {
+            c2_log("fehler: chitu takt 1..200\r\n");
+            return;
+        }
+        takte(n);
+        c2_log("ok: %d zusätzliche Takte an PA6\r\n", n);
+        doppel_melden();
+        return;
+    }
+    if (!strcmp(a, "roh")) {
+        c2_log("ok: roh\r\n");
+        doppel_melden();
+        return;
+    }
+    if (!strcmp(a, "sticks an")) {
+        sticks_init();
+        isr_fehler_folge = 0;
+        rahmen_fehler_folge = 0;
+        sticks_aus = 0;
+        c2_log("ok: Stick-Rahmen wieder an\r\n");
+        return;
+    }
+#endif
+    c2_log("fehler: chitu ton <hz> <ms> <pegel%%> [l|r|lr] | ton stop | live <hz> <pegel%%> [ms] | live aus | takt <n> | roh | sticks an\r\n");
+}
+
+/* Statt c2_eingaben_init (C2_CHITU) */
+void chitu_init(void)
+{
+    netz_starts_beim_start = netz_lesen();
+    /* Versorgung wie die Werks-Firmware (C2 0x8FC8, Chitu gleich): PB11 Ausgang high, High-Drive */
+    gpio_set_hd(IO_PORTB_11, 1);
+    gpio_direction_output(IO_PORTB_11, 1);
+    gpio_set_hd(IO_PORTA_07, 1);
+    gpio_direction_output(IO_PORTA_07, 0);
+    gpio_set_hd(IO_PORTA_08, 1);
+    gpio_direction_output(IO_PORTA_08, 0);
+    eingang(IO_PORTB_05, 0, 1);
+#if C2_CHITU_STICKS
+    sticks_init();
+#endif
+    c2_log("Chitu-Monitor C1: Start %lu in Folge, Sticks %s. Rettung: Home+Y+X mit USB 3 s\r\n",
+           netz_starts_beim_start, C2_CHITU_STICKS ? "an" : "aus (Generalprobe)");
+    sys_timeout_add(NULL, stabil, NETZ_STABIL_MS);
+    sys_timer_add(NULL, monitor, 10);
+    usr_timer_add(NULL, waechter, 500, 0);
+#if C2_CHITU_STICKS
+    usr_timer_add(NULL, sticks_isr, 2, 1);
+#endif
+}
+
+
+/* ---------- Stufe C2: Gamepad-Betrieb über den C2-Code (c2_eingaben.c ruft diese Funktionen) ---------- */
+/* Logische Achsen LX, LY, RX, RY -> Achse im Rahmen (am Gerät 3.11.: Achse 2/3 linker, 0/1 rechter Stick) */
+static const u8 STICK_KANAL[4] = {2, 3, 0, 1};
+static u16 stick_wert[4] = {0x800, 0x800, 0x800, 0x800};
+
+/* 12-Bit-Rohwert einer Stick-Achse aus dem zuletzt gültigen Rahmen (Mitte ~0x800) */
+u16 chitu_stick_roh(int i)
+{
+    if (i < 0 || i > 3) {
+        return 0x800;
+    }
+#if C2_CHITU_STICKS
+    static u8 alt_runden; /* Abfragerunden (i == 0) ohne neuen gültigen Rahmen */
+    if (rahmen_lesen()) {
+        alt_runden = 0;
+        for (int k = 0; k < 4; k++) {
+            stick_wert[k] = achse(STICK_KANAL[k]);
+        }
+    } else if (i == 0 && alt_runden < 255 && ++alt_runden == 10) {
+        /* Prüfung C2a M1: 100 ms kein Rahmen -> Mitte statt letztem Wert (Stick „hängt“ sonst) */
+        for (int k = 0; k < 4; k++) {
+            stick_wert[k] = 0x800;
+        }
+    }
+#endif
+    return stick_wert[i];
+}
+
+/* Prüfung C2a M2: Mitte erst messen, wenn gültige Rahmen kommen */
+int chitu_sticks_bereit(void)
+{
+#if C2_CHITU_STICKS
+    return isr_ok >= 20;
+#else
+    return 1;
+#endif
+}
+
+/* Jede Abfragerunde (10 ms) aus c2_eingaben.c: Herzschlag, N2 (Home+Y+X 3 s mit PC), Home allein 10 s -> Neustart */
+void chitu_takt(int home, int y, int x, int host)
+{
+    static u32 n2, nur_home_runden, r;
+    herzschlag++;
+    r++;
+    if (home && y && x && host) {
+        n2++;
+        if (n2 == 100) {
+            c2_log("Rettung: Home+Y+X weiter halten -> Download-Modus in 2 s\r\n");
+        }
+        if (n2 >= 300) {
+            c2_log("Rettung: starte in den ROM-Download-Modus\r\n");
+            os_time_dly(5);
+            rom_springen();
+        }
+    } else {
+        n2 = 0;
+    }
+    if (home && !y && !x) {
+        nur_home_runden++;
+        if (nur_home_runden == 800) {
+            c2_log("Chitu: Home weiter halten -> Neustart in 2 s\r\n");
+        }
+        if (nur_home_runden >= 1000) {
+            c2_log("Chitu: Home 10 s -> Neustart\r\n");
+            os_time_dly(5);
+            cpu_reset();
+        }
+    } else {
+        nur_home_runden = 0;
+    }
+#if C2_CHITU_STICKS
+    if (!sticks_aus && isr_fehler_folge >= 5000) {
+        rahmen_fehler_folge = isr_fehler_folge;
+        sticks_abschalten();
+    }
+    if (r % 3000 == 0) {
+        c2_log("Chitu: Stick-Rahmen ok %lu, Fehler %lu, Lesungen %lu\r\n", isr_ok, isr_fehler, isr_laeufe);
+    }
+#endif
+}
+
+/* Stick-Interrupt an (0) bzw. aus (1), z. B. während eines Updates (c2_ota.c) */
+static u16 sticks_timer;
+void chitu_sticks_pausieren(int an)
+{
+    extern void chitu_dac_pausieren(int an);
+    chitu_dac_pausieren(an); /* Stufe C-R: während eines Updates kein DAC-Zeitgeber */
+#if C2_CHITU_STICKS
+    if (an && sticks_timer) {
+        usr_timer_del(sticks_timer);
+        sticks_timer = 0;
+        c2_log("Chitu: Stick-Interrupt pausiert (Update)\r\n");
+    } else if (!an && !sticks_timer) {
+        sticks_timer = usr_timer_add(NULL, sticks_isr, 2, 1);
+    }
+#endif
+}
+
+/* Nur den Stick-Interrupt an (1) / aus (0), ohne DAC und ohne Log (chitu_dac.c: während Trim und VM-Schreiben) */
+void chitu_stick_irq(int an)
+{
+#if C2_CHITU_STICKS
+    if (!an && sticks_timer) {
+        usr_timer_del(sticks_timer);
+        sticks_timer = 0;
+    } else if (an && !sticks_timer) {
+        sticks_timer = usr_timer_add(NULL, sticks_isr, 2, 1);
+    }
+#endif
+}
+
+/* Aus c2_eingaben_init (Stufe C2): Netze im Betrieb und Stick-Interrupt starten */
+void chitu_netze_starten(void)
+{
+    netz_starts_beim_start = netz_lesen();
+#if C2_CHITU_STICKS
+    sticks_init();
+    chitu_sticks_pausieren(0);
+#endif
+    c2_log("Chitu C2: Start %lu in Folge, Sticks %s. Rettung: Home+Y+X 3 s mit PC, Home 10 s = Neustart\r\n",
+           netz_starts_beim_start, C2_CHITU_STICKS ? "an" : "aus (Generalprobe)");
+    sys_timeout_add(NULL, stabil, NETZ_STABIL_MS);
+    usr_timer_add(NULL, waechter, 500, 0);
+}
+
+#endif
diff --git a/apps/hid/modules/c2lite/chitu_dac.c b/apps/hid/modules/c2lite/chitu_dac.c
new file mode 100644
index 0000000..cf46af8
--- /dev/null
+++ b/apps/hid/modules/c2lite/chitu_dac.c
@@ -0,0 +1,689 @@
+/* Chitu 2 HD, Stufe C-R: Linearmotoren (HD-Rumble) über den Audio-DAC – Töne und Melodien.
+ *
+ * Quellen (eigene Analyse der Werks-Firmware 0.20, Notizen nicht im Repo):
+ *   Werks-FW 0.20: DAC 8000 Hz, Stereo (links Motor 0, rechts Motor 1), output = LR mit VCOMO, DACVDD-LDO-Code 3,
+ *   Digital L/R höchstens 0x3333, Analog 20, Trim in VM-ID 92 (CFG_DAC_TRIM_INFO), PB11 high (setzt chitu_init schon).
+ *   Ablauf wie SDK cpu/br23/audio_demo/audio_dac_io_demo.c (DAC als „IO“, direkte FIFO-Schreibzugriffe), aber
+ *   ohne DAC-Interrupt (wir füllen per Zeitgeber nach).
+ *
+ * Sicherheit (Prüfung CRa umgesetzt = CRb):
+ *   - Beim Start der Firmware passiert hier NICHTS. Der DAC wird erst beim ersten Befehl „chitu ton …“ oder beim ersten
+ *     Rumble eines Spiels eingeschaltet (Task-Kontext); der Verbinden-Stoß nutzt ihn erst danach (Prüfung CRd S2).
+ *     Startpfad und Netze N2–N6 bleiben unverändert.
+ *   - Pegel höchstens PEGEL_DECKEL % (vorläufig 50 %; 100 % = s16 voll bei Werks-Gains 0x3333/20), auch für Rumble.
+ *   - Ein Ton höchstens TON_MAX_MS, 40..1000 Hz, weiche Flanken (5 ms). Lastkonto (Musik und Rumble): höchstens
+ *     LAST_MAX_S s Ton am Stück, danach still, bis die Hälfte davon als Pause abgebaut ist.
+ *   - audio_dac_stop wird NIE gerufen (Lib-Status-Hook mit Wartezeiten und 2-ms-Zeitgeber, Prüfung S1). Wie die
+ *     Werks-FW bleibt der DAC nach dem ersten Ton an; „aus“ heißt: Füll-Zeitgeber weg, ganzer Ring = 0.
+ *   - Der freie Teil des Rings wird bei jedem Füllen genullt: falls die Hardware bei Stau den Ring weiterliest,
+ *     kommen Nullen statt alter Töne (Prüfung S3, Verhalten selbst noch unbelegt → „chitu ton unterlauftest“).
+ *   - Während eines Updates (chitu_dac_pausieren) still, Zeitgeber aus, neue Töne gesperrt. */
+#include "app_config.h"
+#include "system/includes.h"
+#include "asm/dac.h"
+#include "c2_log.h"
+#include "c2_spur.h"
+
+#if C2_CHITU
+
+#define RATE 8000
+#define FLANKE_SCHIEB 5        /* Flanke 32 Abtastwerte = 4 ms */
+#define FLANKE (1 << FLANKE_SCHIEB)
+#define TON_MAX_MS 3000
+#define HZ_MIN 40
+#define HZ_MAX 1000
+#define PEGEL_DECKEL 50        /* vorläufig, bis die Werks-Oszillatoramplitude belegt ist (Prüfung S2) */
+#define LAST_MAX_S 30 /* Nutzer 4.11.: 30 s (Werks-FW hat keine Grenze; Pegel bleibt ≤ PEGEL_DECKEL) */
+#define DIGITAL_MAX 0x3333     /* Werks-Höchstwert */
+#define ANALOG_WERK 20         /* Werks-Endwert */
+#define ZIEL_GEPUFFERT 256     /* Frames im DAC-Puffer halten (32 ms) */
+#define PRO_AUFRUF 64          /* höchstens so viele Frames je Interrupt (Prüfung S4) */
+#define PUFFER_FRAMES 512      /* 64 ms Stereo */
+#define STILLE_AUS_MS 2000
+#define WS 32                  /* Warteschlange (Zweierpotenz) */
+
+static const s16 SINUS[256] = {
+#include "chitu_sinus.h"
+};
+
+static struct audio_dac_hdl chitu_dac;
+static struct dac_platform_data chitu_dac_data = {
+    .output = DAC_OUTPUT_LR,
+    .ldo_volt = DACVDD_LDO_2_70V, /* wird in dac_einschalten nach Chip-Version auf Code 3 gestellt */
+    .ldo_isel = 1,
+    .lpf_isel = 4,
+    .ldo_fb_isel = 1,
+    .vcmo_en = 1,
+};
+static __attribute__((aligned(4))) s16 dac_puffer[PUFFER_FRAMES * 2];
+
+struct ton_t {
+    u16 hz;    /* 0 = Pause */
+    u16 ms;
+    u8 pegel;  /* 0..PEGEL_DECKEL % */
+    u8 kanal;  /* Bit 0 links, Bit 1 rechts */
+};
+static volatile struct ton_t ws[WS];
+static volatile u8 ws_lies, ws_schreib;
+
+static volatile u8 dac_an;    /* 1 = Füll-Zeitgeber läuft */
+static u8 dac_gestartet;      /* audio_dac_start einmal erledigt (DAC bleibt danach an, wie Werk) */
+static u8 dac_fehler;         /* Einschalten schlug fehl: Rumble versucht es nicht alle 100 ms neu (Prüfung CRd S3) */
+static volatile u8 pausiert;  /* Update läuft */
+static u16 fuell_timer;
+static volatile u32 stille_ms;
+
+/* Zustand im Interrupt */
+static struct ton_t akt;
+static u32 akt_rest, akt_n, phase, schritt;
+static s32 akt_amp;           /* 0..32767*PEGEL_DECKEL/100 */
+static u8 akt_laeuft;
+static volatile u32 unterlauf, last, last_sperren;
+static volatile u16 ton_nr; /* zählt geladene Musiktöne (Lichtorgel, CRi) */
+
+/* Lib-Tabelle (audio_dac_vdd_power_on): Chip-Version <3 oder ≥12 → verA {0..7}, sonst verD {1,2,3,4,5,6,6,7}.
+ * Werks-Code 3 → verA ldo_volt 3, verD ldo_volt 2. Gleiches Register wie die Lib (0x1E0200 & 0xF). */
+static u8 ldo_fuer_werkscode3(void)
+{
+    u32 v = *(volatile u32 *)0x1E0200;
+    if ((v & 0xF) < 3 || (v & 0xC) >= 12) {
+        return 3;
+    }
+    return 2;
+}
+
+static int ws_anzahl(void)
+{
+    return (u8)(ws_schreib - ws_lies);
+}
+
+static void ton_laden(void)
+{
+    if (ws_lies == ws_schreib) {
+        akt_laeuft = 0;
+        return;
+    }
+    u8 i = ws_lies & (WS - 1);
+    akt.hz = ws[i].hz;
+    akt.ms = ws[i].ms;
+    akt.pegel = ws[i].pegel;
+    akt.kanal = ws[i].kanal;
+    ws_lies++;
+    akt_n = (u32)akt.ms * (RATE / 1000);
+    akt_rest = akt_n;
+    schritt = akt.hz ? (u32)(((u64)akt.hz << 32) / RATE) : 0;
+    akt_amp = akt.hz ? (s32)32767 * akt.pegel / 100 : 0; /* einmal je Ton (Prüfung S4) */
+    akt_laeuft = 1;
+    if (akt.hz) {
+        ton_nr++;
+    }
+}
+
+/* Lastkonto: je klingendem Abtastwert +1, je stillem −1; nach LAST_MAX_S s Ton am Stück still, bis es zur Hälfte
+ * abgebaut ist. Gilt für Musik und Rumble. Rückgabe 1 = darf klingen. */
+static int last_buchen(int klingt)
+{
+    if (last_sperren || !klingt) {
+        if (last) {
+            last--;
+        }
+        if (last_sperren && last <= LAST_MAX_S * RATE / 2) {
+            last_sperren = 0;
+        }
+        return 0;
+    }
+    if (++last >= LAST_MAX_S * RATE) {
+        last_sperren = 1;
+    }
+    return 1;
+}
+
+/* ---------- Rumble (Stufe C-R Schritt 5) ----------
+ * Quellen: Werks-FW 0.20 stellt je Motor Oszillatoren auf 160 Hz (0xA0) und 320 Hz (0x140) (FUN_01e0e95a, Switch-HD-
+ * Rumble-Bänder); XInput: linker Motor = niederfrequent/schwer, rechter = hochfrequent/leicht (Microsoft-Doku).
+ * Daher: links-% → Anteil 160 Hz, rechts-% → Anteil 320 Hz, gemischt auf beiden Linearmotoren. Summe höchstens
+ * PEGEL_DECKEL % Vollaussteuerung. Pegel folgt dem Soll in ~20 ms (kein Knacken). Musik hat Vorrang. */
+#define RUMBLE_TIEF_HZ 160
+#define RUMBLE_HOCH_HZ 320
+#define RUMBLE_RAMPE (100 * 256 / 160) /* 0 → 100 % in 160 Abtastwerten = 20 ms */
+static volatile u8 rumble_soll[2];      /* 0..100 % links (tief), rechts (hoch) */
+static volatile u32 rumble_rest;        /* Abtastwerte bis zum Ende ohne Erneuerung */
+static u32 rumble_ist[2];               /* aktueller Pegel in % × 256 */
+static u32 phase_tief, phase_hoch;
+
+static s16 rumble_wert(void)
+{
+    u32 soll[2] = {0, 0};
+    if (rumble_rest) {
+        rumble_rest--;
+        soll[0] = rumble_soll[0] * 256;
+        soll[1] = rumble_soll[1] * 256;
+    }
+    for (int i = 0; i < 2; i++) {
+        if (rumble_ist[i] < soll[i]) {
+            rumble_ist[i] = rumble_ist[i] + RUMBLE_RAMPE < soll[i] ? rumble_ist[i] + RUMBLE_RAMPE : soll[i];
+        } else if (rumble_ist[i] > soll[i]) {
+            rumble_ist[i] = rumble_ist[i] > soll[i] + RUMBLE_RAMPE ? rumble_ist[i] - RUMBLE_RAMPE : soll[i];
+        }
+    }
+    s32 l = rumble_ist[0] >> 8, h = rumble_ist[1] >> 8; /* 0..100 */
+    if (!last_buchen(l || h)) {
+        if (last_sperren) { /* Prüfung CRd M2: nach der Sperre mit Rampe wieder einsetzen, nicht mit vollem Pegel */
+            rumble_ist[0] = rumble_ist[1] = 0;
+        }
+        return 0;
+    }
+    s32 w = (s32)SINUS[phase_tief >> 24] * l + (s32)SINUS[phase_hoch >> 24] * h; /* |w| ≤ 32767 · 200 */
+    phase_tief += (u32)(((u64)RUMBLE_TIEF_HZ << 32) / RATE);
+    phase_hoch += (u32)(((u64)RUMBLE_HOCH_HZ << 32) / RATE);
+    s32 teiler = l + h > 100 ? l + h : 100;
+    return (s16)(((w / teiler) * (32767 * PEGEL_DECKEL / 100)) >> 15);
+}
+
+/* ---------- Live-Ton (Klavier im Werkzeug, Stufe CRe) ----------
+ * Ein gehaltener Ton, solange das Werkzeug ihn erneuert (wie Rumble): Frequenz frei 40..1000 Hz, Pegel ≤ PEGEL_DECKEL,
+ * Pegel folgt dem Soll mit derselben 20-ms-Rampe, Phase läuft bei Frequenzwechsel durch (kein Knacken). Vorrang:
+ * Musik > Live-Ton > Rumble. */
+static volatile u8 live_soll;        /* 0..PEGEL_DECKEL % */
+static volatile u32 live_schritt;    /* Phasenschritt der Sollfrequenz */
+static volatile u32 live_rest;       /* Abtastwerte bis zum Ausklingen ohne Erneuerung */
+static u32 live_ist;                 /* aktueller Pegel in % × 256 */
+static u32 phase_live;
+
+static int live_aktiv(void)
+{
+    return live_rest || live_ist;
+}
+
+static s16 live_wert(void)
+{
+    u32 soll = 0;
+    if (live_rest) {
+        live_rest--;
+        soll = live_soll * 256;
+    }
+    if (live_ist < soll) {
+        live_ist = live_ist + RUMBLE_RAMPE < soll ? live_ist + RUMBLE_RAMPE : soll;
+    } else if (live_ist > soll) {
+        live_ist = live_ist > soll + RUMBLE_RAMPE ? live_ist - RUMBLE_RAMPE : soll;
+    }
+    s32 p = live_ist >> 8; /* 0..PEGEL_DECKEL */
+    if (!last_buchen(p != 0)) {
+        if (last_sperren) {
+            live_ist = 0;
+        }
+        return 0;
+    }
+    s32 w = SINUS[phase_live >> 24];
+    phase_live += live_schritt;
+    return (s16)((w * ((s32)32767 * p / 100)) >> 15);
+}
+
+static s16 abtastwert(void)
+{
+    if (!akt_laeuft || !akt_rest) {
+        ton_laden();
+    }
+    if (!akt_laeuft) {
+        if (live_aktiv()) { /* Live-Ton vor Rumble; Rumble läuft derweil ab */
+            if (rumble_rest) {
+                rumble_rest--;
+            }
+            rumble_ist[0] = rumble_ist[1] = 0;
+            return live_wert();
+        }
+        return rumble_wert(); /* keine Musik: Rumble (oder Stille) */
+    }
+    live_rest = 0; /* Musik hat Vorrang: Live-Ton endet */
+    live_ist = 0;
+    if (rumble_rest) { /* Musik hat Vorrang, Rumble läuft derweil ab */
+        rumble_rest--;
+    }
+    rumble_ist[0] = rumble_ist[1] = 0; /* Prüfung CRd M1: nach der Musik setzt Rumble mit Rampe ein */
+    u32 pos = akt_n - akt_rest; /* bereits gespielt */
+    akt_rest--;
+    if (!last_buchen(akt_amp != 0)) {
+        return 0;
+    }
+    s32 a = akt_amp;
+    if (pos < FLANKE) {
+        a = (a * (s32)pos) >> FLANKE_SCHIEB;
+    }
+    if (akt_rest < FLANKE) {
+        a = (a * (s32)akt_rest) >> FLANKE_SCHIEB;
+    }
+    s32 w = SINUS[phase >> 24];
+    phase += schritt;
+    return (s16)((w * a) >> 15);
+}
+
+/* Ring ab Frame „von“ für n Frames auf 0 (mit Umbruch) */
+static void ring_nullen(u32 von, u32 n, u32 len)
+{
+    while (n) {
+        u32 k = n;
+        if (von + k > len) {
+            k = len - von;
+        }
+        memset(&dac_puffer[von * 2], 0, k * 4);
+        n -= k;
+        von = (von + k) % len;
+    }
+}
+
+/* n Frames ab SWP berechnen und übergeben (wie audio_dac_io_write im SDK-Demo); danach freien Rest nullen */
+static void schreiben(u32 n_max)
+{
+    u32 frei = JL_AUDIO->DAC_SWN;
+    u32 len = JL_AUDIO->DAC_LEN;
+    if (len != PUFFER_FRAMES || frei >= len) {
+        return;
+    }
+    u32 gepuffert = len - 1 - frei; /* Lib-Rechnung (audio_dac_irq_handler) */
+    if (gepuffert == 0 && dac_an && (akt_laeuft || ws_lies != ws_schreib)) { /* CRc: Vorfüllen zählt nicht */
+        unterlauf++;
+    }
+    if (gepuffert >= ZIEL_GEPUFFERT) {
+        return;
+    }
+    u32 n = ZIEL_GEPUFFERT - gepuffert;
+    if (n > n_max) {
+        n = n_max;
+    }
+    if (n > frei) {
+        n = frei;
+    }
+    u32 swp = JL_AUDIO->DAC_SWP;
+    if (swp >= len) {
+        return;
+    }
+    if (swp + n > len) {
+        n = len - swp; /* bis zum Pufferende, Rest beim nächsten Mal */
+    }
+    s16 *z = &dac_puffer[swp * 2];
+    int still = 1;
+    for (u32 i = 0; i < n; i++) {
+        s16 w = abtastwert();
+        u8 k = akt_laeuft ? akt.kanal : 3; /* ohne Musik: Rumble auf beiden Motoren */
+        z[2 * i] = (k & 1) ? w : 0;
+        z[2 * i + 1] = (k & 2) ? w : 0;
+        if (w) {
+            still = 0;
+        }
+    }
+    JL_AUDIO->DAC_SWN = n;
+    __asm_csync();
+    ring_nullen((swp + n) % len, frei - n, len); /* Prüfung S3: alles Ungeschriebene = 0 */
+    if (still && !akt_laeuft) {
+        stille_ms += 4;
+    } else {
+        stille_ms = 0;
+    }
+}
+
+/* Zeitgeber-Interrupt alle 4 ms */
+static void fuellen(void *priv)
+{
+    SPUR_IRQ(0x61);
+    if (dac_an) {
+        schreiben(PRO_AUFRUF);
+    }
+    SPUR_IRQ(0x60);
+}
+
+extern void chitu_stick_irq(int an); /* chitu.c: nur den Stick-Interrupt an/aus */
+
+static int dac_einschalten(void)
+{
+    if (dac_an) {
+        return 0;
+    }
+    SPUR_APP(0x80);
+    if (!dac_gestartet) {
+        chitu_dac_data.ldo_volt = ldo_fuer_werkscode3();
+        audio_dac_init(&chitu_dac, &chitu_dac_data);
+        SPUR_APP(0x81);
+        if (chitu_dac.channel != 2) { /* Prüfung M3: Pufferrechnung setzt Stereo voraus */
+            c2_log("fehler: Chitu-DAC Kanäle %d statt 2, bleibt aus\r\n", chitu_dac.channel);
+            dac_fehler = 1;
+            SPUR_APP(0x86);
+            return -1;
+        }
+        audio_dac_set_buff(&chitu_dac, dac_puffer, sizeof(dac_puffer));
+        struct audio_dac_trim trim = {0};
+        int len = syscfg_read(CFG_DAC_TRIM_INFO, (void *)&trim, sizeof(trim));
+        if (len != sizeof(trim) || trim.left == 0 || trim.right == 0) {
+            c2_log("Chitu-DAC: Trim (einmalig, ~1 s)\r\n");
+            chitu_stick_irq(0); /* Prüfung S5: kein 2-ms-Interrupt während Trim/VM-Schreiben */
+            audio_dac_do_trim(&chitu_dac, &trim, 0);
+            syscfg_write(CFG_DAC_TRIM_INFO, (void *)&trim, sizeof(trim));
+            chitu_stick_irq(1);
+        }
+        SPUR_APP(0x82);
+        audio_dac_set_trim_value(&chitu_dac, &trim);
+        audio_dac_set_delay_time(&chitu_dac, 1, 2);
+        c2_log("Chitu-DAC: init ldo_volt=%d trim l=%d r=%d chip=0x%lx\r\n", chitu_dac_data.ldo_volt, trim.left,
+               trim.right, *(volatile u32 *)0x1E0200 & 0xF);
+        memset(dac_puffer, 0, sizeof(dac_puffer));
+        audio_dac_set_sample_rate(&chitu_dac, RATE);
+        audio_dac_start(&chitu_dac);
+        SPUR_APP(0x83);
+        os_time_dly(5);
+        audio_dac_ch_digital_gain_set(&chitu_dac, 0x3, DIGITAL_MAX);
+        audio_dac_ch_analog_gain_set(&chitu_dac, 0x3, ANALOG_WERK);
+        JL_AUDIO->DAC_CON &= ~(BIT(12) | BIT(13) | BIT(14) | BIT(15)); /* wie Demo und Werks-FW */
+        dac_gestartet = 1;
+        c2_log("Chitu-DAC: gestartet (8000 Hz, LR, Digital 0x%x, Analog %d)\r\n", DIGITAL_MAX, ANALOG_WERK);
+    }
+    stille_ms = 0;
+    phase = 0;
+    akt_laeuft = 0;
+    /* im Task vorfüllen, damit der Interrupt nur nachfüllt (Prüfung S4). Kein Gleichlauf: der Füll-Zeitgeber
+     * existiert hier noch nicht (dac_ruhe löscht ihn), und fuellen tut ohne dac_an nichts. Interrupts bleiben an,
+     * damit der 2-ms-Stick-Interrupt nicht aussetzt. */
+    schreiben(ZIEL_GEPUFFERT);
+    dac_an = 1;
+    if (!fuell_timer) {
+        fuell_timer = usr_timer_add(NULL, fuellen, 4, 1);
+    }
+    if (!fuell_timer) { /* Prüfung M5 */
+        dac_an = 0;
+        ring_nullen(0, PUFFER_FRAMES, PUFFER_FRAMES);
+        c2_log("fehler: Chitu-DAC kein Zeitgeber frei\r\n");
+        dac_fehler = 1;
+        SPUR_APP(0x86);
+        return -1;
+    }
+    SPUR_APP(0x8F);
+    return 0;
+}
+
+/* Füll-Zeitgeber weg, Warteschlange leer, ganzer Ring 0 (DAC läuft weiter und gibt Nullen aus) */
+static void dac_ruhe(void)
+{
+    SPUR_APP(0x85);
+    if (fuell_timer) {
+        usr_timer_del(fuell_timer);
+        fuell_timer = 0;
+    }
+    int war_an = dac_an;
+    local_irq_disable();
+    dac_an = 0;
+    ws_lies = ws_schreib;
+    akt_laeuft = 0;
+    rumble_rest = 0;
+    rumble_ist[0] = rumble_ist[1] = 0;
+    live_rest = 0;
+    live_ist = 0;
+    ring_nullen(0, PUFFER_FRAMES, PUFFER_FRAMES);
+    local_irq_enable();
+    if (war_an) {
+        c2_log("Chitu-DAC: still (Unterläufe %lu)\r\n", unterlauf);
+    }
+    SPUR_APP(0x87);
+}
+
+/* Task-Kontext, alle 100 ms: nach STILLE_AUS_MS Stille Zeitgeber aus */
+static void waechter_dac(void *priv)
+{
+    SPUR_APP(0x88);
+    if (dac_an && stille_ms >= STILLE_AUS_MS) {
+        dac_ruhe();
+    }
+    if (!dac_an) { /* Zeitgeber aus: Lastkonto nach Uhr abbauen (100 ms = 800 Abtastwerte) */
+        last = last > 800 ? last - 800 : 0;
+        if (last <= LAST_MAX_S * RATE / 2) {
+            last_sperren = 0;
+        }
+    }
+    SPUR_APP(0x89);
+}
+
+static u32 zahl(const char **p, int *ok)
+{
+    u32 n = 0;
+    int ziffern = 0;
+    while (**p == ' ') {
+        (*p)++;
+    }
+    while (**p >= '0' && **p <= '9') {
+        n = n * 10 + (**p - '0');
+        (*p)++;
+        if (++ziffern > 6) {
+            *ok = 0;
+            return 0;
+        }
+    }
+    if (!ziffern) {
+        *ok = 0;
+    }
+    return n;
+}
+
+static void diag(const char *was)
+{
+    c2_log("ok: ton %s dac=%d gestartet=%d ws=%d/%d unterlauf=%lu last=%lu/%lu sperre=%lu con=0x%lx len=%u hrp=%u "
+           "swp=%u swn=%u\r\n", was, dac_an, dac_gestartet, ws_anzahl(), WS, unterlauf, last / RATE, LAST_MAX_S,
+           last_sperren, JL_AUDIO->DAC_CON, JL_AUDIO->DAC_LEN, JL_AUDIO->DAC_HRP, JL_AUDIO->DAC_SWP,
+           JL_AUDIO->DAC_SWN);
+}
+
+#if !C2_CHITU_STICKS
+/* Nur Generalprobe am C2 Lite (dort hängt nichts am DAC): Füllen anhalten, Ring mit Testwert, HRP beobachten.
+ * Läuft HRP über SWP hinaus weiter, liest die Hardware bei Stau den Ring weiter (Prüfung S3). */
+static void unterlauftest(void)
+{
+    if (dac_einschalten()) {
+        return;
+    }
+    if (fuell_timer) {
+        usr_timer_del(fuell_timer);
+        fuell_timer = 0;
+    }
+    dac_an = 0;
+    for (int i = 0; i < PUFFER_FRAMES * 2; i++) {
+        dac_puffer[i] = 1000;
+    }
+    JL_AUDIO->DAC_SWN = 64;
+    __asm_csync();
+    for (int k = 0; k < 6; k++) {
+        diag("unterlauftest");
+        os_time_dly(2);
+    }
+    dac_ruhe();
+    diag("unterlauftest ende");
+}
+#endif
+
+/* „chitu ton <hz> <ms> <pegel%> [l|r|lr]“, „chitu ton stop“, „chitu ton“ (Stand). hz 0 = Pause. */
+/* DAC-Wächter (Stille → Zeitgeber aus, Lastkonto nach Uhr) einmalig anlegen: beim ersten Ton oder Rumble */
+void chitu_dac_waechter_starten(void)
+{
+    static u8 waechter_an;
+    if (!waechter_an) {
+        sys_timer_add(NULL, waechter_dac, 100);
+        waechter_an = 1;
+    }
+}
+
+void chitu_ton_befehl(const char *a)
+{
+    chitu_dac_waechter_starten();
+    while (*a == ' ') {
+        a++;
+    }
+    if (!*a) {
+        diag("stand");
+        return;
+    }
+    if (!strcmp(a, "stop")) {
+        dac_ruhe();
+        c2_log("ok: ton stop\r\n");
+        return;
+    }
+#if !C2_CHITU_STICKS
+    if (!strcmp(a, "unterlauftest")) {
+        unterlauftest();
+        return;
+    }
+#endif
+    if (pausiert) {
+        c2_log("fehler: ton während Update gesperrt\r\n");
+        return;
+    }
+    int ok = 1;
+    u32 hz = zahl(&a, &ok), ms = zahl(&a, &ok), pegel = zahl(&a, &ok);
+    while (*a == ' ') {
+        a++;
+    }
+    u8 kanal = 3;
+    if (!strncmp(a, "lr", 2) || !strncmp(a, "rl", 2)) {
+        a += 2;
+    } else if (*a == 'l') {
+        kanal = 1;
+        a++;
+    } else if (*a == 'r') {
+        kanal = 2;
+        a++;
+    }
+    while (*a == ' ') {
+        a++;
+    }
+    if (*a) {
+        ok = 0;
+    }
+    if (!ok || (hz && (hz < HZ_MIN || hz > HZ_MAX)) || ms < 1 || ms > TON_MAX_MS || pegel > PEGEL_DECKEL) {
+        c2_log("fehler: chitu ton <0|%d..%d hz> <1..%d ms> <0..%d %%> [l|r|lr] | stop | (leer = Stand)\r\n", HZ_MIN,
+               HZ_MAX, TON_MAX_MS, PEGEL_DECKEL);
+        return;
+    }
+    if (ws_anzahl() >= WS) {
+        c2_log("fehler: warteschlange voll\r\n");
+        return;
+    }
+    u8 i = ws_schreib & (WS - 1);
+    ws[i].hz = hz;
+    ws[i].ms = ms;
+    ws[i].pegel = pegel;
+    ws[i].kanal = kanal;
+    __asm_csync(); /* Prüfung M4: Eintrag vor dem Index */
+    ws_schreib++;
+    stille_ms = 0;
+    if (dac_einschalten()) {
+        local_irq_disable();
+        ws_lies = ws_schreib;
+        local_irq_enable();
+        return;
+    }
+    c2_log("ok: ton %lu Hz %lu ms %lu%% %s (warteschlange %d)\r\n", hz, ms, pegel,
+           kanal == 3 ? "lr" : kanal == 1 ? "l" : "r", ws_anzahl());
+}
+
+/* Aus c2_motor_setzen (c2_eingaben.c): XInput-/Bluetooth-Rumble, Vibrationsstoß beim Verbinden, Befehl „motor“.
+ * links/rechts 0..100 % (schon mit der Einstellung „vibration“ verrechnet), dauer_ms bis zum Ende ohne Erneuerung.
+ * Task-Kontext (10-ms-Runde bzw. Befehl). */
+int chitu_dac_gestartet(void)
+{
+    return dac_gestartet;
+}
+
+void chitu_rumble_setzen(u8 links, u8 rechts, u16 dauer_ms)
+{
+    if (pausiert || dac_fehler) {
+        return;
+    }
+    links = links > 100 ? 100 : links;
+    rechts = rechts > 100 ? 100 : rechts;
+    u32 rest = (links || rechts) ? (u32)(dauer_ms > 5000 ? 5000 : dauer_ms) * (RATE / 1000) : 0;
+    local_irq_disable(); /* rumble_rest zählt der Füll-Interrupt herunter: Setzen nicht mitten darin */
+    rumble_soll[0] = links;
+    rumble_soll[1] = rechts;
+    rumble_rest = rest; /* 0 = klingt in ~20 ms aus */
+    local_irq_enable();
+    if (!rest) {
+        return;
+    }
+    stille_ms = 0;
+    if (!dac_an) {
+        chitu_dac_waechter_starten();
+        dac_einschalten();
+    }
+}
+
+/* „chitu live <hz> <pegel%> [ms]“ bzw. „chitu live aus“ (Klavier im Werkzeug). Bei Erfolg KEINE Antwort (Prüfung CRe
+ * S1: 10 Erneuerungen/s würden sonst den 2-KB-Nachlass in ~15 s überschreiben); Fehler mit Präfix „live:“. */
+void chitu_live_befehl(const char *a)
+{
+    chitu_dac_waechter_starten();
+    while (*a == ' ') {
+        a++;
+    }
+    if (!strncmp(a, "aus", 3) && (a[3] == 0 || a[3] == ' ')) {
+        live_rest = 0; /* klingt in ~20 ms aus */
+        return;
+    }
+    if (pausiert || dac_fehler) {
+        c2_log("live: fehler gesperrt\r\n");
+        return;
+    }
+    int ok = 1;
+    u32 hz = zahl(&a, &ok), pegel = zahl(&a, &ok);
+    while (*a == ' ') {
+        a++;
+    }
+    u32 ms = 250;
+    if (*a) {
+        ms = zahl(&a, &ok);
+        while (*a == ' ') {
+            a++;
+        }
+        if (*a) { /* Prüfung CRe M5: kein Resttext */
+            ok = 0;
+        }
+    }
+    if (!ok || hz < HZ_MIN || hz > HZ_MAX || pegel > PEGEL_DECKEL || ms < 1 || ms > 1000) {
+        c2_log("live: fehler chitu live <%d..%d hz> <0..%d %%> [1..1000 ms] | aus\r\n", HZ_MIN, HZ_MAX, PEGEL_DECKEL);
+        return;
+    }
+    u32 schritt = (u32)(((u64)hz << 32) / RATE);
+    u32 rest = ms * (RATE / 1000);
+    local_irq_disable(); /* live_rest zählt der Füll-Interrupt herunter */
+    live_schritt = schritt;
+    live_soll = pegel;
+    live_rest = rest;
+    local_irq_enable();
+    stille_ms = 0;
+    if (!dac_an && dac_einschalten()) { /* Prüfung CRe S2: Fehlschlag melden */
+        live_rest = 0;
+        c2_log("live: fehler DAC startet nicht\r\n");
+        return;
+    }
+    if (akt_laeuft || ws_lies != ws_schreib) {
+        c2_log("live: fehler Musik läuft\r\n");
+    }
+}
+
+/* Lichtorgel (CRi, c2_anzeige.c): was klingt gerade? hz 0 = nichts. nr ändert sich mit jedem neuen Musikton.
+ * Aus der 10-ms-Runde; die Werte schreibt der Füll-Zeitgeber, sie dürfen eine Runde alt sein. Rumble zählt nicht. */
+void chitu_klang(u16 *hz, u8 *pegel, u16 *nr)
+{
+    *nr = ton_nr;
+    if (akt_laeuft && akt.hz && !pausiert) {
+        *hz = akt.hz, *pegel = akt.pegel;
+    } else if (live_rest && live_ist && !pausiert) {
+        *hz = (u16)(((u64)live_schritt * RATE) >> 32), *pegel = live_ist >> 8;
+    } else {
+        *hz = 0, *pegel = 0;
+    }
+}
+
+/* Aus chitu_sticks_pausieren: während eines Updates still und ohne Zeitgeber (kein audio_dac_stop, Prüfung S1) */
+void chitu_dac_pausieren(int an)
+{
+    pausiert = !!an;
+    if (an) {
+        dac_ruhe();
+    }
+}
+
+#endif
