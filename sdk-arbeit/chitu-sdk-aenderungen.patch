+static void zeitgeber(u32 slots) /* Werk 0x3abd2 = SDK __timer_register */
+{
+    REG(0x1C0018) |= 0x200;
+    REG(0x1C001C) = 1;
+    while (REG(0x1C001C)) {
+    }
+    REG(0x1C00E4) = REG(0x1C0020) + slots;
+    REG(0x1C000C) |= 0x200;
+}
+
+static void zeitgeber_aus(void) /* Werk 0x3b950 */
+{
+    REG(0x1C0018) |= 0x200;
+    REG(0x1C000C) &= ~0x200;
+}
+
+static void bch_bytes(u8 *bch, const u8 *adr) /* 34 Paritätsbits als 5 Byte LE (= __get_access_addr) */
+{
+    struct c2_s1_weck e;
+    berechnen(adr, &e);
+    u64 p = e.sync & 0x3FFFFFFFFULL;
+    for (int i = 0; i < 5; i++) {
+        bch[i] = p >> (8 * i);
+    }
+}
+
+static int frist_vorbei(u32 jetzt, u32 frist) /* Werk 0x33c24 */
+{
+    if ((s32)jetzt <= (s32)frist) {
+        jetzt += 0x8000000;
+    }
+    return (s32)(jetzt - frist) < 69120000;
+}
+
+static void agc_weiter(struct s1_ctx *c, void *f) /* Werk 0x3bc22 */
+{
+    u8 i = c->agc + 1;
+    if (i > 5) {
+        i = 0;
+    }
+    c->agc = i;
+    bredr_frame_agc_set(f, 0, AGC[i]);
+}
+
+static u8 frequenz(u8 kanal) /* Werk 0x3bd32 */
+{
+    return (kanal & 1) ? (kanal >> 1) + 40 : kanal >> 1;
+}
