# Freigabeliste: veröffentlicht wird nur, was hier ausdrücklich steht. Alles andere bleibt lokal
# (Hersteller-Firmware, Fremdcode, Sicherungen, Mitschnitte, Build-Ausgaben, eigene Notizen).
/*
!/.gitignore
!/README.md
!/README.en.md
!/LICENSE

!/release/
/release/*
!/release/jl_isd.bin
!/release/db_update_data.bin
!/release/SHA256SUMS
!/release/LIESMICH.txt

!/docs/
/docs/*
!/docs/*.md

!/c2lite-custom/
/c2lite-custom/*
!/c2lite-custom/Cargo.toml
!/c2lite-custom/Cargo.lock
!/c2lite-custom/src/
!/c2lite-custom/assets/
!/c2lite-custom/bruecke/

!/sdk-arbeit/
/sdk-arbeit/*
!/sdk-arbeit/sdk-aenderungen.patch
!/sdk-arbeit/sdk-aenderungen-dateien.txt

!/werkzeuge/
/werkzeuge/*
!/werkzeuge/99-jieli-br23.rules
!/werkzeuge/abbild_packen.sh
!/werkzeuge/jlcommon.py
!/werkzeuge/pro2_profil.py
!/werkzeuge/sdk-bauen.sh
!/werkzeuge/soll_bauen.py
!/werkzeuge/test_pro2_krypto.c

!/c6-rettung/
/c6-*/*
!/c6-*/CMakeLists.txt
!/c6-*/sdkconfig.defaults
!/c6-*/main/

# auch in freigegebenen Ordnern nie
__pycache__/
*.pyc
*.o
